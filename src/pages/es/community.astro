---
import Base from '../../layouts/Base.astro';

const nearbyProjects = [
  {
    name: 'CASA Latina Network',
    location: 'Latin America (multi-country)',
    url: 'https://redcasalatina.org/',
    desc: 'A network of sustainable communities and ecovillages across Latin America, sharing knowledge on alternative living, permaculture, and communal governance. One of the most established networks in the region.',
    lesson: 'Regional network effects matter. No community thrives in isolation — connecting with CASA Latina gives BARK access to decades of collective learning about what works (and what fails) in Latin American intentional communities.',
  },
  {
    name: 'Sachamama Center',
    location: 'High Amazon, Peru',
    url: 'https://www.sachamama.org/',
    desc: 'An ethno-botanical center in the Peruvian Amazon focused on preserving traditional plant knowledge and rainforest ecology. Bridges indigenous healing traditions with scientific research.',
    lesson: 'Deep integration with indigenous knowledge systems. Sachamama demonstrates that traditional ecological knowledge and modern research are complementary, not competing — the model for BARK\'s approach to local Aymara knowledge.',
  },
  {
    name: 'Kairos Ecovillage',
    location: 'Peru',
    desc: 'A Peruvian ecovillage experiment combining permaculture, natural building, and community governance in a South American context. Navigates similar legal and cultural terrain to what BARK will face.',
    lesson: 'Practical lessons on South American land acquisition, community legal structures, and navigating bureaucratic environments as a foreign-initiated project.',
  },
  {
    name: 'Atitlan Organics',
    location: 'Lake Atitlan, Guatemala',
    url: 'https://atitlanorganics.com/',
    desc: 'A permaculture farm and education center on Lake Atitlan, offering courses in sustainable agriculture, natural building, and off-grid systems. Demonstrates the economic viability of education-based community models.',
    lesson: 'Education as economic engine. Atitlan Organics sustains itself through teaching — a model BARK can replicate with its techno park and retreat center offerings.',
  },
  {
    name: 'Huehuecoyotl',
    location: 'Tepoztlan, Mexico',
    desc: 'One of Latin America\'s oldest ecovillages (founded 1982). A multi-generational community that has survived decades of political change, economic crises, and internal governance challenges.',
    lesson: '40+ years of survival data. Huehuecoyotl proves that intentional communities in Latin America can endure across generations — but only with adaptive governance and deep local roots.',
  },
];

const globalProjects = [
  {
    name: 'Auroville',
    location: 'Tamil Nadu, India',
    url: 'https://auroville.org/',
    desc: 'Founded in 1968, Auroville is a UNESCO-endorsed experimental township of over 3,000 residents from 60+ countries. The largest and longest-running intentional community experiment in the world.',
    lesson: 'Scale is possible but creates governance complexity. Auroville\'s struggles with Indian government relations and internal decision-making at scale are essential case studies for BARK\'s long-term planning.',
  },
  {
    name: 'Tamera',
    location: 'Alentejo, Portugal',
    url: 'https://www.tamera.org/',
    desc: 'A "peace research village" of ~170 residents focused on solar technology, water retention landscapes, permaculture, and community healing. Strong technical infrastructure program.',
    lesson: 'Water retention landscapes and solar village concepts directly applicable to Yungas terrain. Tamera\'s approach to combining technology with community healing mirrors BARK\'s techno park + retreat model.',
  },
  {
    name: 'Open Source Ecology',
    location: 'Missouri, USA',
    url: 'https://www.opensourceecology.org/',
    desc: 'Developing the Global Village Construction Set (GVCS) — 50 open-source industrial machines needed to build a small civilization with modern comforts. Tractor, brick press, 3D printer, and more.',
    lesson: 'The GVCS is directly relevant to BARK\'s techno park. Several machines from their designs can be built on-site. Their documentation methodology is a model for BARK\'s open-source commitment.',
  },
  {
    name: 'Earthship Biotecture',
    location: 'Taos, New Mexico, USA',
    url: 'https://earthship.com/',
    desc: 'Pioneered radically self-sufficient building designs using recycled materials, passive solar heating/cooling, rainwater harvesting, and integrated food production. Buildings that need no external utilities.',
    lesson: 'Thermal mass and passive design principles adaptable to Yungas climate. Earthship water harvesting and greywater treatment systems are directly buildable with local materials.',
  },
  {
    name: 'Hackerfarm',
    location: 'Chiba Prefecture, Japan',
    url: 'https://freaklabs.org/',
    desc: 'A rural hackerspace combining traditional Japanese farming with IoT sensors, open-source hardware, and maker culture. Proves that high-tech and rural agriculture can coexist productively.',
    lesson: 'Tech-agriculture integration in a rural setting. Hackerfarm\'s sensor networks, automated growing systems, and maker-farmer community model is exactly what BARK\'s techno park aims to build.',
  },
];

const localNeighbors = [
  {
    name: 'Afro-Bolivian Communities',
    location: 'Tocana, Mururata, Chijchipa — Nor Yungas',
    desc: 'The cultural heart of Nor Yungas. Descendants of enslaved Africans brought to work in colonial mines and haciendas. Keepers of the saya music tradition — drum-driven call-and-response that is now recognized as Bolivian national cultural heritage. An estimated 15,000–25,000 Afro-Bolivians nationally, concentrated in this area.',
    lesson: 'BARK\'s immediate neighbors. Any community project in Nor Yungas that ignores Afro-Bolivian history, culture, and land rights is building on a lie. Collaboration must be genuine, not performative.',
  },
  {
    name: 'CENAPROC',
    location: 'Yungas, Bolivia',
    desc: 'An award-winning organic coffee cooperative operating in the Yungas. Demonstrates that cooperative agricultural enterprises — the exact model BARK\'s Trading House proposes — already work in this specific region with these specific crops.',
    lesson: 'Proof of concept for cooperative agriculture in the Yungas. CENAPROC\'s existence means BARK doesn\'t need to theorize about whether coffee cooperatives work here — they already do.',
  },
  {
    name: 'Carmen Pampa University',
    location: '12 km from Coroico (Unidad Académica Campesina)',
    url: 'https://www.uac-carmenpampa.edu.bo/',
    desc: 'A rural university offering degrees in agronomy, veterinary science, nursing, education, and ecotourism. Located just 12 km from Coroico, it is a major local institution training the next generation of Yungas professionals.',
    lesson: 'A major asset for BARK. Students and faculty in agronomy and ecotourism are natural collaborators. Internship programs, joint research, shared facilities — the partnership opportunities are obvious.',
  },
  {
    name: 'La Senda Verde',
    location: 'Yungas, Bolivia',
    url: 'https://www.sendaverde.com/',
    desc: 'A wildlife refuge and ecotourism resort operating in the Yungas since 2003. Rescues and rehabilitates wild animals while running a sustainable tourism operation. Over 20 years of continuous operation.',
    lesson: 'Demonstrates that conservation-based enterprises work in the Yungas. Their ecotourism model proves that visitors will travel to this region for nature-based experiences — relevant to BARK\'s retreat center plans.',
  },
  {
    name: 'Irupana Municipality',
    location: 'Sud Yungas, Bolivia',
    desc: 'Neighboring Yungas municipality that has achieved organic certification for its agricultural production. Shows that organic certification — a key component of BARK\'s agricultural strategy — is achievable in this region through existing Bolivian regulatory frameworks.',
    lesson: 'Regulatory proof that organic certification works in the Yungas. Irupana\'s example removes one more "but can it work here?" objection from the list.',
  },
];

const globalMovement = [
  {
    name: 'Transition Towns',
    location: 'Global (1,000+ communities)',
    url: 'https://transitionnetwork.org/',
    desc: 'A worldwide movement of communities building local resilience in the face of climate change, economic instability, and resource depletion. Over 1,000 communities in more than 40 countries, sharing practical tools for local food systems, community energy, and economic localization.',
    lesson: 'The Transition model provides tested tools for community resilience building. Their "Great Reskilling" workshops and local currency experiments are directly applicable to BARK.',
  },
  {
    name: 'Practical Action',
    location: 'Global (active in Bolivia)',
    url: 'https://practicalaction.org/',
    desc: 'An appropriate technology NGO that already operates in Bolivia. Founded on E.F. Schumacher\'s "Small is Beautiful" philosophy. Provides technical assistance for small-scale energy, agriculture, and infrastructure in developing regions.',
    lesson: 'Practical Action already has Bolivia expertise, local contacts, and proven appropriate technology designs. A natural partner rather than a competitor — they solve problems BARK will face.',
  },
  {
    name: 'Savory Institute',
    location: 'Global network',
    url: 'https://savory.global/',
    desc: 'A regenerative agriculture network promoting holistic land management. Their approach to restoring degraded land through managed grazing and soil health is relevant to the Yungas agricultural landscape.',
    lesson: 'Regenerative agriculture methods for BARK\'s food systems. Their hub network model — local practitioners connected to a global knowledge base — mirrors BARK\'s open-source philosophy.',
  },
  {
    name: 'Fab City Network',
    location: 'Global (40+ cities)',
    url: 'https://fab.city/',
    desc: '40+ cities worldwide committed to producing everything they consume by 2054. Built on the Fab Lab model of distributed digital fabrication and the principle that cities should share knowledge globally while producing locally.',
    lesson: 'The "globally connected, locally productive" model is BARK\'s techno park philosophy at city scale. Fab City membership gives access to design files, training, and a global fabrication community.',
  },
];

const governanceExperiments = [
  {
    name: 'Cabin DAO',
    location: 'Texas, USA (distributed)',
    url: 'https://cabin.city/',
    desc: 'A DAO-governed "network city" experiment that connected physical coliving spaces with crypto governance. Raised significant funding and built real properties before winding down operations. Now focused on software tools for network cities.',
    lesson: 'Cautionary tale on DAO governance for physical communities. Token-based voting struggles with the slow, relationship-heavy work of building real places. BARK uses cooperative law as the legal backbone with DAO tooling as an optional layer — not the foundation.',
    type: 'caution',
  },
  {
    name: 'Prospera (Honduras)',
    location: 'Roatan, Honduras',
    url: 'https://www.prospera.co/en',
    desc: 'A private charter city on Roatan island operating under Honduras\'s ZEDE (Zone of Employment and Economic Development) framework. Libertarian governance experiment with its own legal and regulatory system.',
    lesson: 'A cautionary tale. Prospera\'s top-down, foreign-led, libertarian approach created intense local opposition and legal challenges. The Honduras government repealed the ZEDE law in 2022. BARK explicitly rejects this model — community integration and local consent are non-negotiable.',
    type: 'warning',
  },
];
---

<Base title="Our Neighbors & Allies">
  <!-- Header -->
  <section class="pt-32 pb-16 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <span class="text-label text-accent tracking-widest reveal">Network</span>
      <h1 class="text-headline text-bark-800 mt-4 reveal" data-delay="100">Our Neighbors & Allies</h1>
      <p class="text-body-lg text-bark-500 mt-4 max-w-2xl reveal" data-delay="200">
        BARK doesn't exist in a vacuum. We learn from those who came before, connect with those building now,
        and study both successes and failures honestly. No project this ambitious succeeds by reinventing every wheel.
      </p>
      <div class="accent-line mt-10 reveal" data-delay="300"></div>
    </div>
  </section>

  <!-- Our Actual Neighbors (Local Yungas) -->
  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Our Actual Neighbors</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        Before looking at the global map, BARK needs to know its own neighborhood. These are the communities,
        institutions, and organizations already operating in and around the Yungas — the people we'll share roads,
        markets, and weather with.
      </p>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {localNeighbors.map(p => (
          <div class="bg-bark-50 p-10">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h3 class="font-display font-semibold text-bark-800 text-lg">{p.name}</h3>
                <span class="text-label text-bark-400 text-[0.65rem]">{p.location}</span>
              </div>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
            </div>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed mb-4">{p.desc}</p>
            <div class="border-t border-bark-200 pt-4 mt-auto">
              <span class="text-label text-accent text-[0.6rem]">What BARK learns</span>
              <p class="text-bark-500 text-sm leading-relaxed mt-1">{p.lesson}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nearby Projects (Latin America) -->
  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Regional Neighbors</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        Projects in Latin America navigating similar terrain — geographically, legally, and culturally.
      </p>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {nearbyProjects.map(p => (
          <div class="bg-bark-50 p-10">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h3 class="font-display font-semibold text-bark-800 text-lg">{p.name}</h3>
                <span class="text-label text-bark-400 text-[0.65rem]">{p.location}</span>
              </div>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
            </div>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed mb-4">{p.desc}</p>
            <div class="border-t border-bark-200 pt-4 mt-auto">
              <span class="text-label text-accent text-[0.6rem]">What BARK learns</span>
              <p class="text-bark-500 text-sm leading-relaxed mt-1">{p.lesson}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Global Projects -->
  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Global Inspiration</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        Established projects worldwide that have blazed trails in technology, governance, and community building.
      </p>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {globalProjects.map(p => (
          <div class="bg-bark-50 p-10">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h3 class="font-display font-semibold text-bark-800 text-lg">{p.name}</h3>
                <span class="text-label text-bark-400 text-[0.65rem]">{p.location}</span>
              </div>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
            </div>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed mb-4">{p.desc}</p>
            <div class="border-t border-bark-200 pt-4 mt-auto">
              <span class="text-label text-accent text-[0.6rem]">What BARK learns</span>
              <p class="text-bark-500 text-sm leading-relaxed mt-1">{p.lesson}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Governance Experiments -->
  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Governance Experiments</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        Projects pushing the boundaries of how communities govern themselves — with important lessons about what doesn't work.
      </p>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {governanceExperiments.map(p => (
          <div class={`bg-bark-50 p-10 ${p.type === 'warning' ? 'border-l-4 border-l-ember' : p.type === 'caution' ? 'border-l-4 border-l-gold' : ''}`}>
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h3 class="font-display font-semibold text-bark-800 text-lg">
                  {p.name}
                  {p.type === 'warning' && <span class="text-ember text-xs font-normal ml-2">Cautionary tale</span>}
                  {p.type === 'caution' && <span class="text-gold text-xs font-normal ml-2">Mixed results</span>}
                </h3>
                <span class="text-label text-bark-400 text-[0.65rem]">{p.location}</span>
              </div>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
            </div>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed mb-4">{p.desc}</p>
            <div class="border-t border-bark-200 pt-4 mt-auto">
              <span class="text-label text-accent text-[0.6rem]">What BARK learns</span>
              <p class="text-bark-500 text-sm leading-relaxed mt-1">{p.lesson}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Indigenous Governance -->
  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Indigenous Governance: The Ayllu</h2>
      <p class="text-bark-500 mb-6 max-w-2xl reveal" data-delay="100">
        Before European contact, Andean communities organized through the <strong class="text-bark-700">ayllu</strong> system —
        a kinship-based governance structure built on reciprocity, communal land management, and rotational leadership.
      </p>

      <div class="bg-bark-100 rounded-xl p-10 reveal" data-delay="200">
        <div class="max-w-2xl">
          <h3 class="font-display font-semibold text-bark-800 mb-4">Key Principles of the Ayllu</h3>
          <ul class="space-y-3">
            <li class="text-bark-600 leading-relaxed pl-6 relative before:content-[''] before:absolute before:left-0 before:top-[0.6em] before:w-2 before:h-px before:bg-accent">
              <strong class="text-bark-800">Ayni</strong> — reciprocal labor exchange. You help me plant, I help you build. No money changes hands. Obligation is social, not contractual.
            </li>
            <li class="text-bark-600 leading-relaxed pl-6 relative before:content-[''] before:absolute before:left-0 before:top-[0.6em] before:w-2 before:h-px before:bg-accent">
              <strong class="text-bark-800">Minka</strong> — communal work for shared benefit. Road repair, irrigation, public buildings. Everyone contributes labor to community infrastructure.
            </li>
            <li class="text-bark-600 leading-relaxed pl-6 relative before:content-[''] before:absolute before:left-0 before:top-[0.6em] before:w-2 before:h-px before:bg-accent">
              <strong class="text-bark-800">Rotational leadership</strong> — authority is not permanent. Leaders serve terms and rotate. This prevents power concentration and builds governance capacity across the community.
            </li>
            <li class="text-bark-600 leading-relaxed pl-6 relative before:content-[''] before:absolute before:left-0 before:top-[0.6em] before:w-2 before:h-px before:bg-accent">
              <strong class="text-bark-800">Ecological zones</strong> — ayllu members historically maintained access to multiple altitude zones (coast, valley, highland) for crop diversity. The Yungas was one such zone.
            </li>
          </ul>
          <p class="text-bark-500 mt-6 text-sm leading-relaxed">
            BARK does not appropriate the ayllu system. We study it, respect it, and recognize that many of our
            "innovative" governance ideas — cooperative labor, rotating leadership, commons management — have been
            practiced in this exact geography for centuries. Humility is not optional.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Global Movement -->
  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Global Movement</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        Organizations and networks building the infrastructure for local resilience at global scale.
        These are not theoretical — they have active programs, open-source tools, and in some cases
        already operate in Bolivia.
      </p>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {globalMovement.map(p => (
          <div class="bg-bark-50 p-10">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h3 class="font-display font-semibold text-bark-800 text-lg">{p.name}</h3>
                <span class="text-label text-bark-400 text-[0.65rem]">{p.location}</span>
              </div>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
            </div>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed mb-4">{p.desc}</p>
            <div class="border-t border-bark-200 pt-4 mt-auto">
              <span class="text-label text-accent text-[0.6rem]">What BARK learns</span>
              <p class="text-bark-500 text-sm leading-relaxed mt-1">{p.lesson}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-32 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="bg-bark-100 rounded-xl border border-bark-200 p-10 text-center reveal">
        <p class="font-display font-semibold text-bark-800 text-lg mb-2">Know a project we should learn from?</p>
        <p class="text-bark-500 max-w-lg mx-auto">
          If you're connected to any of these communities or know of others building similar things,
          <a href="/en/participate" class="text-accent underline underline-offset-4 decoration-accent/30 hover:decoration-accent">we'd love to hear from you</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
