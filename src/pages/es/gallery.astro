---
import Base from '../../layouts/Base.astro';

const photos = [
  { src: '/images/yungas/valley.jpg', alt: 'Yungas Valley', credit: 'CC BY-SA 3.0' },
  { src: '/images/yungas/coroico-clouds.jpg', alt: 'Coroico in morning cloud', credit: 'CC BY 4.0' },
  { src: '/images/yungas/yungas-landscape.jpg', alt: 'Cloud forest near Coroico', credit: 'CC BY-SA 4.0' },
  { src: '/images/yungas/death-road.jpg', alt: 'The road through the Yungas', credit: 'CC BY-SA 2.0' },
  { src: '/images/yungas/tocana-landscape.jpg', alt: 'Tocana, Afro-Bolivian community', credit: 'CC BY-SA 4.0' },
  { src: '/images/yungas/road-panorama.jpg', alt: 'Route near Coroico', credit: 'CC BY-SA 3.0' },
  { src: '/images/yungas/market.jpg', alt: 'Yungas market', credit: 'CC BY-SA 3.0' },
];
---

<Base title="Gallery" description="Photos from the Yungas region near Coroico, Bolivia — where BARK is being built.">

  <!-- Hero -->
  <section class="relative h-[45vh] min-h-[380px] flex items-end overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-bark-700 via-bark-800 to-bark-900"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-bark-900/90 via-bark-900/40 to-transparent"></div>
    <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-10 pb-12 w-full">
      <span class="text-label text-accent">Visual</span>
      <h1 class="text-headline text-bark-50 mt-2">Gallery</h1>
      <p class="text-body-lg text-bark-200 mt-2 max-w-xl">The Yungas, the cloud forest, and the communities where BARK will take root.</p>
    </div>
  </section>

  <!-- Photo Grid -->
  <section class="py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {photos.map((photo, i) => (
          <div class="photo-frame h-64 md:h-80 reveal" data-delay={String(i * 80)}>
            <img src={photo.src} alt={photo.alt} loading="lazy" />
            <div class="photo-credit">
              <span class="font-display font-medium text-white/90 text-xs block">{photo.alt}</span>
              <span>{photo.credit}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6 lg:px-10">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="text-headline text-bark-800 reveal">See It for Yourself</h2>
      <p class="text-body-lg text-bark-500 mt-4 reveal" data-delay="100">
        Photos only capture a fraction of the Yungas. The cloud forest, the terraced slopes,
        the sound of birds at dawn &mdash; this is the place we are building in.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8 reveal" data-delay="200">
        <a
          href="/es/location"
          class="group inline-flex items-center gap-3 px-7 py-4 bg-bark-800 text-bark-50 font-display font-semibold text-sm tracking-wide rounded hover:bg-bark-900 transition-colors duration-300"
        >
          Location Details
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a
          href="/es/participate"
          class="group inline-flex items-center gap-3 px-7 py-4 border border-bark-300 text-bark-700 font-display font-semibold text-sm tracking-wide rounded hover:border-bark-500 transition-colors duration-300"
        >
          Get Involved
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>
</Base>
