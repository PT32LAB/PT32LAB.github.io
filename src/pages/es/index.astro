---
import Base from '../../layouts/Base.astro';
import MyceliumCanvas from '../../components/MyceliumCanvas.astro';
import { t } from '../../i18n/ui';
const lang = 'en';

const pathways = [
  { key: 'builders' as const, num: '01', link: `/${lang}/pillars`, cta: 'See what we\u2019re building \u2192' },
  { key: 'investors' as const, num: '02', link: `/${lang}/investors`, cta: 'Read the investment thesis \u2192' },
  { key: 'community' as const, num: '03', link: `/${lang}/participate`, cta: 'Find your role \u2192' },
  { key: 'locals' as const, num: '04', link: `/${lang}/traditions`, cta: 'Our commitment to Coroico \u2192' },
];

const pillars = [
  { name: 'Techno Park', icon: 'technopark', desc: 'A fabrication lab where broken water pumps get fixed, circuit boards get milled, and the tools the supply chain abandoned get redesigned in the open.', link: `/${lang}/pillars/technopark` },
  { name: 'Incubator', icon: 'incubator', desc: 'Ventures that prove themselves in Coroico before they scale anywhere else. Built around local needs and local supply chains.', link: `/${lang}/pillars/incubator` },
  { name: 'Trading House', icon: 'trading', desc: 'Yungas coffee and cacao moving through channels we built -- not middlemen who have never tasted the fruit wet off the branch.', link: `/${lang}/pillars/trading` },
  { name: 'Retreat Center', icon: 'retreat', desc: 'Biometric-monitored contemplative practice. Aymara healers and biosensors in the same room, learning from each other.', link: `/${lang}/pillars/retreat` },
  { name: 'Infrastructure', icon: 'infrastructure', desc: 'Solar panels, spring-fed cisterns, vertical growing walls, mesh radios. The foundation that keeps everything else running.', link: `/${lang}/pillars/infrastructure` },
];
---

<Base title="Home" heroImage="/images/yungas/valley.jpg">
  <!-- Hero -- photo-first, works without JS -->
  <section class="relative min-h-screen flex items-end pb-20 overflow-hidden">
    <img src="/images/yungas/valley.jpg" alt="" width="1920" height="1282" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/20"></div>

    <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-10 w-full">
      <span class="text-label text-accent tracking-widest">Coroico, Bolivia -- 1,750 m</span>
      <h1 class="text-display text-white mt-4 max-w-4xl" style="text-shadow: 0 2px 20px rgba(0,0,0,0.5);">
        Soil and voltage.<br/>A community that tends itself.
      </h1>
      <p class="text-body-lg text-white/80 mt-6 max-w-2xl">
        BARK -- the <strong class="text-white">Bolivian Ark</strong> -- is a
        community learning to provision itself in the Yungas cloud forest. Five organs, one body.
        All of it published. All of it forkable. The plans belong to anyone willing to use them.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-6">
        <a href={`/${lang}/participate`} class="group inline-flex items-center gap-3 px-7 py-4 bg-accent text-night font-display font-semibold text-sm tracking-wide rounded hover:bg-accent-light transition-colors duration-300">
          {t(lang, 'hero.cta')}
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href={`/${lang}/vision`} class="inline-flex items-center gap-2 text-white/60 hover:text-white font-display text-sm tracking-wide transition-colors duration-300">
          {t(lang, 'hero.learn')}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- What BARK is -- concise value prop -->
  <section class="relative py-24 px-6 lg:px-10 overflow-hidden bg-warm-gradient bg-dots" style="background: linear-gradient(135deg, var(--color-bark-100) 0%, var(--color-bark-50) 40%, rgba(16,185,129,0.04) 100%);">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 20% 50%, var(--color-accent) 1px, transparent 1px), radial-gradient(circle at 80% 20%, var(--color-accent) 1px, transparent 1px), radial-gradient(circle at 60% 80%, var(--color-accent) 1px, transparent 1px); background-size: 60px 60px, 80px 80px, 70px 70px;"></div>
    <div class="relative max-w-[900px] mx-auto text-center">
      <span class="text-label text-accent reveal">What This Is</span>
      <h2 class="text-title text-bark-800 mt-4 reveal" data-delay="100">
        Not a bunker. Not a resort. A community that grows its own food, generates its own power, fixes its own equipment, and governs itself -- and keeps working when any single part breaks.
      </h2>
      <p class="text-body-lg text-bark-500 mt-6 leading-relaxed reveal" data-delay="200">
        Energy, food, manufacturing, commerce, governance -- five systems designed to keep each other running.
        The solar array powers the fabrication lab that maintains the irrigation pump that waters the
        food forest that feeds the people who vote on the budget. Remove one loop and the others
        compensate. The entire design is open-source, because a model that cannot be replicated
        dies with its founders.
      </p>
    </div>
  </section>

  <div class="photo-frame h-48 md:h-64 w-full" style="border-radius:0;">
    <img src="/images/yungas/yungas-landscape.jpg" alt="Cloud forest slopes of the Yungas" width="1920" height="1440" loading="lazy" decoding="async" class="w-full h-full object-cover" />
  </div>

  <!-- Why -- dark pull-quote section -->
  <section class="relative bg-bark-900 py-28 px-6 lg:px-10 overflow-hidden">
    <MyceliumCanvas />
    <div class="max-w-[1400px] mx-auto relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="text-label text-accent reveal">The Thesis</span>
        <h2 class="text-headline text-bark-50 mt-6 text-split">
          The supply chain is the civilization.
        </h2>
        <p class="text-body-lg text-bark-400 mt-8 leading-relaxed reveal" data-delay="200">
          Every generation assumes the grid will hold. Ours watches semiconductor shortages
          idle factories in six weeks, currency crises empty shelves overnight, and a single
          blocked canal rearrange global trade for months. The systems we depend on were
          optimized for efficiency, not for surviving their own fragility.
        </p>

        <!-- Pull-quote in dark section -->
        <blockquote class="mt-12 mb-8 py-8 border-t border-b border-bark-700 reveal" data-delay="300">
          <p class="font-display text-bark-100 text-xl md:text-2xl font-semibold leading-snug italic">
            "A solar installation takes months. A food forest takes years to fruit. Trust between strangers who share a water source compounds slowly and cannot be purchased."
          </p>
        </blockquote>

        <a href={`/${lang}/why`} class="inline-flex items-center gap-3 mt-4 text-accent hover:text-accent-light font-display text-sm tracking-wide transition-colors duration-300 reveal" data-delay="400">
          The full argument
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Who it's for -- four audience entry points -->
  <section class="py-32 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="max-w-xl mb-20">
        <span class="text-label text-accent reveal">Who This Is For</span>
        <h2 class="text-headline text-bark-800 mt-4 text-split">
          Four ways in
        </h2>
        <p class="text-body-lg text-bark-500 mt-4 reveal" data-delay="200">
          BARK needs specific people who do specific things with their hands, their capital, or their attention. Each entry point leads to real work.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden">
        {pathways.map((p, i) => (
          <a href={p.link} class="group relative bg-bark-50 p-10 hover:bg-bark-100 transition-colors duration-500 reveal" data-delay={String(i * 100)}>
            <span class="absolute top-2 right-4 font-display text-[4rem] font-extrabold text-bark-100 leading-none select-none">{p.num}</span>
            <span class="text-label text-bark-300 group-hover:text-accent transition-colors duration-300">{p.num}</span>
            <h3 class="text-title text-bark-800 mt-3 group-hover:text-bark-900 transition-colors duration-300">
              {t(lang, `paths.${p.key}.title` as any)}
            </h3>
            <p class="text-bark-500 mt-3 leading-relaxed max-w-sm">
              {t(lang, `paths.${p.key}.desc` as any)}
            </p>
            <div class="mt-6 flex items-center gap-2 text-accent opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-[-8px] group-hover:translate-x-0">
              <span class="text-sm font-display font-medium">{p.cta}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- Evidence -- stats that matter -->
  <section class="bg-bark-900 py-16 px-6 lg:px-10 border-t border-bark-800">
    <div class="max-w-[1400px] mx-auto">
      <div class="text-center mb-12">
        <span class="text-label text-accent reveal">The Numbers</span>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
        <div class="text-center reveal">
          <div class="text-headline text-accent font-display">
            <span class="counter" data-target="1750" data-suffix="m">0</span>
          </div>
          <span class="text-label text-bark-500 mt-2 block">Above Sea Level</span>
          <span class="text-xs text-bark-600 mt-1 block">Where the Andes become jungle</span>
        </div>
        <div class="text-center reveal" data-delay="100">
          <div class="text-headline text-bark-50 font-display">
            <span class="counter" data-target="400" data-suffix="+">0</span>
          </div>
          <span class="text-label text-bark-500 mt-2 block">Bird Species</span>
          <span class="text-xs text-bark-600 mt-1 block">Cock-of-the-rock to condor</span>
        </div>
        <div class="text-center reveal" data-delay="150">
          <div class="text-headline text-bark-50 font-display">
            <span class="counter" data-target="3000" data-suffix="+">0</span>
          </div>
          <span class="text-label text-bark-500 mt-2 block">Plant Species</span>
          <span class="text-xs text-bark-600 mt-1 block">Documented in the Yungas</span>
        </div>
        <div class="text-center reveal" data-delay="200">
          <div class="text-headline text-bark-50 font-display">18-28°C</div>
          <span class="text-label text-bark-500 mt-2 block">Year Round</span>
          <span class="text-xs text-bark-600 mt-1 block">Perpetual spring at altitude</span>
        </div>
        <div class="text-center reveal" data-delay="300">
          <div class="text-headline text-accent font-display">Open Source</div>
          <span class="text-label text-bark-500 mt-2 block">Everything</span>
          <span class="text-xs text-bark-600 mt-1 block">Plans, code, governance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Location teaser with prominent imagery -->
  <section class="py-32 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <!-- Full-width hero image -->
      <div class="relative rounded-xl overflow-hidden mb-16 reveal">
        <img src="/images/yungas/coroico-clouds.jpg" alt="Coroico valley at dawn, clouds rolling through the Yungas cloud forest" width="1920" height="1282" class="w-full h-72 md:h-[28rem] object-cover" loading="lazy" decoding="async" />
        <div class="absolute inset-0 bg-gradient-to-t from-bark-900/70 via-transparent to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-8">
          <span class="text-label text-accent">Location</span>
          <h2 class="text-headline text-bark-50 mt-2">Coroico, Yungas</h2>
        </div>
      </div>

      <div class="flex flex-col md:flex-row md:items-start gap-16">
        <div class="md:w-1/2">
          <p class="text-body-lg text-bark-500 leading-relaxed reveal">
            The road from La Paz drops 3,400 meters in three hours. Altiplano dust thins.
            Bromeliads appear on the rock cuts. The air goes wet and warm, smelling of soil
            and rotting fruit. You have crossed into the Yungas -- a climate band where
            nothing freezes, nothing scorches, and food grows twelve months without pause.
            The Inca terraced these slopes a thousand years ago. The knowledge is in the
            landscape itself.
          </p>
          <a href={`/${lang}/location`} class="inline-flex items-center gap-2 mt-6 text-accent font-display text-sm tracking-wide hover:text-accent-dim transition-colors reveal" data-delay="100">
            The geography in detail --
          </a>
        </div>
        <div class="md:w-1/2">
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-bark-100 p-6 rounded-xl reveal" data-delay="100">
              <div class="text-title text-bark-800 font-display counter" data-target="1750" data-suffix="m">0</div>
              <span class="text-label text-bark-400 mt-1 block">Cloud Forest Line</span>
            </div>
            <div class="bg-bark-100 p-6 rounded-xl reveal" data-delay="200">
              <div class="text-title text-bark-800 font-display">18-28°C</div>
              <span class="text-label text-bark-400 mt-1 block">Eternal Spring</span>
            </div>
            <div class="bg-bark-100 p-6 rounded-xl reveal" data-delay="300">
              <div class="text-title text-accent font-display">Top 5%</div>
              <span class="text-label text-bark-400 mt-1 block">Global Biodiversity</span>
            </div>
            <div class="bg-bark-100 p-6 rounded-xl reveal" data-delay="400">
              <div class="text-title text-bark-800 font-display">3h</div>
              <span class="text-label text-bark-400 mt-1 block">La Paz by Road</span>
            </div>
          </div>
          <!-- Valley photo below stats -->
          <div class="relative rounded-xl overflow-hidden mt-4 reveal" data-delay="500">
            <img src="/images/yungas/valley.jpg" alt="Yungas valley, Bolivia -- dramatic green slopes descending into cloud forest" width="1920" height="1282" class="w-full h-48 object-cover" loading="lazy" decoding="async" />
            <div class="absolute bottom-0 left-0 right-0 p-3 bg-gradient-to-t from-bark-900/80 to-transparent">
              <span class="text-xs text-bark-300">Photo: CC BY-SA 3.0, Jerrye & Roy Klotz MD via Wikimedia Commons</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- Five Components -- clean list -->
  <section class="py-32 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
        <div>
          <span class="text-label text-accent reveal">Structure</span>
          <h2 class="text-headline text-bark-800 mt-4 text-split">Five Components, One System</h2>
        </div>
        <a href={`/${lang}/pillars`} class="text-accent font-display text-sm tracking-wide hover:text-accent-dim transition-colors reveal" data-delay="200">
          Deep dive --
        </a>
      </div>

      <div class="space-y-px">
        {pillars.map((p, i) => (
          <a href={p.link} class="group flex flex-col md:flex-row md:items-center justify-between gap-4 py-8 px-6 bg-bark-50 hover:bg-bark-100 border-b border-bark-200 transition-colors duration-300 reveal" data-delay={String(i * 60)}>
            <div class="flex items-center gap-6">
              <span class="text-label text-bark-300 w-8">0{i + 1}</span>
              <img src={`/images/icons/${p.icon}.svg`} alt="" class="w-8 h-8 opacity-40 hidden md:block" />
              <h3 class="text-title text-bark-800 group-hover:text-bark-900 transition-colors">{p.name}</h3>
            </div>
            <div class="flex items-center gap-8">
              <p class="text-bark-500 md:max-w-md md:text-right">{p.desc}</p>
              <svg class="w-5 h-5 text-bark-300 group-hover:text-accent group-hover:translate-x-1 transition-all duration-300 hidden md:block flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </div>
          </a>
        ))}
      </div>

      <!-- System Interconnection Diagram -->
      <div class="mt-16 reveal" data-delay="400">
        <div class="text-center mb-6">
          <span class="text-label text-bark-400">How they connect</span>
        </div>
        <div class="bg-bark-100 rounded-xl p-8 flex justify-center">
          <img src="/images/diagrams/system-interconnection.svg" alt="Diagram showing how BARK's five components interconnect: Techno Park, Incubator, Trading House, Retreat Center, and Infrastructure linked by R&amp;D, supply, culture, and revenue flows" class="w-full max-w-2xl" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative bg-night py-32 px-6 lg:px-10 overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/20 rounded-full blur-[120px]"></div>
    </div>
    <div class="relative max-w-3xl mx-auto text-center">
      <h2 class="text-headline text-bark-50 text-split">
        Watching is not a form of participation.
      </h2>
      <p class="text-body-lg text-bark-400 mt-6 reveal" data-delay="200">
        The first cohort is forming. We need people who wire solar arrays, people who
        know Bolivian cooperative law, people willing to put capital into land, equipment,
        and infrastructure in the Yungas. If you read this far, you already know whether
        this is yours.
      </p>

      <!-- Founded by teaser -->
      <p class="text-bark-500 mt-8 text-sm reveal" data-delay="250">
        Initiated by Drow Dvorkin. Growing through entanglement.
        <a href={`/${lang}/team`} class="text-accent hover:text-accent-light transition-colors">The people so far &rarr;</a>
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4 reveal" data-delay="300">
        <a href="mailto:contact@pt32lab.org?subject=What%20I%27d%20bring%20to%20BARK" class="group inline-flex items-center gap-3 px-8 py-4 bg-accent text-night font-display font-semibold text-sm tracking-wide rounded hover:bg-accent-light transition-colors duration-300">
          Start with a conversation — tell us what you'd bring
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="https://github.com/PT32LAB" class="inline-flex items-center gap-2 px-8 py-4 border border-bark-700 text-bark-300 hover:text-bark-50 hover:border-bark-500 font-display text-sm tracking-wide rounded transition-all duration-300">
          Read the Source
        </a>
      </div>
    </div>
  </section>
</Base>
