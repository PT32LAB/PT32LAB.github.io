function statusColor(status: string) {
  switch (status) {
    case 'VERIFICADO': return 'bg-emerald-100 text-emerald-800 border-emerald-200';
    case 'RESPALDADO': return 'bg-cyan-100 text-cyan-800 border-cyan-200';
    case 'CALIFICADO': return 'bg-amber-100 text-amber-800 border-amber-200';
    case 'NO VERIFICADO': return 'bg-bark-100 text-bark-600 border-bark-200';
    case 'SÓLIDO': return 'bg-emerald-100 text-emerald-800 border-emerald-200';
    case 'PLAUSIBLE': return 'bg-cyan-100 text-cyan-800 border-cyan-200';
    case 'DÉBIL': return 'bg-amber-100 text-amber-800 border-amber-200';
    case 'ESPECULATIVO': return 'bg-bark-100 text-bark-600 border-bark-200';
    default: return 'bg-bark-100 text-bark-600 border-bark-200';
  }
}
