---
import Base from '../../layouts/Base.astro';

const claims = [
  { claim: 'Coroico elevation: ~1,750m', page: 'Location', source: 'Wikipedia, Climate-Data.org', status: 'VERIFIED' },
  { claim: 'Bird species: 400-500+ in Yungas corridor', page: 'Location', source: 'BirdLife International IBA datazone', status: 'SUPPORTED' },
  { claim: 'Plant species: 3,000+ in Cotapata-Yungas zone', page: 'Location', source: 'Kessler & Beck botanical assessments', status: 'SUPPORTED' },
  { claim: 'Population: ~19,397 (2012 census)', page: 'Location', source: 'INE Bolivia (Instituto Nacional de Estad\u00edstica)', status: 'VERIFIED', note: 'Stale: 2012 census is most recent available' },
  { claim: 'Rainfall: 1,100\u20131,300mm/yr', page: 'Location', source: 'Climate-Data.org', status: 'SUPPORTED' },
  { claim: 'Temperature range: 18\u201328\u00b0C', page: 'Location', source: 'Climate-Data.org, local weather records', status: 'VERIFIED' },
  { claim: 'Starlink opened in Bolivia Dec 2024', page: 'Location', source: 'AP/ABC News reporting', status: 'VERIFIED' },
  { claim: 'Yungas = part of UNESCO Qhapaq \u00d1an', page: 'Location', source: 'UNESCO World Heritage List #1459', status: 'VERIFIED' },
  { claim: 'ANMI Cotapata: 40,000ha protected area', page: 'Location', source: 'SERNAP Bolivia', status: 'SUPPORTED' },
  { claim: 'Carmen Pampa: 12km from Coroico', page: 'Network', source: 'UAC Carmen Pampa website, Google Maps', status: 'VERIFIED' },
  { claim: 'Bolivia homicide rate: ~4.4/100K', page: 'Risks', source: 'UNODC Global Study on Homicide, World Bank 2023', status: 'VERIFIED' },
  { claim: 'Bolivia homicide rate declined 2017\u20132019', page: 'Risks', source: 'UNODC data series', status: 'VERIFIED' },
  { claim: 'No nuclear targets in Bolivia', page: 'Resilience', source: 'OPANAL, ICAN, TPNW ratification records', status: 'VERIFIED' },
  { claim: 'Specialty coffee FOB price: $4.60/lb', page: 'Economy', source: '2024 Specialty Coffee Transaction Guide', status: 'VERIFIED' },
  { claim: 'Cacao exports: $2.9M / 621 metric tons (2023)', page: 'Economy', source: 'IBCE (Instituto Boliviano de Comercio Exterior), Rio Times', status: 'SUPPORTED' },
  { claim: 'Solar radiation: 3.5\u20134.5 kWh/m\u00b2/day', page: 'Components', source: 'Global Solar Atlas (World Bank/ESMAP)', status: 'VERIFIED' },
  { claim: '$325M Solar Electrification Program', page: 'Investors', source: 'World Bank press release, Nov 2023', status: 'VERIFIED' },
  { claim: 'IDB $4.5B development package (2026\u20132028)', page: 'Investors', source: 'IDB official announcement', status: 'SUPPORTED' },
  { claim: 'Cooperative law: Ley 356 (2013)', page: 'Investors', source: 'Infoleyes Bolivia (primary legal text)', status: 'VERIFIED' },
  { claim: 'Foreigners can join cooperatives', page: 'Investors', source: 'Ley 356, Art\u00edculo 33', status: 'VERIFIED' },
  { claim: 'Leadership positions require citizenship', page: 'Investors', source: 'Ley 356, Art\u00edculo 65', status: 'VERIFIED' },
  { claim: 'Cooperatives are NOT tax-exempt', page: 'Investors', source: 'Ley 843, Art\u00edculo 37 (tax code)', status: 'VERIFIED' },
  { claim: 'Bolivia reserves: ~$100M', page: 'Economy', source: 'IMF, International Banker (2024)', status: 'VERIFIED', note: 'As of 2024; volatile figure' },
  { claim: 'Bolivia inflation: 20%+', page: 'Economy', source: 'IMF World Economic Outlook', status: 'VERIFIED', note: 'As of mid-2025 estimates' },
  { claim: 'Mondragon: 70,000+ employees', page: 'Governance', source: 'Mondragon Corporation annual report', status: 'SUPPORTED', note: 'Fluctuates; was ~80K at peak' },
  { claim: 'RepRap self-replication: 50\u201370% by component weight', page: 'Components', source: 'reprap.org project documentation', status: 'QUALIFIED', note: 'Depends on printer model and methodology' },
  { claim: 'Community failure rate: "most fail within 5 years"', page: 'Risks', source: 'FIC (Fellowship for Intentional Community) research', status: 'QUALIFIED', note: 'Cited widely; primary study details unconfirmed' },
  { claim: '15,000 active cooperatives in Bolivia', page: 'Investors', source: 'AFCOOP registry data', status: 'SUPPORTED' },
];

function statusColor(status: string) {
  switch (status) {
    case 'VERIFIED': return 'bg-emerald-100 text-emerald-800 border-emerald-200';
    case 'SUPPORTED': return 'bg-cyan-100 text-cyan-800 border-cyan-200';
    case 'QUALIFIED': return 'bg-amber-100 text-amber-800 border-amber-200';
    case 'UNVERIFIED': return 'bg-bark-100 text-bark-600 border-bark-200';
    default: return 'bg-bark-100 text-bark-600 border-bark-200';
  }
}
---

<Base title="Fact-Checked" description="Every factual claim on this site has been verified against primary sources. Here is the evidence trail.">

  <!-- Hero -->
  <section class="relative h-[50vh] min-h-[420px] flex items-end overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-bark-800 via-bark-900 to-bark-900"></div>
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 30% 70%, var(--color-accent) 0%, transparent 50%), radial-gradient(circle at 70% 30%, var(--color-cyan) 0%, transparent 50%);"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-bark-900/95 via-bark-900/40 to-transparent"></div>
    <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-10 pb-14 w-full">
      <span class="text-label text-accent">Transparency</span>
      <h1 class="text-headline text-bark-50 mt-2 text-split">Fact-Checked</h1>
      <p class="text-body-lg text-bark-300 mt-3 max-w-2xl">
        Every factual claim on this site has been verified against primary sources.
        Here is the evidence trail. We publish our mistakes alongside our sources
        because trust requires transparency.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="max-w-3xl">
        <h2 class="text-title text-bark-800 mb-6 reveal">Methodology</h2>
        <p class="text-bark-600 text-[1.1rem] leading-[1.85] mb-6 reveal" data-delay="100">
          Claims on this site are verified against primary sources: government databases,
          academic papers, official reports, legal texts, and recognized international organizations.
          We do not rely on social media, anonymous forums, or undated blog posts as primary evidence.
        </p>

        <div class="grid sm:grid-cols-2 gap-6 mt-10 reveal" data-delay="200">
          <div class="bg-bark-50 border border-bark-200 rounded-xl p-6">
            <h3 class="font-display font-semibold text-bark-800 text-[0.95rem] mb-3">Confidence Levels</h3>
            <ul class="space-y-3 text-[0.9rem] text-bark-600 leading-relaxed">
              <li class="flex items-start gap-3">
                <span class="inline-block mt-1 px-2 py-0.5 text-[0.65rem] font-display font-semibold tracking-wider uppercase rounded border bg-emerald-100 text-emerald-800 border-emerald-200 shrink-0">Verified</span>
                <span>Confirmed against a primary source (government data, legal text, direct measurement)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="inline-block mt-1 px-2 py-0.5 text-[0.65rem] font-display font-semibold tracking-wider uppercase rounded border bg-cyan-100 text-cyan-800 border-cyan-200 shrink-0">Supported</span>
                <span>Confirmed against a credible secondary source (reputable journalism, institutional reports)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="inline-block mt-1 px-2 py-0.5 text-[0.65rem] font-display font-semibold tracking-wider uppercase rounded border bg-amber-100 text-amber-800 border-amber-200 shrink-0">Qualified</span>
                <span>True with caveats &mdash; the claim is broadly correct but depends on methodology, timeframe, or definition</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="inline-block mt-1 px-2 py-0.5 text-[0.65rem] font-display font-semibold tracking-wider uppercase rounded border bg-bark-100 text-bark-600 border-bark-200 shrink-0">Unverified</span>
                <span>Stated on the site but we could not confirm it against any independent source &mdash; flagged as such</span>
              </li>
            </ul>
          </div>

          <div class="bg-bark-50 border border-bark-200 rounded-xl p-6">
            <h3 class="font-display font-semibold text-bark-800 text-[0.95rem] mb-3">Process</h3>
            <ul class="space-y-3 text-[0.9rem] text-bark-600 leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="text-accent font-semibold shrink-0">1.</span>
                <span><strong>Automated pass</strong> &mdash; every link tested, every statistic cross-referenced against its cited source</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent font-semibold shrink-0">2.</span>
                <span><strong>Manual fact-check</strong> &mdash; each factual claim traced to its primary source and confidence level assigned</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent font-semibold shrink-0">3.</span>
                <span><strong>Editorial audit</strong> &mdash; full-site review for consistency, contradictions, and unsupported claims</span>
              </li>
            </ul>
            <p class="text-[0.85rem] text-bark-500 mt-5 leading-relaxed">
              All research documents are public. The raw data, source links, and audit reports
              are available in the
              <a href="https://github.com/PT32LAB/PT32LAB.github.io/tree/main/research" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">GitHub research folder</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo break -->
  <div class="photo-frame h-48 md:h-64 w-full reveal" style="border-radius:0;">
    <img src="/images/yungas/yungas-landscape.jpg" alt="The Yungas cloud forest where every claim on this site originates" loading="lazy" class="w-full h-full object-cover" />
    <div class="photo-credit">Evidence starts with place</div>
  </div>

  <!-- Claims Table -->
  <section class="py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Claims &amp; Sources</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        {claims.length} key factual claims across the site, each with its source and verification status.
        This is not exhaustive &mdash; it covers the claims most likely to influence a reader's decision.
      </p>

      <div class="overflow-x-auto reveal" data-delay="200">
        <table class="w-full text-sm border-collapse rounded-xl overflow-hidden border border-bark-200">
          <thead class="bg-bark-800">
            <tr>
              <th class="px-4 py-3 text-left font-display font-semibold text-[0.7rem] tracking-[0.05em] uppercase text-bark-50">Claim</th>
              <th class="px-4 py-3 text-left font-display font-semibold text-[0.7rem] tracking-[0.05em] uppercase text-bark-50 hidden md:table-cell">Page</th>
              <th class="px-4 py-3 text-left font-display font-semibold text-[0.7rem] tracking-[0.05em] uppercase text-bark-50">Source</th>
              <th class="px-4 py-3 text-left font-display font-semibold text-[0.7rem] tracking-[0.05em] uppercase text-bark-50 w-28">Status</th>
            </tr>
          </thead>
          <tbody>
            {claims.map((row, i) => (
              <tr class={`border-b border-bark-100 ${i % 2 === 0 ? 'bg-white' : 'bg-bark-50/50'}`}>
                <td class="px-4 py-3 text-bark-800 font-medium">
                  {row.claim}
                  {row.note && (
                    <span class="block text-[0.75rem] text-bark-400 mt-1 font-normal">{row.note}</span>
                  )}
                  <span class="md:hidden block text-[0.7rem] text-bark-400 mt-1 font-normal">{row.page}</span>
                </td>
                <td class="px-4 py-3 text-bark-500 hidden md:table-cell">{row.page}</td>
                <td class="px-4 py-3 text-bark-600 text-[0.85rem]">{row.source}</td>
                <td class="px-4 py-3">
                  <span class={`inline-block px-2 py-0.5 text-[0.65rem] font-display font-semibold tracking-wider uppercase rounded border ${statusColor(row.status)}`}>
                    {row.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Summary counts -->
      <div class="flex flex-wrap gap-4 mt-8 reveal" data-delay="300">
        <div class="flex items-center gap-2 text-[0.85rem] text-bark-600">
          <span class="inline-block w-3 h-3 rounded bg-emerald-200 border border-emerald-300"></span>
          Verified: {claims.filter(c => c.status === 'VERIFIED').length}
        </div>
        <div class="flex items-center gap-2 text-[0.85rem] text-bark-600">
          <span class="inline-block w-3 h-3 rounded bg-cyan-200 border border-cyan-300"></span>
          Supported: {claims.filter(c => c.status === 'SUPPORTED').length}
        </div>
        <div class="flex items-center gap-2 text-[0.85rem] text-bark-600">
          <span class="inline-block w-3 h-3 rounded bg-amber-200 border border-amber-300"></span>
          Qualified: {claims.filter(c => c.status === 'QUALIFIED').length}
        </div>
        <div class="flex items-center gap-2 text-[0.85rem] text-bark-600">
          <span class="inline-block w-3 h-3 rounded bg-bark-200 border border-bark-300"></span>
          Unverified: {claims.filter(c => c.status === 'UNVERIFIED').length}
        </div>
      </div>
    </div>
  </section>

  <!-- Known Limitations -->
  <section class="bg-bark-100 py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="max-w-3xl">
        <h2 class="text-title text-bark-800 mb-6 reveal">Known Limitations</h2>
        <p class="text-bark-600 text-[1.05rem] leading-[1.85] mb-8 reveal" data-delay="100">
          We could not verify everything. The following data points are stated as estimates or
          qualified claims throughout the site because reliable primary sources do not exist
          or are not publicly accessible.
        </p>

        <div class="space-y-6 reveal" data-delay="200">
          <div class="bg-white border border-bark-200 rounded-xl p-6">
            <h3 class="font-display font-semibold text-bark-800 text-[0.95rem] mb-4">What We Could Not Verify</h3>
            <ul class="space-y-3 text-[0.9rem] text-bark-600 leading-relaxed">
              <li class="flex items-start gap-3">
                <span class="text-amber-500 mt-0.5 shrink-0">&mdash;</span>
                <span><strong>Coroico-specific crime statistics.</strong> Bolivia publishes national and departmental data, but no public municipal-level crime data exists for Nor Yungas province. Our safety assessment uses national and regional figures.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-amber-500 mt-0.5 shrink-0">&mdash;</span>
                <span><strong>Current internet speeds in Coroico.</strong> No public speed-test monitoring data for the area. Starlink availability is confirmed; actual user experience is anecdotal.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-amber-500 mt-0.5 shrink-0">&mdash;</span>
                <span><strong>Exact land prices.</strong> Bolivia has no public real-estate registry with transaction prices for the Coroico area. Pricing claims on the site are marked as estimates based on local inquiry.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-amber-500 mt-0.5 shrink-0">&mdash;</span>
                <span><strong>Hospital staffing levels.</strong> Coroico has a hospital, but staffing data (number of doctors, specialists, equipment) is not published online. The health page notes this gap.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-amber-500 mt-0.5 shrink-0">&mdash;</span>
                <span><strong>2024 census detailed results.</strong> Bolivia's most recent detailed census data at the municipal level dates from 2012. Updated population figures are extrapolated estimates.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-amber-500 mt-0.5 shrink-0">&mdash;</span>
                <span><strong>Intentional community failure rate.</strong> Widely cited ("most fail within five years") but the specific primary study is not easily traceable. We cite FIC research with a qualification.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Research Library -->
  <section class="py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="max-w-3xl">
        <h2 class="text-title text-bark-800 mb-6 reveal">Research Library</h2>
        <p class="text-bark-600 text-[1.05rem] leading-[1.85] mb-8 reveal" data-delay="100">
          All research backing this site is public. The
          <a href="https://github.com/PT32LAB/PT32LAB.github.io/tree/main/research" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline font-medium">research folder on GitHub</a>
          contains 13 research documents with 449 verified links covering:
        </p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 reveal" data-delay="200">
          {[
            { title: 'Location & Geography', desc: 'Climate, terrain, infrastructure, connectivity' },
            { title: 'Economy & Trade', desc: 'Coffee, cacao, Bolivia macro data, cooperative law' },
            { title: 'Safety & Risk', desc: 'Crime data, natural hazards, political stability' },
            { title: 'Governance Models', desc: 'Cooperatives, DAOs, ayllu, case studies' },
            { title: 'Technology & Energy', desc: 'Solar potential, fabrication, RepRap, GVCS' },
            { title: 'Health & Retreat', desc: 'Medical infrastructure, longevity research, plant medicine legal status' },
            { title: 'Community Networks', desc: 'Neighbors, allies, Afro-Bolivian communities, universities' },
            { title: 'Investment Context', desc: 'World Bank programs, IDB packages, Bolivia regulatory framework' },
            { title: 'Resilience Analysis', desc: 'Crisis scenarios, nuclear-free zones, supply chain independence' },
            { title: 'Design & Media', desc: 'Image libraries, design systems, photography sources' },
            { title: 'Editorial Audit', desc: 'Full-site content review, consistency check, rewrites' },
            { title: 'Link Verification', desc: '449 links tested and categorized by status' },
          ].map(item => (
            <div class="bg-bark-50 border border-bark-200 rounded-lg p-4">
              <h3 class="font-display font-semibold text-bark-800 text-[0.85rem] mb-1">{item.title}</h3>
              <p class="text-[0.8rem] text-bark-500 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

        <a
          href="https://github.com/PT32LAB/PT32LAB.github.io/tree/main/research"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-3 mt-10 px-7 py-4 bg-bark-800 text-bark-50 font-display font-semibold text-sm tracking-wide rounded hover:bg-bark-900 transition-colors duration-300 reveal" data-delay="300"
        >
          Browse All Research on GitHub
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Update Log -->
  <section class="bg-bark-100 py-16 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="max-w-3xl">
        <h2 class="font-display font-semibold text-bark-800 text-[1.1rem] mb-4 reveal">Update Log</h2>
        <div class="space-y-3 text-[0.9rem] text-bark-600 leading-relaxed reveal" data-delay="100">
          <p>
            <strong>April 2026</strong> &mdash; Initial publication. All claims verified against sources listed above.
            Three-pass review completed (automated link check, manual fact-check, editorial audit).
          </p>
          <p class="text-bark-500 text-[0.85rem]">
            This page is updated when claims change, new sources become available, or errors are discovered.
            If you find an error, please
            <a href="mailto:contact@pt32lab.org" class="text-accent hover:underline">let us know</a> or
            <a href="https://github.com/PT32LAB/PT32LAB.github.io/issues" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">open a GitHub issue</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6 lg:px-10">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="text-title text-bark-800 reveal">Trust is built in public.</h2>
      <p class="text-bark-500 mt-4 reveal" data-delay="100">
        Every claim sourced. Every limitation disclosed. Every research document published.
        That is the standard we hold ourselves to.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8 reveal" data-delay="200">
        <a
          href="https://github.com/PT32LAB/PT32LAB.github.io/tree/main/research"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-3 px-7 py-4 bg-bark-800 text-bark-50 font-display font-semibold text-sm tracking-wide rounded hover:bg-bark-900 transition-colors duration-300"
        >
          View Research
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a
          href="mailto:contact@pt32lab.org"
          class="group inline-flex items-center justify-center gap-3 px-7 py-4 border-2 border-bark-300 text-bark-700 font-display font-semibold text-sm tracking-wide rounded hover:border-bark-500 hover:text-bark-900 transition-colors duration-300"
        >
          Report an Error
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

</Base>
