---
import Base from '../../layouts/Base.astro';

const claims = [
  { claim: 'Elevación de Coroico: ~1.750m', page: 'Ubicación', source: 'Wikipedia, Climate-Data.org', status: 'VERIFICADO' },
  { claim: 'Especies de aves: 400-500+ en corredor Yungas', page: 'Ubicación', source: 'BirdLife International IBA datazone', status: 'RESPALDADO' },
  { claim: 'Especies de plantas: 3.000+ en zona Cotapata-Yungas', page: 'Ubicación', source: 'Evaluaciones botánicas de Kessler & Beck', status: 'RESPALDADO' },
  { claim: 'Población: ~19.397 (censo 2012)', page: 'Ubicación', source: 'INE Bolivia (Instituto Nacional de Estadística)', status: 'VERIFICADO', note: 'Desactualizado: el censo de 2012 es el más reciente disponible' },
  { claim: 'Precipitación: 1.100–1.300mm/año', page: 'Ubicación', source: 'Climate-Data.org', status: 'RESPALDADO' },
  { claim: 'Rango de temperatura: 18–28°C', page: 'Ubicación', source: 'Climate-Data.org, registros meteorológicos locales', status: 'VERIFICADO' },
  { claim: 'Starlink habilitado en Bolivia dic. 2024', page: 'Ubicación', source: 'Reportajes de AP/ABC News', status: 'VERIFICADO' },
  { claim: 'Yungas = parte del Qhapaq Ñan de UNESCO', page: 'Ubicación', source: 'Lista de Patrimonio Mundial UNESCO #1459', status: 'VERIFICADO' },
  { claim: 'ANMI Cotapata: 40.000ha de área protegida', page: 'Ubicación', source: 'SERNAP Bolivia', status: 'RESPALDADO' },
  { claim: 'Carmen Pampa: 12km de Coroico', page: 'Red', source: 'Sitio web UAC Carmen Pampa, Google Maps', status: 'VERIFICADO' },
  { claim: 'Tasa de homicidios de Bolivia: ~4,4/100K', page: 'Riesgos', source: 'Estudio Global sobre Homicidio UNODC, Banco Mundial 2023', status: 'VERIFICADO' },
  { claim: 'Tasa de homicidios de Bolivia descendió 2017–2019', page: 'Riesgos', source: 'Serie de datos UNODC', status: 'VERIFICADO' },
  { claim: 'Sin objetivos nucleares en Bolivia', page: 'Resiliencia', source: 'OPANAL, ICAN, registros de ratificación del TPNW', status: 'VERIFICADO' },
  { claim: 'Precio FOB café especialidad: $4,60/lb', page: 'Economía', source: 'Guía de Transacciones de Café Especialidad 2024', status: 'VERIFICADO' },
  { claim: 'Exportaciones de cacao: $2,9M / 621 toneladas métricas (2023)', page: 'Economía', source: 'IBCE (Instituto Boliviano de Comercio Exterior), Rio Times', status: 'RESPALDADO' },
  { claim: 'Radiación solar: 3,5–4,5 kWh/m²/día', page: 'Componentes', source: 'Global Solar Atlas (Banco Mundial/ESMAP)', status: 'VERIFICADO' },
  { claim: 'Programa de Electrificación Solar de $325M', page: 'Inversores', source: 'Comunicado del Banco Mundial, nov. 2023', status: 'VERIFICADO' },
  { claim: 'Paquete BID $4.500M (2026–2028)', page: 'Inversores', source: 'Anuncio oficial del BID', status: 'RESPALDADO' },
  { claim: 'Ley de cooperativas: Ley 356 (2013)', page: 'Inversores', source: 'Infoleyes Bolivia (texto legal primario)', status: 'VERIFICADO' },
  { claim: 'Extranjeros pueden unirse a cooperativas', page: 'Inversores', source: 'Ley 356, Artículo 33', status: 'VERIFICADO' },
  { claim: 'Cargos directivos requieren ciudadanía', page: 'Inversores', source: 'Ley 356, Artículo 65', status: 'VERIFICADO' },
  { claim: 'Las cooperativas NO están exentas de impuestos', page: 'Inversores', source: 'Ley 843, Artículo 37 (código tributario)', status: 'VERIFICADO' },
  { claim: 'Reservas de Bolivia: ~$100M', page: 'Economía', source: 'FMI, International Banker (2024)', status: 'VERIFICADO', note: 'A 2024; cifra volátil' },
  { claim: 'Inflación de Bolivia: 20%+', page: 'Economía', source: 'Perspectivas Económicas Mundiales del FMI', status: 'VERIFICADO', note: 'Estimaciones a mediados de 2025' },
  { claim: 'Mondragón: 70.000+ empleados', page: 'Gobernanza', source: 'Informe anual de Corporación Mondragón', status: 'RESPALDADO', note: 'Fluctuante; fue ~80K en su punto máximo' },
  { claim: 'Auto-replicación RepRap: 50–70% por peso de componentes', page: 'Componentes', source: 'Documentación del proyecto reprap.org', status: 'CALIFICADO', note: 'Depende del modelo de impresora y la metodología' },
  { claim: 'Tasa de fracaso de comunidades: "la mayoría fracasa en 5 años"', page: 'Riesgos', source: 'Investigación de FIC (Fellowship for Intentional Community)', status: 'CALIFICADO', note: 'Ampliamente citado; detalles del estudio primario no confirmados' },
  { claim: '15.000 cooperativas activas en Bolivia', page: 'Inversores', source: 'Datos del registro de AFCOOP', status: 'RESPALDADO' },
];

function statusColor(status: string) {
  switch (status) {
    case 'VERIFICADO': return 'bg-emerald-100 text-emerald-800 border-emerald-200';
    case 'RESPALDADO': return 'bg-cyan-100 text-cyan-800 border-cyan-200';
    case 'CALIFICADO': return 'bg-amber-100 text-amber-800 border-amber-200';
    case 'NO VERIFICADO': return 'bg-bark-100 text-bark-600 border-bark-200';
    default: return 'bg-bark-100 text-bark-600 border-bark-200';
  }
}
---

<Base title="Verificación de Datos" description="Cada afirmación factual en este sitio ha sido verificada contra fuentes primarias. Aquí está la evidencia.">

  <!-- Hero -->
  <section class="relative h-[50vh] min-h-[420px] flex items-end overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-bark-800 via-bark-900 to-bark-900"></div>
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 30% 70%, var(--color-accent) 0%, transparent 50%), radial-gradient(circle at 70% 30%, var(--color-cyan) 0%, transparent 50%);"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-bark-900/95 via-bark-900/40 to-transparent"></div>
    <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-10 pb-14 w-full">
      <span class="text-label text-accent">Transparencia</span>
      <h1 class="text-headline text-bark-50 mt-2 text-split">Verificación de Datos</h1>
      <p class="text-body-lg text-bark-300 mt-3 max-w-2xl">
        Cada afirmación factual en este sitio ha sido verificada contra fuentes primarias.
        Aquí está la evidencia. Publicamos nuestros errores junto con nuestras fuentes
        porque la confianza requiere transparencia.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="max-w-3xl">
        <h2 class="text-title text-bark-800 mb-6 reveal">Metodología</h2>
        <p class="text-bark-600 text-[1.1rem] leading-[1.85] mb-6 reveal" data-delay="100">
          Las afirmaciones en este sitio se verifican contra fuentes primarias: bases de datos gubernamentales,
          artículos académicos, informes oficiales, textos legales y organizaciones internacionales reconocidas.
          No dependemos de redes sociales, foros anónimos o blogs sin fecha como evidencia primaria.
        </p>

        <div class="grid sm:grid-cols-2 gap-6 mt-10 reveal" data-delay="200">
          <div class="bg-bark-50 border border-bark-200 rounded-xl p-6">
            <h3 class="font-display font-semibold text-bark-800 text-[0.95rem] mb-3">Niveles de Confianza</h3>
            <ul class="space-y-3 text-[0.9rem] text-bark-600 leading-relaxed">
              <li class="flex items-start gap-3">
                <span class="inline-block mt-1 px-2 py-0.5 text-[0.65rem] font-display font-semibold tracking-wider uppercase rounded border bg-emerald-100 text-emerald-800 border-emerald-200 shrink-0">Verificado</span>
                <span>Confirmado contra una fuente primaria (datos gubernamentales, texto legal, medición directa)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="inline-block mt-1 px-2 py-0.5 text-[0.65rem] font-display font-semibold tracking-wider uppercase rounded border bg-cyan-100 text-cyan-800 border-cyan-200 shrink-0">Respaldado</span>
                <span>Confirmado contra una fuente secundaria creíble (periodismo reputado, informes institucionales)</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="inline-block mt-1 px-2 py-0.5 text-[0.65rem] font-display font-semibold tracking-wider uppercase rounded border bg-amber-100 text-amber-800 border-amber-200 shrink-0">Calificado</span>
                <span>Verdadero con salvedades &mdash; la afirmación es correcta en general pero depende de la metodología, el periodo o la definición</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="inline-block mt-1 px-2 py-0.5 text-[0.65rem] font-display font-semibold tracking-wider uppercase rounded border bg-bark-100 text-bark-600 border-bark-200 shrink-0">No Verificado</span>
                <span>Declarado en el sitio pero no pudimos confirmarlo contra ninguna fuente independiente &mdash; marcado como tal</span>
              </li>
            </ul>
          </div>

          <div class="bg-bark-50 border border-bark-200 rounded-xl p-6">
            <h3 class="font-display font-semibold text-bark-800 text-[0.95rem] mb-3">Proceso</h3>
            <ul class="space-y-3 text-[0.9rem] text-bark-600 leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="text-accent font-semibold shrink-0">1.</span>
                <span><strong>Pase automatizado</strong> &mdash; cada enlace probado, cada estadística verificada contra su fuente citada</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent font-semibold shrink-0">2.</span>
                <span><strong>Verificación manual</strong> &mdash; cada afirmación factual rastreada hasta su fuente primaria y nivel de confianza asignado</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent font-semibold shrink-0">3.</span>
                <span><strong>Auditoría editorial</strong> &mdash; revisión completa del sitio para consistencia, contradicciones y afirmaciones sin respaldo</span>
              </li>
            </ul>
            <p class="text-[0.85rem] text-bark-500 mt-5 leading-relaxed">
              Todos los documentos de investigación son públicos. Los datos brutos, enlaces de fuentes e informes de auditoría
              están disponibles en la
              <a href="https://github.com/PT32LAB/PT32LAB.github.io/tree/main/research" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">carpeta de investigación en GitHub</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo break -->
  <div class="photo-frame h-48 md:h-64 w-full reveal" style="border-radius:0;">
    <img src="/images/yungas/yungas-landscape.jpg" alt="El bosque nublado de los Yungas donde se origina cada afirmación de este sitio" loading="lazy" class="w-full h-full object-cover" />
    <div class="photo-credit">La evidencia comienza con el lugar</div>
  </div>

  <!-- Claims Table -->
  <section class="py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Afirmaciones y Fuentes</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        {claims.length} afirmaciones factuales clave en todo el sitio, cada una con su fuente y estado de verificación.
        Esto no es exhaustivo &mdash; cubre las afirmaciones con mayor probabilidad de influir en la decisión de un lector.
      </p>

      <div class="overflow-x-auto reveal" data-delay="200">
        <table class="w-full text-sm border-collapse rounded-xl overflow-hidden border border-bark-200">
          <thead class="bg-bark-800">
            <tr>
              <th class="px-4 py-3 text-left font-display font-semibold text-[0.7rem] tracking-[0.05em] uppercase text-bark-50">Afirmación</th>
              <th class="px-4 py-3 text-left font-display font-semibold text-[0.7rem] tracking-[0.05em] uppercase text-bark-50 hidden md:table-cell">Página</th>
              <th class="px-4 py-3 text-left font-display font-semibold text-[0.7rem] tracking-[0.05em] uppercase text-bark-50">Fuente</th>
              <th class="px-4 py-3 text-left font-display font-semibold text-[0.7rem] tracking-[0.05em] uppercase text-bark-50 w-32">Estado</th>
            </tr>
          </thead>
          <tbody>
            {claims.map((row, i) => (
              <tr class={`border-b border-bark-100 ${i % 2 === 0 ? 'bg-white' : 'bg-bark-50/50'}`}>
                <td class="px-4 py-3 text-bark-800 font-medium">
                  {row.claim}
                  {row.note && (
                    <span class="block text-[0.75rem] text-bark-400 mt-1 font-normal">{row.note}</span>
                  )}
                  <span class="md:hidden block text-[0.7rem] text-bark-400 mt-1 font-normal">{row.page}</span>
                </td>
                <td class="px-4 py-3 text-bark-500 hidden md:table-cell">{row.page}</td>
                <td class="px-4 py-3 text-bark-600 text-[0.85rem]">{row.source}</td>
                <td class="px-4 py-3">
                  <span class={`inline-block px-2 py-0.5 text-[0.65rem] font-display font-semibold tracking-wider uppercase rounded border ${statusColor(row.status)}`}>
                    {row.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Summary counts -->
      <div class="flex flex-wrap gap-4 mt-8 reveal" data-delay="300">
        <div class="flex items-center gap-2 text-[0.85rem] text-bark-600">
          <span class="inline-block w-3 h-3 rounded bg-emerald-200 border border-emerald-300"></span>
          Verificado: {claims.filter(c => c.status === 'VERIFICADO').length}
        </div>
        <div class="flex items-center gap-2 text-[0.85rem] text-bark-600">
          <span class="inline-block w-3 h-3 rounded bg-cyan-200 border border-cyan-300"></span>
          Respaldado: {claims.filter(c => c.status === 'RESPALDADO').length}
        </div>
        <div class="flex items-center gap-2 text-[0.85rem] text-bark-600">
          <span class="inline-block w-3 h-3 rounded bg-amber-200 border border-amber-300"></span>
          Calificado: {claims.filter(c => c.status === 'CALIFICADO').length}
        </div>
        <div class="flex items-center gap-2 text-[0.85rem] text-bark-600">
          <span class="inline-block w-3 h-3 rounded bg-bark-200 border border-bark-300"></span>
          No verificado: {claims.filter(c => c.status === 'NO VERIFICADO').length}
        </div>
      </div>
    </div>
  </section>

  <!-- Known Limitations -->
  <section class="bg-bark-100 py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="max-w-3xl">
        <h2 class="text-title text-bark-800 mb-6 reveal">Limitaciones Conocidas</h2>
        <p class="text-bark-600 text-[1.05rem] leading-[1.85] mb-8 reveal" data-delay="100">
          No pudimos verificar todo. Los siguientes datos se presentan como estimaciones o
          afirmaciones calificadas en todo el sitio porque las fuentes primarias confiables no existen
          o no son accesibles públicamente.
        </p>

        <div class="space-y-6 reveal" data-delay="200">
          <div class="bg-white border border-bark-200 rounded-xl p-6">
            <h3 class="font-display font-semibold text-bark-800 text-[0.95rem] mb-4">Lo Que No Pudimos Verificar</h3>
            <ul class="space-y-3 text-[0.9rem] text-bark-600 leading-relaxed">
              <li class="flex items-start gap-3">
                <span class="text-amber-500 mt-0.5 shrink-0">&mdash;</span>
                <span><strong>Estadísticas de crimen específicas de Coroico.</strong> Bolivia publica datos nacionales y departamentales, pero no existen datos públicos de crimen a nivel municipal para la provincia Nor Yungas. Nuestra evaluación de seguridad usa cifras nacionales y regionales.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-amber-500 mt-0.5 shrink-0">&mdash;</span>
                <span><strong>Velocidades actuales de internet en Coroico.</strong> No hay datos públicos de monitoreo de velocidad para el área. La disponibilidad de Starlink está confirmada; la experiencia real del usuario es anecdótica.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-amber-500 mt-0.5 shrink-0">&mdash;</span>
                <span><strong>Precios exactos de terrenos.</strong> Bolivia no tiene un registro público de bienes raíces con precios de transacción para el área de Coroico. Las afirmaciones de precios en el sitio están marcadas como estimaciones basadas en consultas locales.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-amber-500 mt-0.5 shrink-0">&mdash;</span>
                <span><strong>Niveles de personal hospitalario.</strong> Coroico tiene un hospital, pero los datos de personal (número de médicos, especialistas, equipos) no se publican en línea. La página de salud nota esta brecha.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-amber-500 mt-0.5 shrink-0">&mdash;</span>
                <span><strong>Resultados detallados del censo 2024.</strong> Los datos censales detallados más recientes de Bolivia a nivel municipal son de 2012. Las cifras de población actualizadas son estimaciones extrapoladas.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-amber-500 mt-0.5 shrink-0">&mdash;</span>
                <span><strong>Tasa de fracaso de comunidades intencionales.</strong> Ampliamente citado ("la mayoría fracasa en cinco años") pero el estudio primario específico no es fácilmente rastreable. Citamos investigación de FIC con una calificación.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Research Library -->
  <section class="py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="max-w-3xl">
        <h2 class="text-title text-bark-800 mb-6 reveal">Biblioteca de Investigación</h2>
        <p class="text-bark-600 text-[1.05rem] leading-[1.85] mb-8 reveal" data-delay="100">
          Toda la investigación que respalda este sitio es pública. La
          <a href="https://github.com/PT32LAB/PT32LAB.github.io/tree/main/research" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline font-medium">carpeta de investigación en GitHub</a>
          contiene 13 documentos de investigación con 449 enlaces verificados que cubren:
        </p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 reveal" data-delay="200">
          {[
            { title: 'Ubicación y Geografía', desc: 'Clima, terreno, infraestructura, conectividad' },
            { title: 'Economía y Comercio', desc: 'Café, cacao, datos macro de Bolivia, ley cooperativa' },
            { title: 'Seguridad y Riesgo', desc: 'Datos de crimen, peligros naturales, estabilidad política' },
            { title: 'Modelos de Gobernanza', desc: 'Cooperativas, DAOs, ayllu, estudios de caso' },
            { title: 'Tecnología y Energía', desc: 'Potencial solar, fabricación, RepRap, GVCS' },
            { title: 'Salud y Retiro', desc: 'Infraestructura médica, investigación en longevidad, estado legal de medicina vegetal' },
            { title: 'Redes Comunitarias', desc: 'Vecinos, aliados, comunidades afrobolivianas, universidades' },
            { title: 'Contexto de Inversión', desc: 'Programas del Banco Mundial, paquetes del BID, marco regulatorio de Bolivia' },
            { title: 'Análisis de Resiliencia', desc: 'Escenarios de crisis, zonas libres de armas nucleares, independencia de cadena de suministro' },
            { title: 'Diseño y Medios', desc: 'Bibliotecas de imágenes, sistemas de diseño, fuentes de fotografía' },
            { title: 'Auditoría Editorial', desc: 'Revisión completa del contenido del sitio, verificación de consistencia, reescrituras' },
            { title: 'Verificación de Enlaces', desc: '449 enlaces probados y categorizados por estado' },
          ].map(item => (
            <div class="bg-bark-50 border border-bark-200 rounded-lg p-4">
              <h3 class="font-display font-semibold text-bark-800 text-[0.85rem] mb-1">{item.title}</h3>
              <p class="text-[0.8rem] text-bark-500 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

        <a
          href="https://github.com/PT32LAB/PT32LAB.github.io/tree/main/research"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-3 mt-10 px-7 py-4 bg-bark-800 text-bark-50 font-display font-semibold text-sm tracking-wide rounded hover:bg-bark-900 transition-colors duration-300 reveal" data-delay="300"
        >
          Ver Toda la Investigación en GitHub
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Update Log -->
  <section class="bg-bark-100 py-16 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="max-w-3xl">
        <h2 class="font-display font-semibold text-bark-800 text-[1.1rem] mb-4 reveal">Registro de Actualizaciones</h2>
        <div class="space-y-3 text-[0.9rem] text-bark-600 leading-relaxed reveal" data-delay="100">
          <p>
            <strong>Abril 2026</strong> &mdash; Publicación inicial. Todas las afirmaciones verificadas contra las fuentes listadas arriba.
            Revisión de tres pases completada (verificación automatizada de enlaces, verificación manual de hechos, auditoría editorial).
          </p>
          <p class="text-bark-500 text-[0.85rem]">
            Esta página se actualiza cuando las afirmaciones cambian, nuevas fuentes están disponibles o se descubren errores.
            Si encuentra un error, por favor
            <a href="mailto:contact@pt32lab.org" class="text-accent hover:underline">háganos saber</a> o
            <a href="https://github.com/PT32LAB/PT32LAB.github.io/issues" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">abra un issue en GitHub</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6 lg:px-10">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="text-title text-bark-800 reveal">La confianza se construye en público.</h2>
      <p class="text-bark-500 mt-4 reveal" data-delay="100">
        Cada afirmación documentada. Cada limitación revelada. Cada documento de investigación publicado.
        Ese es el estándar al que nos comprometemos.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8 reveal" data-delay="200">
        <a
          href="https://github.com/PT32LAB/PT32LAB.github.io/tree/main/research"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-3 px-7 py-4 bg-bark-800 text-bark-50 font-display font-semibold text-sm tracking-wide rounded hover:bg-bark-900 transition-colors duration-300"
        >
          Ver Investigación
