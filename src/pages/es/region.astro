---
import Landing from '../../layouts/Landing.astro';

const capabilities = [
  { title: 'Proveedores locales', text: 'Materiales de construcción, alimentos, transporte, servicios. BARK compra localmente primero. Cada compra es un voto por la economía regional.' },
  { title: 'Empleo', text: 'Contratación local para construcción, agricultura, hotelería, mantenimiento. BARK es una nómina antes de ser un producto.' },
  { title: 'Acceso a mercados', text: 'La Casa Comercial compra excedentes locales a precios justos y conecta a los productores yungueños con compradores internacionales. Los productores conservan su tierra y su margen.' },
  { title: 'Alianzas con productores', text: 'Relaciones directas con cultivadores de café, coca, cítricos y cacao. Procesamiento compartido, logística compartida, beneficios compartidos.' },
  { title: 'Infraestructura', text: 'Paneles solares, sistemas de agua, comunicaciones en malla — construidos para beneficiar a la zona circundante, no para aislarla.' },
  { title: 'Capacitación', text: 'Programas de formación, alianza con la Universidad Carmen Pampa, transferencia tecnológica. Conocimiento que se queda en el valle.' },
  { title: 'Emprendimientos', text: 'La Incubadora lanza negocios enraizados en necesidades locales — procesamiento, logística, servicios que realmente faltan en la región.' },
];

const notList = [
  { label: 'No es una ZEDE', text: 'Sin zona económica especial. Sin jurisdicción separada. La ley boliviana se aplica plenamente.' },
  { label: 'No es un búnker de expatriados', text: 'La cooperativa requiere liderazgo boliviano por ley (Ley 356 Art. 65). Esto es por diseño.' },
  { label: 'No es extractivista', text: 'Compramos local, procesamos local, vendemos para beneficio local. El valor se queda en los Yungas.' },
  { label: 'No reemplaza medios de vida', text: 'Conector de mercado, no competidor. Los agricultores ganan un comprador, no un rival.' },
];

const partners = [
  { who: 'Productores', how: 'Vender a la Casa Comercial a precios transparentes y de mercado justo. Conservas tu tierra, conservas tu margen.' },
  { who: 'Cooperativas', how: 'Equipamiento de procesamiento compartido, acceso a mercados compartido, logística compartida.' },
  { who: 'Escuelas y Universidad', how: 'Pasantías, investigación de campo, programas de formación con Carmen Pampa. Proyectos estudiantiles con resultados reales.' },
  { who: 'Entes Municipales y Cívicos', how: 'Alineamiento con el programa solar de $325M de Bolivia, el marco legal cooperativo y los objetivos de desarrollo local.' },
  { who: 'Aliados Técnicos', how: 'Ingenieros, agrónomos, constructores, investigadores. Aportan experiencia, acceden a infraestructura compartida.' },
  { who: 'Instituciones Locales', how: 'Postas de salud, operadores de transporte, asociaciones de mercado. BARK se integra con lo que ya funciona.' },
];

const risks = [
  'Acceso vial — la carretera La Paz-Coroico se cierra por deslizamientos. La resiliencia de la cadena de suministro no es opcional.',
  'Salud — instalaciones locales limitadas. El hospital más cercano está en La Paz, a tres horas.',
  'Inestabilidad política — Bolivia tiene ciclos políticos reales. La crisis de 2024 afectó a todo el país.',
  'Burocracia — permisos, inspecciones, procesos legales avanzan a su propio ritmo. La paciencia es un requisito estructural.',
  'Crisis económica — presión cambiaria, inflación, agotamiento de reservas. Planificamos para esto, no alrededor de esto.',
  'La legitimidad local se gana — ninguna cantidad de inversión sustituye la confianza. Eso requiere presencia, tiempo y cumplimiento.',
];
---

<Landing title="Región" description="BARK existe para aumentar la capacidad de Coroico, no para construir muros alrededor de un recinto. Integración regional, no enclave." heroImage="/images/yungas/tocana-landscape.jpg">

  <!-- Hero con foto de tocana-landscape -->
  <section class="relative min-h-[70vh] flex items-end overflow-hidden">
    <img src="/images/yungas/tocana-landscape.jpg" alt="Paisaje de Tocaña, valle yungueño debajo de Coroico" width="1920" height="1440" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-t from-bark-900/90 via-bark-900/50 to-transparent"></div>
    <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-10 pb-16 w-full">
      <span class="text-label text-accent reveal">Integración Regional</span>
      <h1 class="text-display text-bark-50 mt-4 max-w-3xl reveal" data-delay="100">Región, No Enclave</h1>
      <p class="text-body-lg text-bark-200 mt-6 max-w-2xl reveal" data-delay="150">
        BARK se construye en los Yungas para aumentar la capacidad local, no para retirarse de la región que lo hace posible.
      </p>
      <p class="text-body-lg text-bark-300 mt-4 max-w-2xl reveal" data-delay="200">
        El proyecto solo tiene legitimidad si contribuye al territorio circundante: productores, proveedores, capacitación, infraestructura y nuevas formas de vida económica regional.
      </p>
    </div>
  </section>

  <!-- Lo Que BARK Significa para Este Lugar -->
  <section class="section-gap px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto">
      <span class="text-label text-bark-500 reveal">Lo Que BARK Significa para Este Lugar</span>
      <h2 class="text-headline text-bark-800 mt-4 mb-10 reveal" data-delay="100">
        Capacidad, no encierro
      </h2>
      <div class="space-y-4">
        {capabilities.map((c, i) => (
          <div class="flex items-start gap-4 py-5 border-b border-bark-200 last:border-b-0 reveal" data-delay={String(i * 80)}>
            <span class="text-label text-accent shrink-0 w-8 pt-1">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-display font-semibold text-bark-800">{c.title}</h3>
              <p class="text-bark-500 mt-1">{c.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Por Qué Coroico / Yungas -->
  <section class="section-gap bg-bark-100 px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <span class="text-label text-bark-500">Por Qué Aquí</span>
        <h2 class="text-title text-bark-800 mt-4 mb-6">Coroico y los Yungas</h2>
        <p class="text-bark-600 text-[1.05rem] leading-[1.8]">
          1.750 metros. Temporada de cultivo durante todo el año. A tres horas de La Paz por
          un solo camino que funciona como línea de vida y cuello de botella a la vez. Biodiversidad
          extraordinaria a lo largo de franjas altitudinales. Una tradición cooperativa existente
          a través de CENAPROC y la red agrícola yungueña. La Universidad Carmen Pampa
          al alcance para investigación y formación. La infraestructura de ayuda mutua
          ya existe aquí &mdash; BARK se conecta a ella, no la reemplaza.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="100">
        <div class="bg-bark-50 p-6 text-center">
          <p class="font-display font-bold text-bark-800 text-2xl">1.750m</p>
          <p class="text-label text-bark-400 mt-1 text-[0.6rem]">Altitud</p>
        </div>
        <div class="bg-bark-50 p-6 text-center">
          <p class="font-display font-bold text-bark-800 text-2xl">12 meses</p>
          <p class="text-label text-bark-400 mt-1 text-[0.6rem]">Temporada de cultivo</p>
        </div>
        <div class="bg-bark-50 p-6 text-center">
          <p class="font-display font-bold text-bark-800 text-2xl">3h</p>
          <p class="text-label text-bark-400 mt-1 text-[0.6rem]">Desde La Paz</p>
        </div>
        <div class="bg-bark-50 p-6 text-center">
          <p class="font-display font-bold text-accent text-2xl">Co-op</p>
          <p class="text-label text-bark-400 mt-1 text-[0.6rem]">Tradición (CENAPROC)</p>
        </div>
        <div class="bg-bark-50 p-6 text-center">
          <p class="font-display font-bold text-bark-800 text-2xl">Alta</p>
          <p class="text-label text-bark-400 mt-1 text-[0.6rem]">Biodiversidad</p>
        </div>
        <div class="bg-bark-50 p-6 text-center">
          <p class="font-display font-bold text-bark-800 text-2xl">UCB</p>
          <p class="text-label text-bark-400 mt-1 text-[0.6rem]">Carmen Pampa cercana</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Modelo de Desarrollo Regional -->
  <section class="section-gap px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto">
      <span class="text-label text-bark-500 reveal">Modelo de Desarrollo Regional</span>
      <h2 class="text-title text-bark-800 mt-4 mb-4 reveal" data-delay="100">
        Cómo se conecta el ecosistema
      </h2>
      <p class="text-bark-600 mb-10 max-w-2xl reveal" data-delay="150">
        BARK es un nodo en una red regional. El valor fluye hacia afuera — hacia productores,
        cooperativas, la universidad, proveedores locales, y eventualmente hacia nuevos
        emprendimientos y mercados que antes no existían.
      </p>

      <!-- Diagrama del ecosistema: anillos concéntricos -->
      <div class="relative max-w-[700px] mx-auto reveal" data-delay="200">
        <svg viewBox="0 0 700 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto" role="img" aria-label="Diagrama del ecosistema regional mostrando a BARK en el centro conectado con agricultores, cooperativas, universidad, proveedores, emprendimientos, mercados y visitantes">
          <!-- Anillo exterior -->
          <ellipse cx="350" cy="210" rx="330" ry="190" stroke="#e4ded6" stroke-width="1.5" stroke-dasharray="6 4" />
          <!-- Anillo medio -->
          <ellipse cx="350" cy="210" rx="220" ry="130" stroke="#c9bfb2" stroke-width="1.5" />
          <!-- Anillo interior -->
          <ellipse cx="350" cy="210" rx="80" ry="50" fill="#10b981" fill-opacity="0.1" stroke="#10b981" stroke-width="2" />
          <!-- Etiqueta central -->
          <text x="350" y="206" text-anchor="middle" font-family="Libre Franklin, system-ui, sans-serif" font-weight="700" font-size="16" fill="#1a1610">BARK</text>
          <text x="350" y="224" text-anchor="middle" font-family="Libre Franklin, system-ui, sans-serif" font-weight="400" font-size="10" fill="#8a7a66">eje cooperativo</text>

          <!-- Nodos del anillo medio -->
          <circle cx="170" cy="140" r="6" fill="#10b981" />
          <text x="170" y="125" text-anchor="middle" font-family="Libre Franklin, system-ui, sans-serif" font-weight="600" font-size="12" fill="#2d261e">Agricultores</text>

          <circle cx="530" cy="140" r="6" fill="#10b981" />
          <text x="530" y="125" text-anchor="middle" font-family="Libre Franklin, system-ui, sans-serif" font-weight="600" font-size="12" fill="#2d261e">Cooperativas</text>

          <circle cx="170" cy="280" r="6" fill="#10b981" />
          <text x="170" y="300" text-anchor="middle" font-family="Libre Franklin, system-ui, sans-serif" font-weight="600" font-size="12" fill="#2d261e">Universidad</text>

          <circle cx="530" cy="280" r="6" fill="#10b981" />
          <text x="530" y="300" text-anchor="middle" font-family="Libre Franklin, system-ui, sans-serif" font-weight="600" font-size="12" fill="#2d261e">Proveedores</text>

          <circle cx="350" cy="90" r="6" fill="#10b981" />
          <text x="350" y="75" text-anchor="middle" font-family="Libre Franklin, system-ui, sans-serif" font-weight="600" font-size="12" fill="#2d261e">Emprendimientos</text>

          <!-- Nodos del anillo exterior -->
          <circle cx="80" cy="210" r="5" fill="#d4a853" />
          <text x="42" y="214" text-anchor="middle" font-family="Libre Franklin, system-ui, sans-serif" font-weight="500" font-size="11" fill="#6b5d4d">Mercados</text>

          <circle cx="620" cy="210" r="5" fill="#d4a853" />
          <text x="660" y="214" text-anchor="middle" font-family="Libre Franklin, system-ui, sans-serif" font-weight="500" font-size="11" fill="#6b5d4d">Visitantes</text>

          <circle cx="350" cy="350" r="5" fill="#d4a853" />
          <text x="350" y="372" text-anchor="middle" font-family="Libre Franklin, system-ui, sans-serif" font-weight="500" font-size="11" fill="#6b5d4d">Talento</text>

          <!-- Líneas de conexión del centro al anillo medio -->
          <line x1="280" y1="195" x2="176" y2="146" stroke="#10b981" stroke-width="1" stroke-opacity="0.4" />
          <line x1="420" y1="195" x2="524" y2="146" stroke="#10b981" stroke-width="1" stroke-opacity="0.4" />
          <line x1="280" y1="225" x2="176" y2="274" stroke="#10b981" stroke-width="1" stroke-opacity="0.4" />
          <line x1="420" y1="225" x2="524" y2="274" stroke="#10b981" stroke-width="1" stroke-opacity="0.4" />
          <line x1="350" y1="162" x2="350" y2="96" stroke="#10b981" stroke-width="1" stroke-opacity="0.4" />

          <!-- Líneas de conexión del anillo medio al exterior -->
          <line x1="164" y1="140" x2="85" y2="210" stroke="#d4a853" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="4 3" />
          <line x1="536" y1="140" x2="615" y2="210" stroke="#d4a853" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="4 3" />
          <line x1="170" y1="286" x2="344" y2="345" stroke="#d4a853" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="4 3" />
          <line x1="530" y1="286" x2="356" y2="345" stroke="#d4a853" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="4 3" />
          <line x1="350" y1="84" x2="85" y2="205" stroke="#d4a853" stroke-width="1" stroke-opacity="0.2" stroke-dasharray="4 3" />
        </svg>
        <p class="text-center text-bark-400 text-xs mt-4 font-display tracking-wide uppercase">Anillo interior: socios directos &middot; Anillo exterior: alcance indirecto</p>
      </div>
    </div>
  </section>

  <!-- Lo Que BARK NO Es — sección oscura -->
  <section class="section-gap bg-bark-900 text-bark-300 px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto">
      <span class="text-label text-accent reveal">Lo Que BARK No Es</span>
      <h2 class="text-headline text-bark-50 mt-4 mb-10 reveal" data-delay="100">
        Sin enclaves. Sin excepciones.
      </h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {notList.map((item, i) => (
          <div class="card-dark p-6 rounded-xl border border-white/8 reveal" data-delay={String(i * 100)}>
            <h3 class="font-display font-semibold text-bark-50 mb-2">{item.label}</h3>
            <p class="text-bark-400 text-[0.95rem] leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Vías de Alianza -->
  <section class="section-gap px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto">
      <span class="text-label text-bark-500 reveal">Vías de Alianza</span>
      <h2 class="text-title text-bark-800 mt-4 mb-10 reveal" data-delay="100">
        Cómo funciona la relación
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {partners.map((p, i) => (
          <div class="card reveal" data-delay={String(i * 80)}>
            <span class="tag tag-accent mb-3">{p.who}</span>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed">{p.how}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="divider-accent max-w-[900px] mx-auto"></div>

  <!-- Riesgos Que Reconocemos -->
  <section class="section-gap px-6 lg:px-10">
    <div class="content-width">
      <span class="text-label text-bark-500 reveal">Riesgos Que Reconocemos</span>
      <h2 class="text-title text-bark-800 mt-4 mb-8 reveal" data-delay="100">
        Honestos sobre las partes difíciles
      </h2>
      <div class="space-y-4">
        {risks.map((r, i) => (
          <div class="flex items-start gap-3 reveal" data-delay={String(i * 80)}>
            <span class="shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full bg-ember"></span>
            <p class="text-bark-600 text-[1rem] leading-relaxed">{r}</p>
          </div>
        ))}
      </div>
      <p class="text-bark-500 mt-8 reveal" data-delay="400">
        Hemos investigado esto con honestidad.
        <a href="/es/risks" class="link-arrow inline-flex">
          Leer nuestra evaluación completa de riesgos
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-gap-lg bg-bark-100 px-6 lg:px-10">
    <div class="content-width text-center">
      <h2 class="text-headline text-bark-800 mb-6 reveal">
        Hablemos de lo que esto significa para tu comunidad.
      </h2>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
        <a href="mailto:pt32lab@proton.me?subject=Consulta%20de%20alianza%20regional" class="inline-flex items-center gap-3 px-8 py-4 bg-accent text-white font-display font-semibold text-sm tracking-wide rounded-full hover:bg-accent-dim transition-colors duration-300 reveal" data-delay="100">
          Aliarse con BARK
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="/es/economy" class="link-arrow reveal" data-delay="200">
          Ver la Economía Regional
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

</Landing>
