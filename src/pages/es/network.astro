---
import Base from '../../layouts/Base.astro';

const localNeighbors = [
  {
    name: 'Afro-Bolivian Communities',
    location: 'Tocana, Mururata, Chijchipa — Nor Yungas',
    desc: 'The cultural heart of Nor Yungas. Descendants of enslaved Africans brought to work in colonial mines and haciendas. Keepers of the saya music tradition — drum-driven call-and-response that is now recognized as Bolivian national cultural heritage. An estimated 15,000–25,000 Afro-Bolivians nationally, concentrated in this area.',
    lesson: 'BARK\'s immediate neighbors. Any community project in Nor Yungas that ignores Afro-Bolivian history, culture, and land rights is building on a lie. Collaboration must be genuine, not performative.',
  },
  {
    name: 'CENAPROC',
    location: 'Yungas, Bolivia',
    desc: 'An award-winning organic coffee cooperative operating in the Yungas. Demonstrates that cooperative agricultural enterprises — the exact model BARK\'s Trading House proposes — already work in this specific region with these specific crops.',
    lesson: 'Proof of concept for cooperative agriculture in the Yungas. CENAPROC\'s existence means BARK doesn\'t need to theorize about whether coffee cooperatives work here — they already do.',
  },
  {
    name: 'Carmen Pampa University',
    location: '12 km from Coroico (Unidad Académica Campesina)',
    url: 'https://www.uac-carmenpampa.edu.bo/',
    desc: 'A rural university offering degrees in agronomy, veterinary science, nursing, education, and ecotourism. Located just 12 km from Coroico, it is a major local institution training the next generation of Yungas professionals.',
    lesson: 'A major asset for BARK. Students and faculty in agronomy and ecotourism are natural collaborators. Internship programs, joint research, shared facilities — the partnership opportunities are obvious.',
  },
  {
    name: 'La Senda Verde',
    location: 'Yungas, Bolivia',
    url: 'https://www.sendaverde.com/',
    desc: 'A wildlife refuge and ecotourism resort operating in the Yungas since 2003. Rescues and rehabilitates wild animals while running a sustainable tourism operation. Over 20 years of continuous operation.',
    lesson: 'Demonstrates that conservation-based enterprises work in the Yungas. Their ecotourism model proves that visitors will travel to this region for nature-based experiences — relevant to BARK\'s retreat center plans.',
  },
  {
    name: 'Irupana Municipality',
    location: 'Sud Yungas, Bolivia',
    desc: 'Neighboring Yungas municipality that has achieved organic certification for its agricultural production. Shows that organic certification — a key component of BARK\'s agricultural strategy — is achievable in this region through existing Bolivian regulatory frameworks.',
    lesson: 'Regulatory proof that organic certification works in the Yungas. Irupana\'s example removes one more "but can it work here?" objection from the list.',
  },
];

const globalProjects = [
  {
    name: 'Auroville',
    location: 'Tamil Nadu, India',
    url: 'https://auroville.org/',
    desc: 'Founded in 1968, Auroville is a UNESCO-endorsed experimental township of over 3,000 residents from 60+ countries. The largest and longest-running intentional community experiment in the world.',
    lesson: 'Scale is possible but creates governance complexity. Auroville\'s struggles with Indian government relations and internal decision-making at scale are essential case studies for BARK\'s long-term planning.',
  },
  {
    name: 'Tamera',
    location: 'Alentejo, Portugal',
    url: 'https://www.tamera.org/',
    desc: 'A "peace research village" of ~170 residents focused on solar technology, water retention landscapes, permaculture, and community healing. Strong technical infrastructure program.',
    lesson: 'Water retention landscapes and solar village concepts directly applicable to Yungas terrain. Tamera\'s approach to combining technology with community healing mirrors BARK\'s techno park + retreat model.',
  },
  {
    name: 'Hackerfarm',
    location: 'Chiba Prefecture, Japan',
    url: 'https://freaklabs.org/',
    desc: 'A rural hackerspace combining traditional Japanese farming with IoT sensors, open-source hardware, and maker culture. Proves that high-tech and rural agriculture can coexist productively.',
    lesson: 'Tech-agriculture integration in a rural setting. Hackerfarm\'s sensor networks, automated growing systems, and maker-farmer community model is exactly what BARK\'s techno park aims to build.',
  },
  {
    name: 'Earthship Biotecture',
    location: 'Taos, New Mexico, USA',
    url: 'https://earthship.com/',
    desc: 'Pioneered radically self-sufficient building designs using recycled materials, passive solar heating/cooling, rainwater harvesting, and integrated food production. Buildings that need no external utilities.',
    lesson: 'Thermal mass and passive design principles adaptable to Yungas climate. Earthship water harvesting and greywater treatment systems are directly buildable with local materials.',
  },
  {
    name: 'Huehuecoyotl',
    location: 'Tepoztlan, Mexico',
    desc: 'One of Latin America\'s oldest ecovillages (founded 1982). A multi-generational community that has survived decades of political change, economic crises, and internal governance challenges.',
    lesson: '40+ years of survival data. Huehuecoyotl proves that intentional communities in Latin America can endure across generations — but only with adaptive governance and deep local roots.',
  },
];

const developmentPartners = [
  {
    name: 'Practical Action Bolivia',
    what: 'Appropriate technology for rural communities. Regenerative agriculture and climate resilience in Bolivia. Reached 29,000 people in 2023. 365% productivity boost through renewable energy for 4,300 farmers.',
    why: 'Already in Bolivia with a La Paz office (Presbitero Medina St. 2922, Sopocachi). Reached 29,000 people in 2023. Their mission is literally appropriate technology for rural communities — regenerative agriculture, renewable energy, climate resilience. Funded by GIZ, Swiss SDC, Z Zurich Foundation.',
    url: 'https://practicalaction.org/where-we-work/latin-america/bolivia/',
  },
  {
    name: 'GIZ Bolivia',
    what: 'German development cooperation in Bolivia since 1962. Water, sanitation, irrigation, vocational training, and climate adaptation. Over 2 million Bolivians benefited from improved water systems.',
    why: 'Their water, sanitation, and irrigation programs directly match BARK\'s infrastructure needs. Their vocational training model aligns with BARK\'s education vision. Already a funding partner of Practical Action in Bolivia.',
    url: 'https://www.giz.de/en/regions/latin-america-caribbean/bolivia',
  },
  {
    name: 'Engineers Without Borders',
    what: 'Student engineering teams delivering infrastructure projects. Active Bolivia projects in 2025-2026: irrigation systems, water distribution, eco-latrines, and community sanitation across multiple university chapters.',
    why: '5 active Bolivia projects in 2025-2026 (Auburn, Kansas, Missouri S&T, UC Davis, Pittsburgh). EWB chapters need projects. BARK offers a permanent year-round site with recurring infrastructure challenges — solving EWB\'s common problem of one-visit projects with no maintenance.',
    url: 'https://www.ewb-usa.org/',
  },
  {
    name: 'Habitat for Humanity Bolivia',
    what: 'Operating in Bolivia since 1985. Housing, WASH (water, sanitation, hygiene), women\'s land rights, and community development from offices in Cochabamba, La Paz, and Santa Cruz.',
    why: 'BARK\'s open-source, locally-sourced construction methods align with Habitat\'s self-construction model. BARK could serve as a training center for construction techniques adaptable across Bolivia.',
    url: 'https://www.habitat.org/where-we-build/bolivia',
  },
  {
    name: 'Solar Energy International',
    what: 'Professional solar PV installation training. Trained over 9,000 Spanish speakers since 2013. Recently opened first International Solar Training Center in Costa Rica.',
    why: 'BARK plans solar infrastructure as a core component. SEI needs demonstration sites in South America. Bolivia\'s major rural electrification program creates demand for trained installers.',
    url: 'https://www.solarenergy.org/',
  },
];

const academicPartners = [
  {
    name: 'Carmen Pampa University (UAC-CP)',
    what: '12 km from Coroico. Programs in agronomy, veterinary science, nursing, education, and ecotourism. Pre-university program, food cooperative, research projects.',
    why: 'Just 12 km from Coroico with degrees in agronomy, ecotourism, and veterinary science — a natural training partner. Students need practicum sites and thesis projects. They actively seek international partnerships after losing USAID funding in 2013. Cited by a UN committee as "one of the leading examples of how best to eradicate poverty."',
    url: 'https://carmenpampafund.org/',
  },
  {
    name: 'UMSA (Universidad Mayor de San Andres)',
    what: 'Bolivia\'s leading public university in La Paz (2-3 hours from Coroico). 13 faculties, 56 research institutes. Active collaboration with FiBL on the 15-year cocoa agroforestry research project.',
    why: 'UMSA researchers need field sites in the Yungas where they already have research interests. BARK could host research students and faculty. La Paz proximity makes regular visits feasible.',
    url: 'https://www.umsa.bo/en/home',
  },
  {
    name: 'International Research Programs',
    what: 'Princeton (Yungas excursions), University of Oregon (indigenous rights research), Missouri Botanical Garden (50 permanent plots in Yungas since 2002), FiBL (15-year cocoa farming trial), Belgian universities (traditional ecological knowledge).',
    why: 'BARK\'s unique position as a community-scale intervention in the Yungas makes it valuable to multiple research disciplines. Joint research agreements strengthen both academic credibility and funding prospects.',
  },
];

const techPartners = [
  {
    name: 'Open Source Ecology',
    what: 'Developing the Global Village Construction Set — 50 open-source industrial machines needed to build a small civilization. All designs under GNU GPL. Compressed earth brick press, tractor, 3D printer, and more.',
    why: 'BARK is literally the use case OSE was designed for. A Yungas deployment would be their most significant international implementation. Real-world testing in tropical conditions.',
    url: 'https://www.opensourceecology.org/',
  },
  {
    name: 'Fab Foundation',
    what: '2,500+ Fab Labs worldwide. 6 Fab Labs already in Bolivia: Cochabamba, Santa Cruz (3), Oruro, and Santa Cruz. Part of Fab Lat, the Latin American network covering 10 countries.',
    why: '6 Fab Labs already in Bolivia (Cochabamba, Santa Cruz x3, Oruro, Santa Cruz). A Fab Lab at BARK extends the Fab Lat network into the Yungas — a unique jungle/semi-autonomous fabrication lab. The Foundation actively supports new lab creation with training and network access.',
    url: 'https://fabfoundation.org/',
  },
  {
    name: 'Precious Plastic',
    what: 'Open-source recycling machine designs and 80,000-strong global community. Machines built from low-cost components. Growing presence in Chile, Brazil, and Argentina. No confirmed operation in Bolivia yet.',
    why: 'BARK could become Bolivia\'s first Precious Plastic Community Point. The open-source ethos is identical. Plastic waste is a growing problem in Bolivian rural communities.',
    url: 'https://www.preciousplastic.com/',
  },
  {
    name: 'RepRap Community',
    what: 'Open-source self-replicating 3D printer. Materials cost approximately EUR 350. Licensed under GNU GPL. Designed to democratize manufacturing for communities in the developing world.',
    why: '3D printing enables production of spare parts, tools, and components without supply chain dependency. BARK\'s vision of local manufacturing from open-source designs is the RepRap philosophy at community scale.',
    url: 'https://reprap.org/',
  },
];

const networkOrgs = [
  {
    name: 'CASA Latina',
    what: '100+ sustainable settlements across Latin America. Part of the Global Ecovillage Network. Includes traditional communities, indigenous territories, and urban regenerative projects — not just ecovillages.',
    why: 'Membership gives BARK access to a network of 100+ similar communities, shared knowledge, and collective advocacy. BARK fills an underrepresented area (Bolivia) with a tech-integrated model.',
    url: 'https://ecovillage.org/region/casa/',
  },
  {
    name: 'Cooperatives of the Americas',
    what: 'ICA regional office in San Jose, Costa Rica. Promoting cooperative development across the Americas. Bolivia has 15,000 active cooperatives, a tradition rooted in ancestral Andean practices of ayni and ayllu.',
    why: 'BARK as a tech-integrated cooperative provides a modern model that ICA could promote. The combination of traditional Andean cooperative values with open-source technology is compelling for their network.',
    url: 'https://aciamericas.coop/en/',
  },
  {
    name: 'Transition Towns Network',
    what: '1,000+ communities worldwide building local resilience. Tools for local food systems, community energy, economic localization. "Great Reskilling" workshops and local currency experiments.',
    why: 'Tested tools for community resilience building directly applicable to BARK. Their methodology and community organizing frameworks accelerate what BARK is trying to build.',
    url: 'https://transitionnetwork.org/',
  },
  {
    name: 'Fab City Network',
    what: '40+ cities worldwide committed to producing everything they consume by 2054. Built on the Fab Lab model of distributed digital fabrication and the principle that cities should share knowledge globally while producing locally.',
    why: 'The "globally connected, locally productive" model is BARK\'s techno park philosophy at city scale. Fab City membership gives access to design files, training, and a global fabrication community.',
    url: 'https://fab.city/',
  },
  {
    name: 'Savory Institute',
    what: 'Global regenerative agriculture network promoting holistic land management. Hub network model connecting local practitioners to a global knowledge base.',
    why: 'Regenerative agriculture methods for BARK\'s food systems. Their hub network model mirrors BARK\'s open-source philosophy — local practice, global knowledge sharing.',
    url: 'https://savory.global/',
  },
];

const governmentPrograms = [
  {
    name: '$325M Rural Solar Electrification',
    source: 'Government of Bolivia + IDB + World Bank + Green Climate Fund',
    detail: 'Targeting 140,000 rural families with solar panel systems on homes, schools, and health centers. 25,000+ households, 500 educational units, 50 health centers across 110 communities in 35 municipalities. World Bank approved $125M component (November 2023). Nordic Development Fund approved EUR 4M for hybrid renewable systems replacing diesel. Target: universal electricity access by 2030.',
    barkAlign: 'BARK could qualify as a demonstration site and training center for solar installation and maintenance — skills needed across all 140,000 target families. More strategically, BARK could become Bolivia\'s first community-scale solar micro-grid training facility.',
    sourceUrl: 'https://www.worldbank.org/en/news/press-release/2023/11/16/the-world-bank-will-help-increase-and-improve-access-to-sustainable-electric-power-in-rural-communities-of-bolivia',
  },
  {
    name: 'IDB $4.5 Billion Development Package',
    source: 'Inter-American Development Bank (2026-2028)',
    detail: 'Agreed under Bolivia\'s pro-market government pivot. Covers infrastructure, agriculture, tourism, and innovation. Includes $500M for social protection and direct state assistance to vulnerable families. Separate $10M sustainable tourism loan (40-year term, 10-year grace period, 1% interest during grace, 2% thereafter). Also includes a Land Management Program for Sustainable Rural Development with ongoing procurement.',
    barkAlign: 'BARK\'s multi-sector approach — agriculture, tourism, technology, community development — aligns directly with the IDB package\'s scope. The tourism loan specifically targets community-based tourism near protected sites, which describes BARK\'s retreat center.',
    sourceUrl: 'https://www.iadb.org/en/who-we-are/country-offices/bolivia',
  },
  {
    name: 'Ley 356 Cooperative Framework',
    source: 'Government of Bolivia (2013)',
    detail: 'Bolivia\'s cooperative law replaced the 1958 framework. The Constitution recognizes cooperatives in 12 articles and promotes cooperative participation. AFCOOP (Autoridad de Fiscalizacion y Control de Cooperativas) regulates 15,000 active cooperatives. Minimum requirements: non-profit association, democratic structure, registration within 90 days of formation via AFCOOP.',
    barkAlign: 'BARK\'s legal structure. The cooperative model gives BARK legal personality, constitutional recognition, and alignment with Bolivia\'s 15,000 existing cooperatives. The tradition is rooted in ancestral Andean practices of ayni (reciprocity) and ayllu (community production) — BARK inherits, not invents, this model.',
    sourceUrl: 'https://bolivia.infoleyes.com/norma/4397/ley-general-de-cooperativas-356',
  },
  {
    name: 'INIAF Agricultural Development',
    source: 'Instituto Nacional de Innovacion Agropecuaria y Forestal',
    detail: 'Government coffee and cacao improvement programs targeting the Yungas specifically. Genetic improvement of coffee varieties (e.g., climate-resilient CSP-COIPSA-01). Over 9,000 smallholder cacao families across five departments producing ~2,265 tons/year. Goal: increase incomes 40% for 3,500 producers. Government investing in post-harvest infrastructure and certification (Fair Trade, Rainforest Alliance).',
    barkAlign: 'BARK\'s planned coffee and cacao processing lines directly align with INIAF\'s mission. Could serve as a demonstration farm for improved varieties, host INIAF extension services, and provide post-harvest processing infrastructure that smallholders currently lack.',
    sourceUrl: 'https://www.catie.ac.cr/en/2024/05/15/iniaf-bolivia-reconoce-a-rolando-cerda-por-su-contribucion-al-desarrollo-agricola-sostenible/',
  },
  {
    name: 'Tourism Development ($10M IDB Loan)',
    source: 'Inter-American Development Bank',
    detail: 'Soft loan for strategic actions in sustainable tourism: certification, regulation, demonstration projects, promotion. 40-year term, 10-year grace period, 1% interest during grace period, 2% thereafter. Local counterpart: $2.5M. Explicitly encourages low-income residents near protected sites to participate in tourism and conservation through training, employment, and entrepreneurship.',
    barkAlign: 'Coroico is already a major tourist destination. BARK\'s retreat center and ecotourism components directly qualify under this program. The loan specifically targets community-based tourism near protected sites — BARK is adjacent to ANMI Cotapata.',
    sourceUrl: 'https://www.iadb.org/en/news/idb-approves-10-million-support-tourism-bolivia',
  },
  {
    name: 'Banco de Desarrollo Productivo (BDP-SAM)',
    source: 'National Development Bank of Bolivia',
    detail: '80:20 government-private ownership. Direct lending to micro, small, and medium producers since 2015, including regions where traditional banking doesn\'t reach. Sectors: agriculture, forestry, manufacturing. Combines financing with technical assistance. Accredited as the Green Climate Fund Direct Access Entity for Bolivia — can channel GCF resources directly.',
    barkAlign: 'BDP could finance BARK\'s productive components (coffee processing, cacao, solar services). Their combination of lending plus technical assistance matches BARK\'s needs. Their GCF accreditation means they can channel international climate finance to qualifying projects.',
    sourceUrl: 'https://www.greenclimate.fund/ae/bdp-sam',
  },
  {
    name: 'SERNAP Protected Areas System',
    source: 'Servicio Nacional de Areas Protegidas',
    detail: '22 National Protected Areas, 25 Departmental, 83 Municipal — approximately 25% of Bolivia\'s territory under protection. Adjacent to Coroico: Puerta Amazonica (105,392 acres of tropical Yungas forests), ANMI Cotapata (40,000-hectare managed conservation area). Chuuuma conservation area protects mountain ranges that are sources of approximately 19 rivers.',
    barkAlign: 'BARK\'s proximity to protected areas means land management practices directly affect conservation outcomes. Demonstrating biodiversity-compatible agriculture strengthens BARK\'s position with government and conservation funders. Alignment with SERNAP mandates opens access to conservation-linked funding.',
    sourceUrl: 'https://bolivia.wcs.org/en-us/Global-Initiatives/Protected-area-management.aspx',
  },
  {
    name: 'Green Climate Fund (5 Active Projects)',
    source: 'GCF via multiple implementing entities',
    detail: 'Five active GCF-funded projects in Bolivia: FP284 Amazonia Viva Program (World Bank), FP261 Water Security in the Amazon Basin, FP230 Kuali Fund, FP202 Ecosystem-Based Climate Resilience in Valles Macro-region (FAO), FP173 Amazon Bioeconomy Fund (IDB Invest — "unlocking private capital by valuing bioeconomy products"). National Designated Authority: Ministry of Development Planning and Environment. GIZ readiness project approved April 2025 for national adaptation planning.',
    barkAlign: 'Climate adaptation funding is available through BDP-SAM (Direct Access Entity). BARK\'s renewable energy, water systems, and agroforestry components qualify under multiple GCF priority areas. The Amazon Bioeconomy Fund specifically targets private capital for bioeconomy products — this includes specialty coffee and cacao.',
    sourceUrl: 'https://www.greenclimate.fund/countries/bolivia',
  },
];
---

<Base title="Network & Potential Allies" description="Allies, partners, and government programs aligned with BARK's mission." heroImage="/images/yungas/market.jpg">
  <!-- Hero -->
  <section class="relative min-h-[40vh] flex items-end pb-12 overflow-hidden">
    <img src="/images/yungas/market.jpg" alt="Yungas market scene" width="1920" height="1080" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/20"></div>
    <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-10 w-full">
      <span class="text-label text-accent">Network</span>
      <h1 class="text-headline text-white mt-2">Network & Potential Allies</h1>
      <p class="text-body-lg text-bark-200 mt-2 max-w-2xl">
        BARK doesn't exist in a vacuum. These are the neighbors, partners, organizations, and
        government programs whose work intersects with ours.
      </p>
    </div>
  </section>

  <!-- ============================================
       LOCAL NEIGHBORS
       ============================================ -->

  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Our Actual Neighbors</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        Before looking at the global map, BARK needs to know its own neighborhood. These are the communities,
        institutions, and organizations already operating in and around the Yungas.
      </p>

      <div class="photo-frame h-56 md:h-72 mb-10 reveal" data-delay="150">
        <img src="/images/yungas/market.jpg" alt="Yungas market scene" width="1920" height="1080" loading="lazy" decoding="async" />
        <div class="photo-credit">A Yungas market -- where relationships are built</div>
      </div>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {localNeighbors.map(p => (
          <div class="bg-bark-50 p-10">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h3 class="font-display font-semibold text-bark-800 text-lg">{p.name}</h3>
                <span class="text-label text-bark-400 text-[0.65rem]">{p.location}</span>
              </div>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
            </div>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed mb-4">{p.desc}</p>
            <div class="border-t border-bark-200 pt-4 mt-auto">
              <span class="text-label text-accent text-[0.6rem]">What BARK learns</span>
              <p class="text-bark-500 text-sm leading-relaxed mt-1">{p.lesson}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo break between local neighbors and global allies -->
  <div class="photo-frame h-56 md:h-72 my-12 reveal" style="border-radius:0;">
    <img src="/images/yungas/market.jpg" alt="A Yungas market scene — where relationships are built" width="1920" height="1080" loading="lazy" decoding="async" class="w-full h-full object-cover" />
  </div>

  <!-- ============================================
       GLOBAL ALLIES
       ============================================ -->

  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Global Allies</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        Established projects worldwide that have blazed trails in technology, governance, and community building.
      </p>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {globalProjects.map(p => (
          <div class="bg-bark-50 p-10">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h3 class="font-display font-semibold text-bark-800 text-lg">{p.name}</h3>
                <span class="text-label text-bark-400 text-[0.65rem]">{p.location}</span>
              </div>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
            </div>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed mb-4">{p.desc}</p>
            <div class="border-t border-bark-200 pt-4 mt-auto">
              <span class="text-label text-accent text-[0.6rem]">What BARK learns</span>
              <p class="text-bark-500 text-sm leading-relaxed mt-1">{p.lesson}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       PARTNER ORGANIZATIONS
       ============================================ -->

  <!-- Development Partners -->
  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Development Partners</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        NGOs and development organizations already active in Bolivia whose programs directly
        overlap with BARK's infrastructure and community development needs.
      </p>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {developmentPartners.map(p => (
          <div class="bg-bark-50 p-10">
            <div class="flex items-start justify-between gap-4 mb-4">
              <h3 class="font-display font-semibold text-bark-800 text-lg">{p.name}</h3>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
            </div>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed mb-4">{p.what}</p>
            <div class="border-t border-bark-200 pt-4">
              <span class="text-label text-accent text-[0.6rem]">Why partner with BARK</span>
              <p class="text-bark-500 text-sm leading-relaxed mt-1">{p.why}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Academic Partners -->
  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Academic Partners</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        Universities and research programs with direct relevance to BARK's location and mission.
      </p>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {academicPartners.map(p => (
          <div class="bg-bark-50 p-10">
            <div class="flex items-start justify-between gap-4 mb-4">
              <h3 class="font-display font-semibold text-bark-800 text-lg">{p.name}</h3>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
