---
import Landing from '../../layouts/Landing.astro';

const systems = [
  { num: '01', title: 'Energía', problem: 'Red eléctrica poco fiable, radiación UV de gran altitud, nubosidad en temporada de lluvias.', build: 'Paneles solares, microturbinas hidráulicas, almacenamiento en baterías, conexión a la red.', why: 'La independencia energética es la base — nada funciona sin ella.' },
  { num: '02', title: 'Agua', problem: 'Sin tratamiento municipal, variación estacional, escorrentía en terreno empinado.', build: 'Captación de manantiales, filtración cerámica y de bioarena, reciclaje de aguas grises, cosecha de lluvia.', why: '1.300 mm/año de lluvia son un recurso si se puede captar, purificar y almacenar.' },
  { num: '03', title: 'Comunicaciones', problem: 'Sin fibra óptica, sin torres celulares en muchos valles, punto único de fallo.', build: 'Starlink como enlace principal, malla LoRa para telemetría del sitio, radio HF de respaldo, servidores locales.', why: 'La conectividad habilita el trabajo remoto, la telemedicina y el acceso a mercados.' },
  { num: '04', title: 'Fabricación', problem: 'Los repuestos tardan semanas. El proveedor industrial más cercano está en La Paz.', build: 'Impresión 3D, fresado CNC, fundición estilo Gingery, autorreplicación RepRap.', why: 'Hacer las herramientas que fabrican las piezas. Reparar importa más que innovar.' },
  { num: '05', title: 'Agroprocesamiento', problem: 'Las materias primas salen de la región a precios de commodity.', build: 'Beneficio húmedo de café, línea de fermentación de cacao, deshidratadores solares, destilación de aceites esenciales.', why: 'El valor agregado en origen captura el margen que hoy se pierde con los intermediarios.' },
  { num: '06', title: 'Manufactura Local', problem: 'Los bienes de consumo llegan caros, frágiles y poco adaptados a las condiciones.', build: 'Construcción con bolsas de tierra y ferrocemento, invernaderos, acuaponía, productos de plástico reciclado.', why: 'La manufactura regional reduce la dependencia y genera empleo local.' },
];

const whyCards = [
  { title: 'El aislamiento genera presión de diseño', desc: 'Cuando el reabastecimiento tarda días y la ciudad más cercana queda a horas de distancia, cada sistema debe ser robusto, reparable y abastecido localmente.' },
  { title: 'Reparar importa más que innovar', desc: 'Los Yungas no necesitan prototipos de vanguardia. Necesitan cosas que funcionen cuando el camino se derrumba.' },
  { title: 'Los problemas regionales crean oportunidades', desc: 'Las soluciones diseñadas para estas restricciones — energía, agua, comunicaciones, procesamiento — tienen mercado en toda la América Latina rural.' },
  { title: 'La infraestructura abierta tiene valor regional', desc: 'Sistemas documentados y replicables pueden ser adoptados por otras comunidades que enfrentan condiciones similares.' },
];

const pipeline = [
  { step: '01', title: 'Identificar la necesidad local', desc: 'Hablar con los residentes, observar las fallas, mapear qué se rompe y qué falta.' },
  { step: '02', title: 'Prototipar', desc: 'Construir una versión mínima viable con materiales y herramientas disponibles.' },
  { step: '03', title: 'Probar en sitio', desc: 'Desplegar en condiciones reales — altitud, humedad, acceso vial, variabilidad eléctrica.' },
  { step: '04', title: 'Refinar', desc: 'Corregir lo que falló. Simplificar lo sobreingeniado. Reducir costo y complejidad.' },
  { step: '05', title: 'Documentar', desc: 'Publicar planos, listas de materiales, datos de prueba e informes de fallas bajo licencias abiertas.' },
  { step: '06', title: 'Replicar o convertir en emprendimiento', desc: 'Escalar a otros sitios, o construir un negocio alrededor de la solución probada.' },
];

const skills = [
  'Instalación solar y diseño de sistemas fuera de red',
  'Sistemas de agua — captación, filtración, aguas grises',
  'Fabricación — impresión 3D, CNC, fundición',
  'Redes de bajo ancho de banda — LoRa, HF, Starlink',
  'Diseño de productos para casos de uso regionales',
  'Software — sistemas embebidos, monitoreo, pipelines de datos',
];

const risks = [
  { title: 'Acceso vial', desc: 'Un solo camino conecta con La Paz. Los deslizamientos lo cierran regularmente en temporada de lluvias (dic-mar).' },
  { title: 'Salud limitada', desc: 'Hay clínicas básicas en Coroico. La atención médica seria requiere evacuación a La Paz.' },
  { title: 'Escasez de materiales', desc: 'Componentes especializados, materiales industriales y electrónica deben conseguirse en La Paz o importarse.' },
  { title: 'Clima y terreno', desc: '1.750 m de altitud, alta humedad, pendientes pronunciadas. Oxida el acero sin recubrimiento en semanas. Limita los métodos de construcción.' },
  { title: 'La adaptación local importa', desc: 'Las soluciones deben funcionar para la gente que ya vive aquí. Las suposiciones importadas fracasan. Primero escuchar.' },
];
---

<Landing title="Constructores" description="BARK necesita ingenieros, fabricantes y constructores. Sitio real, restricciones reales, documentación de código abierto. Construir infraestructura que funcione a 1.750 m en los Yungas." heroImage="/images/yungas/death-road.jpg">

  <!-- 1. Hero -->
  <section class="relative min-h-screen flex items-center px-6 lg:px-10 pt-16">
    <div class="absolute inset-0 z-0">
      <img src="/images/yungas/death-road.jpg" alt="Camino tallado en la ladera de los Yungas" width="1920" height="1277" class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
      <div class="absolute inset-0 bg-gradient-to-b from-bark-900/70 via-bark-900/60 to-bark-900/90"></div>
    </div>
    <div class="relative z-10 max-w-[900px] mx-auto py-20">
      <span class="text-label text-accent reveal">Constructores</span>
      <h1 class="text-display text-bark-50 mt-6 reveal" data-delay="100">
        Construir Sistemas Reales en los Yungas
      </h1>
      <p class="text-body-lg text-bark-200 mt-6 max-w-2xl reveal" data-delay="150">
        BARK es un lugar para construir infraestructura, herramientas y emprendimientos bajo restricciones reales en los Yungas bolivianos. Energía, agua, fabricación, comunicaciones, producción local — diseñados a 1.750 m, documentados para su replicación.
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-4 mt-10 reveal" data-delay="300">
        <a href="#que-se-construye" class="inline-flex items-center gap-3 px-8 py-4 bg-accent text-white font-display font-semibold text-sm tracking-wide rounded-full hover:bg-accent-dim transition-colors duration-300">
          Ver Qué Se Construye
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        </a>
        <a href="mailto:bark@pt32lab.org?subject=Consulta%20Equipo%20de%20Construcción" class="inline-flex items-center gap-3 px-8 py-4 border border-bark-400 text-bark-200 font-display font-semibold text-sm tracking-wide rounded-full hover:bg-white/10 transition-colors duration-300">
          Hablar con el Equipo
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. Por Qué los Constructores Importan Aquí -->
  <section class="section-gap px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto">
      <span class="text-label text-bark-500 reveal">Por Qué los Constructores Importan Aquí</span>
      <h2 class="text-headline text-bark-800 mt-4 mb-10 reveal" data-delay="100">
        Esto no es diseño abstracto
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {whyCards.map((c, i) => (
          <div class="card hover-lift reveal" data-delay={String(i * 80)}>
            <h3 class="font-display font-semibold text-bark-800 text-lg mb-2">{c.title}</h3>
            <p class="text-sm text-bark-500 leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Qué Se Construye — 6 tarjetas de sistemas -->
  <section id="que-se-construye" class="section-dark section-gap px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto">
      <span class="text-label text-accent reveal">Qué Se Construye</span>
      <h2 class="text-headline text-bark-50 mt-4 mb-10 reveal" data-delay="100">
        Seis sistemas, un sitio
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {systems.map((s, i) => (
          <div class="card-dark card hover-lift reveal" data-delay={String(i * 80)}>
            <span class="text-label text-accent mb-3 block">{s.num} — {s.title}</span>
            <p class="text-sm text-bark-400 leading-relaxed mb-2"><strong class="text-bark-300">Problema:</strong> {s.problem}</p>
            <p class="text-sm text-bark-400 leading-relaxed mb-2"><strong class="text-bark-300">Construcción:</strong> {s.build}</p>
            <p class="text-sm text-accent/80 leading-relaxed">{s.why}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Pipeline de Construcción -->
  <section class="section-gap px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto">
      <span class="text-label text-bark-500 reveal">Pipeline de Construcción</span>
      <h2 class="text-headline text-bark-800 mt-4 mb-10 reveal" data-delay="100">
        De la necesidad local al sistema replicable
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {pipeline.map((p, i) => (
          <div class="flex gap-4 reveal" data-delay={String(i * 80)}>
            <span class="font-display font-bold text-3xl text-bark-200 shrink-0 leading-none mt-1">{p.step}</span>
            <div>
              <h3 class="font-display font-semibold text-bark-800 text-base mb-1">{p.title}</h3>
              <p class="text-sm text-bark-500 leading-relaxed">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Tecnoparque + Infraestructura -->
  <section class="bg-bark-100 section-gap px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto">
      <span class="text-label text-bark-500 reveal">Dos Capas</span>
      <h2 class="text-headline text-bark-800 mt-4 mb-10 reveal" data-delay="100">
        Tecnoparque vs. Infraestructura
      </h2>
      <div class="content-two-col">
        <div class="bar-section reveal" data-delay="100">
          <h3 class="font-display font-semibold text-bark-800 text-xl mb-4">Tecnoparque</h3>
          <p class="text-sm text-bark-600 leading-relaxed mb-3">Invención, prototipado, herramientas, reparación y apoyo a emprendimientos. El tecnoparque es donde las nuevas soluciones se diseñan, prueban y refinan antes de ser desplegadas.</p>
          <ul class="space-y-2 text-sm text-bark-500">
            <li>Talleres de fabricación (impresión 3D, CNC, fundición)</li>
            <li>Laboratorio de electrónica y sistemas embebidos</li>
            <li>Instalaciones de diseño y prueba de productos</li>
            <li>Espacio de incubación para emprendimientos locales</li>
          </ul>
          <a href="/es/pillars/technopark" class="link-arrow mt-4 inline-flex">
            Leer sobre el Tecnoparque
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
        </div>
        <div class="bar-section reveal" data-delay="200">
          <h3 class="font-display font-semibold text-bark-800 text-xl mb-4">Infraestructura</h3>
          <p class="text-sm text-bark-600 leading-relaxed mb-3">Energía, agua, hábitat, comunicaciones y la columna vertebral operativa. La infraestructura es lo que mantiene el sitio funcionando día a día, temporada a temporada.</p>
          <ul class="space-y-2 text-sm text-bark-500">
            <li>Sistemas de energía solar + microhidráulica</li>
            <li>Captación, filtración y reciclaje de agua</li>
            <li>Red de comunicaciones (Starlink, LoRa, HF)</li>
            <li>Edificaciones, caminos y mantenimiento del sitio</li>
          </ul>
          <a href="/es/pillars/infrastructure" class="link-arrow mt-4 inline-flex">
            Leer sobre Infraestructura
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Habilidades Que Necesitamos Ahora -->
  <section class="section-gap px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto">
      <span class="text-label text-bark-500 reveal">Lo Que Necesitamos Ahora</span>
      <h2 class="text-headline text-bark-800 mt-4 mb-10 reveal" data-delay="100">
        Habilidades específicas, presenciales o remotas
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {skills.map((skill, i) => (
          <div class="flex items-start gap-3 py-3 reveal" data-delay={String(i * 60)}>
            <span class="text-accent mt-1 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/></svg>
            </span>
            <span class="text-bark-700 font-display text-sm font-medium">{skill}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Capa de Código Abierto -->
  <section class="section-dark section-gap px-6 lg:px-10">
    <div class="content-width">
      <span class="text-label text-accent reveal">Capa de Código Abierto</span>
      <h2 class="text-headline text-bark-50 mt-4 mb-8 reveal" data-delay="100">
        Todo documentado. Todo publicado.
      </h2>
      <div class="space-y-6 text-body-lg text-bark-300 reveal" data-delay="200">
        <p>
          Planos, listas de materiales, resultados de pruebas, informes de fallas — todo publicado bajo licencias abiertas.
          Bifurca los diseños. Adáptalos a tu sitio. Envía las mejoras de vuelta.
        </p>
        <p>
          El stack se apoya en lo que ya existe: el Global Village Construction Set,
          la fabricación autorreplicante RepRap, las máquinas de reciclaje Precious Plastic.
          No estamos inventando desde cero. Estamos integrando, probando y documentando
          en un sitio específico con restricciones específicas.
        </p>
        <p>
          La documentación no es un paso posterior. Es el producto principal.
          Un sistema que funciona pero no se puede replicar es un pasatiempo, no infraestructura.
        </p>
      </div>
    </div>
  </section>

  <!-- 8. Riesgos / Realidades -->
  <section class="section-gap px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto">
      <span class="text-label text-bark-500 reveal">Riesgos y Realidades</span>
      <h2 class="text-headline text-bark-800 mt-4 mb-10 reveal" data-delay="100">
        Lo que debes saber antes de comprometerte
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {risks.map((r, i) => (
          <div class="card hover-lift reveal" data-delay={String(i * 80)}>
            <h3 class="font-display font-semibold text-bark-800 text-base mb-2">{r.title}</h3>
            <p class="text-sm text-bark-500 leading-relaxed">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. CTA -->
  <section class="section-gap-lg bg-bark-100 px-6 lg:px-10">
    <div class="content-width text-center">
      <h2 class="text-headline text-bark-800 mb-4 reveal">
        Cuéntanos qué construyes.
      </h2>
      <p class="text-body-lg text-bark-500 mb-8 reveal" data-delay="100">
        BARK busca ingenieros, fabricantes, constructores y operadores técnicos que quieran construir sistemas que importan.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 reveal" data-delay="200">
        <a href="mailto:bark@pt32lab.org?subject=Unirse%20a%20la%20Red%20de%20Constructores" class="inline-flex items-center gap-3 px-8 py-4 bg-accent text-white font-display font-semibold text-sm tracking-wide rounded-full hover:bg-accent-dim transition-colors duration-300">
          Unirse a la Red de Constructores
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mt-6 reveal" data-delay="300">
        <a href="/es/pillars/technopark" class="link-arrow">
          Leer sobre el Tecnoparque
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="/es/pillars/infrastructure" class="link-arrow">
          Leer sobre Infraestructura
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="/es/economy" class="link-arrow">
          Economía
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="/es/participate" class="link-arrow">
          Participar
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

</Landing>
