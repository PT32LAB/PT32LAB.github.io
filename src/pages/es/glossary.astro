---
import Base from '../../layouts/Base.astro';

const terms = [
  { term: 'Achachilas', definition: 'Mountain spirits in Aymara cosmology.' },
  { term: 'AFCOOP', definition: 'Autoridad de Fiscalizaci\u00f3n y Control de Cooperativas. Bolivia\u2019s cooperative regulator.' },
  { term: 'ANMI', definition: '\u00c1rea Natural de Manejo Integrado. Managed conservation area designation in Bolivia.' },
  { term: 'Appropriate technology', definition: 'Technology that is suitable for local conditions \u2014 maintainable, repairable, and useful by the community that uses it.' },
  { term: 'Ayllu', definition: 'Pre-colonial Andean governance model based on collective agriculture, kinship networks, and reciprocal obligations. Constitutionally recognized in Bolivia since 2009.' },
  { term: 'Ayni', definition: 'Aymara/Quechua concept of reciprocal labor exchange. I help you today, you help me tomorrow.' },
  { term: 'BARK', definition: 'Bolivian Ark. The name of this project.' },
  { term: 'Cooperative (Cooperativa)', definition: 'Legal organizational form in Bolivia under Ley 356 (2013). Minimum 10 members, one-member-one-vote.' },
  { term: 'DAO', definition: 'Decentralized Autonomous Organization. Token-based governance using blockchain.' },
  { term: 'GVCS', definition: 'Global Village Construction Set. Open Source Ecology\u2019s suite of 50 open-source machines for civilization.' },
  { term: 'Ley 356', definition: 'Bolivia\u2019s 2013 General Cooperative Law governing all cooperative organizations.' },
  { term: 'Mandar obedeciendo', definition: '\u201cLead by obeying.\u201d Zapatista governance principle where leaders execute the assembly\u2019s decisions.' },
  { term: 'Minka (Mink\u2019a)', definition: 'Communal labor for community benefit. Everyone contributes work to shared projects.' },
  { term: 'NetworkTribes', definition: 'The knowledge framework designed by Oleg. Maps ideas across multiple dimensions for exploration.' },
  { term: 'Pachamama', definition: 'Earth Mother in Andean cosmology. Central to Aymara and Quechua spiritual practice.' },
  { term: 'RepRap', definition: 'Replicating Rapid Prototyper. Open-source 3D printer project designed to print its own components.' },
  { term: 'Saya', definition: 'Traditional Afro-Bolivian music and dance form, central to the cultural identity of Yungas communities.' },
  { term: 'Semi-autonomous', definition: 'BARK\u2019s operating philosophy: capable of independent operation when needed, normally integrated with regional systems.' },
  { term: 'Technoshamanism', definition: 'BARK\u2019s term for integrating technology-assisted practices (biometric monitoring, data analysis) with traditional healing and contemplative practices.' },
  { term: 'Yungas', definition: 'Transitional ecological zone on the eastern slopes of the Andes. Subtropical montane cloud forest between the altiplano and the Amazon basin.' },
];
---

<Base title="Glossary" description="Key terms and concepts used throughout the BARK website, defined for clarity and cultural context.">
  <!-- Header -->
  <section class="pt-32 pb-16 px-6 lg:px-10">
    <div class="max-w-[900px] mx-auto">
      <span class="text-label text-accent reveal">Reference</span>
      <h1 class="text-headline text-bark-800 mt-4 reveal" data-delay="100">
        Terms & Concepts
      </h1>
      <p class="text-body-lg text-bark-500 mt-4 max-w-2xl reveal" data-delay="200">
        These terms appear throughout the BARK website. Definitions are provided for clarity and cultural context.
      </p>
      <div class="accent-line mt-10 reveal" data-delay="300"></div>
    </div>
  </section>

  <!-- Photo break -->
  <div class="photo-frame h-48 md:h-64 w-full my-12 reveal" style="border-radius:0;">
    <img src="/images/yungas/yungas-landscape.jpg" alt="Panoramic view of the Yungas cloud forest landscape" width="1920" height="1440" loading="lazy" decoding="async" class="w-full h-full object-cover" />
  </div>

  <!-- Glossary list -->
  <section class="pb-32 px-6 lg:px-10">
    <div class="max-w-[900px] mx-auto">
      <div class="divide-y divide-bark-200 border-t border-b border-bark-200">
        {terms.map((item, i) => (
          <div class="py-6 bar-section reveal" data-delay={String(Math.min(i * 40, 400))} id={item.term.toLowerCase().replace(/[\s()'/]/g, '-')}>
            <h2 class="font-display font-semibold text-[1.1rem] text-bark-800 leading-snug">
              {item.term}
            </h2>
            <p class="text-bark-600 text-[1rem] leading-[1.85] mt-2">
              {item.definition}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-bark-100 py-24 px-6 lg:px-10">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="text-title text-bark-800 reveal">Missing a term?</h2>
      <p class="text-bark-500 mt-4 reveal" data-delay="100">
        This glossary grows as the project does. If something is unclear, let us know.
      </p>
      <a
        href="mailto:contact@pt32lab.org"
        class="group inline-flex items-center gap-3 mt-8 px-7 py-4 bg-bark-800 text-bark-50 font-display font-semibold text-sm tracking-wide rounded hover:bg-bark-900 transition-colors duration-300 reveal" data-delay="200"
      >
        Suggest a Term
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>
</Base>
