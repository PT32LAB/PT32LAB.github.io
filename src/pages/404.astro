---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found">
  <section class="min-h-[60vh] flex items-center justify-center px-6">
    <div class="text-center">
      <div class="text-display text-bark-200 mb-6">404</div>
      <h1 class="text-headline text-bark-800 mb-4">Lost in the cloud forest</h1>
      <p class="text-body-lg text-bark-500 mb-8 max-w-md mx-auto">
        This path doesn't lead anywhere yet. The Yungas has many trails — let's find the right one.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/en/" class="link-arrow">
          Back to the beginning
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>
</Base>
