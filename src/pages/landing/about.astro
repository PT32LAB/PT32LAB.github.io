---
import Landing from '../../layouts/Landing.astro';

const components = [
  { name: 'Techno Park', line: 'A fabrication lab and open-source technology campus where broken pumps get fixed and circuit boards get milled.' },
  { name: 'Incubator', line: 'A startup accelerator launching ventures rooted in Coroico\'s actual soil and actual needs.' },
  { name: 'Trading House', line: 'Direct-trade channels for Yungas coffee, cacao, and craft goods -- grower-owned, not middleman-dependent.' },
  { name: 'Retreat Center', line: 'Where Aymara healers and biosensor engineers sit in the same room, comparing notes on what the body does during ceremony.' },
  { name: 'Infrastructure', line: 'Solar arrays, spring-fed cisterns, mesh radios, vertical growing walls -- autonomy as material fact, not slide deck aspiration.' },
];
---

<Landing title="What is BARK?" description="BARK in 60 seconds. Five components, one system. A community in the Bolivian cloud forest learning to provision itself." heroImage="/images/yungas/valley.jpg">

  <!-- Hero with photo bg -->
  <section class="relative min-h-screen flex items-center px-6 lg:px-10 pt-16">
    <div class="absolute inset-0 z-0">
      <img src="/images/yungas/valley.jpg" alt="Yungas valley" width="1920" height="1282" class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
      <div class="absolute inset-0 bg-gradient-to-b from-bark-900/70 via-bark-900/60 to-bark-900/90"></div>
    </div>
    <div class="relative z-10 max-w-[900px] mx-auto py-20">
      <span class="text-label text-accent reveal">BARK in 60 Seconds</span>
      <h1 class="text-display text-bark-50 mt-6 reveal" data-delay="100">
        Five systems. One community.<br/>Built to outlast its founders.
      </h1>
      <p class="text-body-lg text-bark-300 mt-8 max-w-2xl reveal" data-delay="200">
        The Bolivian Ark. Five linked components generating power, food, shelter,
        and livelihoods in the cloud forest -- open source, cooperative, rooted in place.
      </p>
    </div>
  </section>

  <!-- What: 5 components -->
  <section class="section-gap px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto">
      <span class="text-label text-bark-500 reveal">What</span>
      <h2 class="text-headline text-bark-800 mt-4 mb-10 reveal" data-delay="100">
        Five components, one system
      </h2>
      <div class="space-y-4">
        {components.map((c, i) => (
          <div class="flex items-start gap-4 py-4 border-b border-bark-200 last:border-b-0 reveal" data-delay={String(i * 80)}>
            <span class="text-label text-accent shrink-0 w-8 pt-1">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-display font-semibold text-bark-800">{c.name}</h3>
              <p class="text-bark-500 mt-1">{c.line}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Where -->
  <section class="section-gap bg-bark-100 px-6 lg:px-10">
    <div class="max-w-[1100px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <span class="text-label text-bark-500">Where</span>
        <h2 class="text-headline text-bark-800 mt-4 mb-6">
          Coroico, Yungas
        </h2>
        <p class="text-body-lg text-bark-600">
          1,750 meters in the subtropical crease where the Andes collapse into the Amazon basin.
          Year-round growing season, 18-28C, abundant spring water. Three hours from La Paz
          by road -- connected enough to reach, remote enough to function independently.
        </p>
      </div>
      <div class="photo-frame h-64 md:h-80 reveal" data-delay="100">
        <img src="/images/yungas/coroico-clouds.jpg" alt="Coroico in the clouds" width="1920" height="1282" loading="lazy" decoding="async" />
        <div class="photo-credit">Coroico, Yungas, Bolivia</div>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="section-gap px-6 lg:px-10">
    <div class="content-width">
      <span class="text-label text-bark-500 reveal">Why</span>
      <h2 class="text-headline text-bark-800 mt-4 mb-8 reveal" data-delay="100">
        Precarity demands capability
      </h2>
      <div class="space-y-6 text-body-lg text-bark-600 reveal" data-delay="200">
        <p>
          The systems most people depend on -- global supply chains, centralized energy grids,
          just-in-time food logistics -- are optimized for efficiency, not resilience.
          When they fail, the people with no local capacity to produce are the most exposed.
        </p>
        <p>
          BARK builds the capability to provision the basics -- power, food, water, shelter,
          communication, governance -- at a community scale, in a place where the land and
          climate make it achievable.
        </p>
      </div>
    </div>
  </section>

  <div class="divider-accent max-w-[900px] mx-auto"></div>

  <!-- Who -->
  <section class="section-gap px-6 lg:px-10">
    <div class="content-width">
      <span class="text-label text-bark-500 reveal">Who</span>
      <h2 class="text-title text-bark-800 mt-4 mb-4 reveal" data-delay="100">
        Started by Drow Dvorkin. Designed to be owned by many.
      </h2>
      <p class="text-body-lg text-bark-500 reveal" data-delay="200">
        Every cooperative begins with someone willing to publish the work before the
        structure exists. The research is open. The governance model is designed for
        collective ownership from day one. The team grows as the work proves itself.
      </p>
    </div>
  </section>

  <!-- Status -->
  <section class="section-gap bg-bark-900 text-bark-300 px-6 lg:px-10">
    <div class="content-width text-center">
      <div class="tag tag-accent mb-6 mx-auto reveal">Current Status</div>
      <h2 class="text-headline text-bark-50 mb-6 reveal" data-delay="100">
        Phase 0 -- Research Initiative
      </h2>
      <p class="text-body-lg text-bark-400 max-w-2xl mx-auto reveal" data-delay="200">
        No land purchased. No legal entity formed. No revenue generated.
        What exists: published analysis, open-source plans, a forming community,
        and a commitment to radical transparency about what is real and what is aspiration.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-gap-lg px-6 lg:px-10">
    <div class="content-width text-center">
      <h2 class="text-headline text-bark-800 mb-8 reveal">
        This was the overview. The details are open.
      </h2>
      <a href="/en/vision" class="inline-flex items-center gap-3 px-8 py-4 bg-accent text-white font-display font-semibold text-sm tracking-wide rounded-full hover:bg-accent-dim transition-colors duration-300 reveal" data-delay="100">
        Explore the full vision and plans
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </section>

</Landing>
