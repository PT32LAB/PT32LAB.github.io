---
import Base from '../../layouts/Base.astro';

const developmentPartners = [
  {
    name: 'Practical Action Bolivia',
    what: 'Appropriate technology for rural communities. Regenerative agriculture and climate resilience in Bolivia. Reached 29,000 people in 2023. 365% productivity boost through renewable energy for 4,300 farmers.',
    why: 'Already in Bolivia with a La Paz office (Presbitero Medina St. 2922, Sopocachi). Reached 29,000 people in 2023. Their mission is literally appropriate technology for rural communities — regenerative agriculture, renewable energy, climate resilience. Funded by GIZ, Swiss SDC, Z Zurich Foundation.',
    url: 'https://practicalaction.org/where-we-work/latin-america/bolivia/',
  },
  {
    name: 'GIZ Bolivia',
    what: 'German development cooperation in Bolivia since 1962. Water, sanitation, irrigation, vocational training, and climate adaptation. Over 2 million Bolivians benefited from improved water systems.',
    why: 'Their water, sanitation, and irrigation programs directly match BARK\'s infrastructure needs. Their vocational training model aligns with BARK\'s education vision. Already a funding partner of Practical Action in Bolivia.',
    url: 'https://www.giz.de/en/regions/latin-america-caribbean/bolivia',
  },
  {
    name: 'Engineers Without Borders',
    what: 'Student engineering teams delivering infrastructure projects. Active Bolivia projects in 2025-2026: irrigation systems, water distribution, eco-latrines, and community sanitation across multiple university chapters.',
    why: '5 active Bolivia projects in 2025-2026 (Auburn, Kansas, Missouri S&T, UC Davis, Pittsburgh). EWB chapters need projects. BARK offers a permanent year-round site with recurring infrastructure challenges — solving EWB\'s common problem of one-visit projects with no maintenance.',
    url: 'https://www.ewb-usa.org/',
  },
  {
    name: 'Habitat for Humanity Bolivia',
    what: 'Operating in Bolivia since 1985. Housing, WASH (water, sanitation, hygiene), women\'s land rights, and community development from offices in Cochabamba, La Paz, and Santa Cruz.',
    why: 'BARK\'s open-source, locally-sourced construction methods align with Habitat\'s self-construction model. BARK could serve as a training center for construction techniques adaptable across Bolivia.',
    url: 'https://www.habitat.org/where-we-build/bolivia',
  },
  {
    name: 'Solar Energy International',
    what: 'Professional solar PV installation training. Trained over 9,000 Spanish speakers since 2013. Recently opened first International Solar Training Center in Costa Rica.',
    why: 'BARK plans solar infrastructure as a core component. SEI needs demonstration sites in South America. Bolivia\'s major rural electrification program creates demand for trained installers.',
    url: 'https://www.solarenergy.org/',
  },
];

const academicPartners = [
  {
    name: 'Carmen Pampa University (UAC-CP)',
    what: '12 km from Coroico. Programs in agronomy, veterinary science, nursing, education, and ecotourism. Pre-university program, food cooperative, research projects.',
    why: 'Just 12 km from Coroico with degrees in agronomy, ecotourism, and veterinary science — a natural training partner. Students need practicum sites and thesis projects. They actively seek international partnerships after losing USAID funding in 2013. Cited by a UN committee as "one of the leading examples of how best to eradicate poverty."',
    url: 'https://carmenpampafund.org/',
  },
  {
    name: 'UMSA (Universidad Mayor de San Andres)',
    what: 'Bolivia\'s leading public university in La Paz (2-3 hours from Coroico). 13 faculties, 56 research institutes. Active collaboration with FiBL on the 15-year cocoa agroforestry research project.',
    why: 'UMSA researchers need field sites in the Yungas where they already have research interests. BARK could host research students and faculty. La Paz proximity makes regular visits feasible.',
    url: 'https://www.umsa.bo/en/home',
  },
  {
    name: 'International Research Programs',
    what: 'Princeton (Yungas excursions), University of Oregon (indigenous rights research), Missouri Botanical Garden (50 permanent plots in Yungas since 2002), FiBL (15-year cocoa farming trial), Belgian universities (traditional ecological knowledge).',
    why: 'BARK\'s unique position as a community-scale intervention in the Yungas makes it valuable to multiple research disciplines. Joint research agreements strengthen both academic credibility and funding prospects.',
  },
];

const techPartners = [
  {
    name: 'Open Source Ecology',
    what: 'Developing the Global Village Construction Set — 50 open-source industrial machines needed to build a small civilization. All designs under GNU GPL. Compressed earth brick press, tractor, 3D printer, and more.',
    why: 'BARK is literally the use case OSE was designed for. A Yungas deployment would be their most significant international implementation. Real-world testing in tropical conditions.',
    url: 'https://www.opensourceecology.org/',
  },
  {
    name: 'Fab Foundation',
    what: '2,500+ Fab Labs worldwide. 6 Fab Labs already in Bolivia: Cochabamba, Santa Cruz (3), Oruro, and Santa Cruz. Part of Fab Lat, the Latin American network covering 10 countries.',
    why: '6 Fab Labs already in Bolivia (Cochabamba, Santa Cruz x3, Oruro, Santa Cruz). A Fab Lab at BARK extends the Fab Lat network into the Yungas — a unique jungle/off-grid fabrication lab. The Foundation actively supports new lab creation with training and network access.',
    url: 'https://fabfoundation.org/',
  },
  {
    name: 'Precious Plastic',
    what: 'Open-source recycling machine designs and 80,000-strong global community. Machines built from low-cost components. Growing presence in Chile, Brazil, and Argentina. No confirmed operation in Bolivia yet.',
    why: 'BARK could become Bolivia\'s first Precious Plastic Community Point. The open-source ethos is identical. Plastic waste is a growing problem in Bolivian rural communities.',
    url: 'https://www.preciousplastic.com/',
  },
  {
    name: 'RepRap Community',
    what: 'Open-source self-replicating 3D printer. Materials cost approximately EUR 350. Licensed under GNU GPL. Designed to democratize manufacturing for communities in the developing world.',
    why: '3D printing enables production of spare parts, tools, and components without supply chain dependency. BARK\'s vision of local manufacturing from open-source designs is the RepRap philosophy at community scale.',
    url: 'https://reprap.org/',
  },
];

const networkPartners = [
  {
    name: 'CASA Latina',
    what: '100+ sustainable settlements across Latin America. Part of the Global Ecovillage Network. Includes traditional communities, indigenous territories, and urban regenerative projects — not just ecovillages.',
    why: 'Membership gives BARK access to a network of 100+ similar communities, shared knowledge, and collective advocacy. BARK fills an underrepresented area (Bolivia) with a tech-integrated model.',
    url: 'https://ecovillage.org/region/casa/',
  },
  {
    name: 'Cooperatives of the Americas',
    what: 'ICA regional office in San Jose, Costa Rica. Promoting cooperative development across the Americas. Bolivia has 15,000 active cooperatives, a tradition rooted in ancestral Andean practices of ayni and ayllu.',
    why: 'BARK as a tech-integrated cooperative provides a modern model that ICA could promote. The combination of traditional Andean cooperative values with open-source technology is compelling for their network.',
    url: 'https://aciamericas.coop/en/',
  },
  {
    name: 'Transition Towns Network',
    what: '1,000+ communities worldwide building local resilience. Tools for local food systems, community energy, economic localization. "Great Reskilling" workshops and local currency experiments.',
    why: 'Tested tools for community resilience building directly applicable to BARK. Their methodology and community organizing frameworks accelerate what BARK is trying to build.',
    url: 'https://transitionnetwork.org/',
  },
  {
    name: 'Savory Institute',
    what: 'Global regenerative agriculture network promoting holistic land management. Hub network model connecting local practitioners to a global knowledge base.',
    why: 'Regenerative agriculture methods for BARK\'s food systems. Their hub network model mirrors BARK\'s open-source philosophy — local practice, global knowledge sharing.',
    url: 'https://savory.global/',
  },
];

const governmentPrograms = [
  {
    name: '$325M Solar Electrification Program',
    source: 'Government of Bolivia + IDB + World Bank + Green Climate Fund',
    detail: 'Targeting 140,000 rural families. 25,000+ households, 500 schools, 50 health centers. World Bank approved $125M component. Nordic Development Fund approved EUR 4M for hybrid renewable systems.',
  },
  {
    name: 'IDB $4.5B Development Package (2026-2028)',
    source: 'Inter-American Development Bank',
    detail: 'Economic stabilization, growth, and job creation. Includes $500M for social protection and $10M for sustainable tourism development (40-year loan, 1% interest during grace period).',
  },
  {
    name: 'INIAF Agriculture Programs',
    source: 'Instituto Nacional de Innovacion Agropecuaria y Forestal',
    detail: 'Genetic improvement for coffee and cacao. Climate-resilient varieties. Technical assistance. Over 9,000 smallholder cacao families. Goal: increase incomes 40% for 3,500 producers.',
  },
  {
    name: 'Tourism Development ($10M IDB)',
    source: 'Inter-American Development Bank',
    detail: 'Strategic actions in sustainable tourism: certification, demonstration projects, promotion. Explicitly encourages low-income residents near protected sites to participate through training and entrepreneurship.',
  },
  {
    name: 'Ley 356 Cooperative Framework',
    source: 'Government of Bolivia (2013)',
    detail: 'Bolivia\'s constitution recognizes cooperatives in 12 articles. AFCOOP regulates 15,000 active cooperatives. Democratic governance, non-profit structure, registration within 90 days of formation.',
  },
  {
    name: 'Green Climate Fund Projects',
    source: 'GCF via Banco de Desarrollo Productivo',
    detail: '5 active GCF-funded projects in Bolivia including Amazonia Viva, Water Security, Ecosystem Resilience, and Amazon Bioeconomy Fund. BDP-SAM is a GCF Direct Access Accredited Entity.',
  },
];
---

<Base title="Partners & Contributors" description="Organizations, institutions, and networks building alongside BARK.">
  <!-- Header -->
  <section class="pt-32 pb-16 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <span class="text-label text-accent reveal">Collaboration</span>
      <h1 class="text-headline text-bark-800 mt-4 max-w-3xl reveal" data-delay="100">
        Partners & Contributors
      </h1>
      <p class="text-body-lg text-bark-500 mt-6 max-w-2xl reveal" data-delay="200">
        No project this ambitious succeeds alone. These are the organizations, institutions,
        and networks whose work aligns with BARK's mission — potential collaborators, not just
        names on a page.
      </p>
      <div class="accent-line mt-10 max-w-xl reveal" data-delay="300"></div>
    </div>
  </section>

  <!-- Development Partners -->
  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Development Partners</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        NGOs and development organizations already active in Bolivia whose programs directly
        overlap with BARK's infrastructure and community development needs.
      </p>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {developmentPartners.map(p => (
          <div class="bg-bark-50 p-10">
            <div class="flex items-start justify-between gap-4 mb-4">
              <h3 class="font-display font-semibold text-bark-800 text-lg">{p.name}</h3>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
            </div>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed mb-4">{p.what}</p>
            <div class="border-t border-bark-200 pt-4">
              <span class="text-label text-accent text-[0.6rem]">Why partner with BARK</span>
              <p class="text-bark-500 text-sm leading-relaxed mt-1">{p.why}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Academic Partners -->
  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Academic Partners</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        Universities and research programs with direct relevance to BARK's location and mission.
        Carmen Pampa is 12 km away. UMSA is 2-3 hours in La Paz. International programs already
        study the Yungas.
      </p>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {academicPartners.map(p => (
          <div class="bg-bark-50 p-10">
            <div class="flex items-start justify-between gap-4 mb-4">
              <h3 class="font-display font-semibold text-bark-800 text-lg">{p.name}</h3>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
            </div>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed mb-4">{p.what}</p>
            <div class="border-t border-bark-200 pt-4">
              <span class="text-label text-accent text-[0.6rem]">Why partner with BARK</span>
              <p class="text-bark-500 text-sm leading-relaxed mt-1">{p.why}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech & Open Source -->
  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Tech & Open Source</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        Open-source hardware, fabrication networks, and maker communities whose tools and
        philosophy BARK is built on.
      </p>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {techPartners.map(p => (
          <div class="bg-bark-50 p-10">
            <div class="flex items-start justify-between gap-4 mb-4">
              <h3 class="font-display font-semibold text-bark-800 text-lg">{p.name}</h3>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
            </div>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed mb-4">{p.what}</p>
            <div class="border-t border-bark-200 pt-4">
              <span class="text-label text-accent text-[0.6rem]">Why partner with BARK</span>
              <p class="text-bark-500 text-sm leading-relaxed mt-1">{p.why}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Networks -->
  <section class="pb-20 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Networks & Movements</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        Global and regional networks building the connective tissue between communities
        like BARK.
      </p>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden reveal" data-delay="200">
        {networkPartners.map(p => (
          <div class="bg-bark-50 p-10">
            <div class="flex items-start justify-between gap-4 mb-4">
              <h3 class="font-display font-semibold text-bark-800 text-lg">{p.name}</h3>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-display font-medium shrink-0 hover:underline">
                  Visit &rarr;
                </a>
              )}
            </div>
            <p class="text-bark-600 text-[0.95rem] leading-relaxed mb-4">{p.what}</p>
            <div class="border-t border-bark-200 pt-4">
              <span class="text-label text-accent text-[0.6rem]">Why partner with BARK</span>
              <p class="text-bark-500 text-sm leading-relaxed mt-1">{p.why}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Government Programs -->
  <section class="bg-bark-100 py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <h2 class="text-title text-bark-800 mb-3 reveal">Government Programs</h2>
      <p class="text-bark-500 mb-10 max-w-2xl reveal" data-delay="100">
        Active Bolivian and international development programs that BARK's mission aligns with.
        These represent funding opportunities, regulatory frameworks, and institutional support.
      </p>

      <div class="space-y-4 reveal" data-delay="200">
        {governmentPrograms.map(g => (
          <div class="bg-bark-50 rounded-xl p-8 border border-bark-200">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-3">
              <h3 class="font-display font-semibold text-bark-800">{g.name}</h3>
              <span class="text-label text-bark-400 text-[0.6rem] shrink-0">{g.source}</span>
            </div>
            <p class="text-bark-600 text-sm leading-relaxed">{g.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Become a Partner CTA -->
  <section class="py-32 px-6 lg:px-10">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="text-headline text-bark-800 reveal">Become a Partner</h2>
      <p class="text-body-lg text-bark-500 mt-4 reveal" data-delay="100">
        If your organization works in renewable energy, regenerative agriculture, cooperative
        development, open-source hardware, or community building in Latin America, we should talk.
      </p>
      <a
        href="mailto:contact@pt32lab.org"
        class="group inline-flex items-center gap-3 mt-8 px-7 py-4 bg-bark-800 text-bark-50 font-display font-semibold text-sm tracking-wide rounded hover:bg-bark-900 transition-colors duration-300 reveal" data-delay="200"
      >
        Contact Us
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>
</Base>
