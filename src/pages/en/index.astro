---
import Base from '../../layouts/Base.astro';
import MyceliumCanvas from '../../components/MyceliumCanvas.astro';
import { t } from '../../i18n/ui';
const lang = 'en';

const pathways = [
  { key: 'builders' as const, num: '01', link: `/${lang}/pillars` },
  { key: 'investors' as const, num: '02', link: `/${lang}/participate` },
  { key: 'community' as const, num: '03', link: `/${lang}/governance` },
  { key: 'locals' as const, num: '04', link: `/${lang}/location` },
];

const pillars = [
  { name: 'Techno Park', desc: 'Fabrication lab, open-source R&D, and the tools to build what the supply chain forgot.', link: `/${lang}/pillars/technopark` },
  { name: 'Incubator', desc: 'Ventures born at altitude -- serving Coroico first, then the world.', link: `/${lang}/pillars/incubator` },
  { name: 'Trading House', desc: 'Yungas coffee, cacao, and craft moving through channels we control.', link: `/${lang}/pillars/trading` },
  { name: 'Retreat Center', desc: 'Plant medicine meets biofeedback lab. Indigenous wisdom and modern practice, taken seriously.', link: `/${lang}/pillars/retreat` },
  { name: 'Infrastructure', desc: 'Solar arrays, spring-fed water, vertical farms, mesh network. The quiet engine underneath.', link: `/${lang}/pillars/infrastructure` },
];
---

<Base title="Home">
  <!-- Hero — dark, immersive, kinetic typography -->
  <section class="relative min-h-screen flex items-end pb-20 overflow-hidden bg-night">
    <MyceliumCanvas />
    <div class="absolute inset-0 bg-gradient-to-t from-night via-night/80 to-transparent z-[1]"></div>

    <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-10 w-full">
      <div class="mb-8 reveal" data-delay="100">
        <span class="text-label text-accent tracking-widest">Coroico, Bolivia -- 1,750m</span>
      </div>

      <!-- Kinetic headline — word-by-word reveal -->
      <h1 class="text-display text-bark-50 max-w-5xl text-split">
        The Andes dissolve into cloud forest here. We're building into the seam.
      </h1>

      <div class="mt-8 max-w-2xl reveal" data-delay="400">
        <p class="text-body-lg text-bark-300 leading-relaxed">
          BARK — the Bolivian Ark — is a community being built in the Yungas
          cloud forest. Five interlocking systems designed to produce their own
          energy, grow their own food, and govern themselves transparently.
          Every plan published. Every decision on the record.
        </p>
      </div>

      <div class="mt-12 flex flex-wrap items-center gap-6 reveal" data-delay="600">
        <a href={`/${lang}/participate`} class="group inline-flex items-center gap-3 px-7 py-4 bg-accent text-night font-display font-semibold text-sm tracking-wide rounded hover:bg-accent-light transition-colors duration-300">
          {t(lang, 'hero.cta')}
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href={`/${lang}/vision`} class="inline-flex items-center gap-2 text-bark-400 hover:text-bark-50 font-display text-sm tracking-wide transition-colors duration-300">
          {t(lang, 'hero.learn')}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/></svg>
        </a>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 right-6 lg:right-10 hidden md:flex flex-col items-center gap-2 text-bark-500 text-xs">
        <span class="text-label tracking-widest" style="writing-mode:vertical-lr;">Scroll</span>
        <div class="w-px h-12 bg-gradient-to-b from-bark-500 to-transparent animate-pulse"></div>
      </div>
    </div>
  </section>

  <!-- Stats strip — animated counters with verified data -->
  <section class="bg-bark-900 py-10 px-6 lg:px-10 border-t border-bark-800">
    <div class="max-w-[1400px] mx-auto grid grid-cols-2 md:grid-cols-5 gap-8">
      <div class="text-center reveal">
        <div class="text-headline text-accent font-display">
          <span class="counter" data-target="1750" data-suffix="m">0</span>
        </div>
        <span class="text-label text-bark-500 mt-1 block">Above Sea Level</span>
      </div>
      <div class="text-center reveal" data-delay="100">
        <div class="text-headline text-bark-50 font-display">
          <span class="counter" data-target="400" data-suffix="+">0</span>
        </div>
        <span class="text-label text-bark-500 mt-1 block">Bird Species Recorded</span>
      </div>
      <div class="text-center reveal" data-delay="150">
        <div class="text-headline text-bark-50 font-display">
          <span class="counter" data-target="3000" data-suffix="+">0</span>
        </div>
        <span class="text-label text-bark-500 mt-1 block">Documented Plant Species</span>
      </div>
      <div class="text-center reveal" data-delay="200">
        <div class="text-headline text-bark-50 font-display">18-28°C</div>
        <span class="text-label text-bark-500 mt-1 block">Twelve Months a Year</span>
      </div>
      <div class="text-center reveal" data-delay="300">
        <div class="text-headline text-accent font-display">Open Source</div>
        <span class="text-label text-bark-500 mt-1 block">Plans, Code, Governance</span>
      </div>
    </div>
  </section>

  <!-- Pathways — four audience entry points -->
  <section class="py-32 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="max-w-xl mb-20">
        <span class="text-label text-accent reveal">Who This Is For</span>
        <h2 class="text-headline text-bark-800 mt-4 text-split">
          Four ways in
        </h2>
        <p class="text-body-lg text-bark-500 mt-4 reveal" data-delay="200">
          BARK needs specific people with specific skills. Find the entry point that fits what you actually do.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden">
        {pathways.map((p, i) => (
          <a href={p.link} class="group relative bg-bark-50 p-10 hover:bg-bark-100 transition-colors duration-500 reveal" data-delay={String(i * 100)}>
            <span class="text-label text-bark-300 group-hover:text-accent transition-colors duration-300">{p.num}</span>
            <h3 class="text-title text-bark-800 mt-3 group-hover:text-bark-900 transition-colors duration-300">
              {t(lang, `paths.${p.key}.title` as any)}
            </h3>
            <p class="text-bark-500 mt-3 leading-relaxed max-w-sm">
              {t(lang, `paths.${p.key}.desc` as any)}
            </p>
            <div class="mt-6 flex items-center gap-2 text-accent opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-[-8px] group-hover:translate-x-0">
              <span class="text-sm font-display font-medium">Explore</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why strip — dark, typographic, dramatic -->
  <section class="bg-bark-900 py-32 px-6 lg:px-10 overflow-hidden">
    <div class="max-w-[1400px] mx-auto">
      <div class="max-w-3xl mx-auto text-center">
        <span class="text-label text-accent reveal">The Thesis</span>
        <h2 class="text-headline text-bark-50 mt-6 text-split">
          Civilization is a supply chain problem.
        </h2>
        <p class="text-body-lg text-bark-400 mt-8 leading-relaxed reveal" data-delay="200">
          Every generation assumes the grid will hold. Ours is the first to watch
          supply chains, institutions, and climate shift simultaneously -- and to
          have the tools to do something about it before the lights flicker. BARK
          is not a bunker. It is an operating system for a community that intends
          to keep living well regardless of what the next decades deliver.
        </p>
        <a href={`/${lang}/why`} class="inline-flex items-center gap-3 mt-10 text-accent hover:text-accent-light font-display text-sm tracking-wide transition-colors duration-300 reveal" data-delay="300">
          The full argument
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Five Components — horizontal scroll on mobile, list on desktop -->
  <section class="py-32 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
        <div>
          <span class="text-label text-accent reveal">Anatomy</span>
          <h2 class="text-headline text-bark-800 mt-4 text-split">Five Components, One System</h2>
        </div>
        <a href={`/${lang}/pillars`} class="text-accent font-display text-sm tracking-wide hover:text-accent-dim transition-colors reveal" data-delay="200">
          Deep dive --
        </a>
      </div>

      <div class="space-y-px">
        {pillars.map((p, i) => (
          <a href={p.link} class="group flex flex-col md:flex-row md:items-center justify-between gap-4 py-8 px-6 bg-bark-50 hover:bg-bark-100 border-b border-bark-200 transition-colors duration-300 reveal" data-delay={String(i * 60)}>
            <div class="flex items-center gap-6">
              <span class="text-label text-bark-300 w-8">0{i + 1}</span>
              <h3 class="text-title text-bark-800 group-hover:text-bark-900 transition-colors">{p.name}</h3>
            </div>
            <div class="flex items-center gap-8">
              <p class="text-bark-500 md:max-w-md md:text-right">{p.desc}</p>
              <svg class="w-5 h-5 text-bark-300 group-hover:text-accent group-hover:translate-x-1 transition-all duration-300 hidden md:block flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Location teaser -->
  <section class="bg-bark-100 py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto flex flex-col md:flex-row md:items-center gap-16">
      <div class="md:w-1/2">
        <span class="text-label text-accent reveal">Location</span>
        <h2 class="text-headline text-bark-800 mt-4 text-split">Coroico, Yungas</h2>
        <p class="text-body-lg text-bark-500 mt-6 leading-relaxed reveal" data-delay="200">
          The road from La Paz drops 3,400 meters in three hours. When the altiplano
          dust gives way to orchids and the air turns wet, you have arrived. The Yungas
          cloud forest sits in a climate band that never freezes, never scorches, and
          grows food twelve months a year. The Inca knew this. We are paying attention.
        </p>
        <a href={`/${lang}/location`} class="inline-flex items-center gap-2 mt-6 text-accent font-display text-sm tracking-wide hover:text-accent-dim transition-colors reveal" data-delay="300">
          The geography in detail --
        </a>
      </div>
      <div class="md:w-1/2 space-y-4">
        <div class="relative rounded-xl overflow-hidden reveal">
          <img src="/images/yungas/valley.jpg" alt="Yungas valley, Bolivia — dramatic green slopes descending into cloud forest" class="w-full h-64 md:h-80 object-cover" loading="lazy" />
          <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-bark-900/80 to-transparent">
            <span class="text-xs text-bark-300">Photo: CC BY-SA 3.0, Jerrye & Roy Klotz MD via Wikimedia Commons</span>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-bark-50 p-6 rounded-xl reveal" data-delay="100">
            <div class="text-title text-bark-800 font-display counter" data-target="1750" data-suffix="m">0</div>
            <span class="text-label text-bark-400 mt-1 block">Cloud Forest Line</span>
          </div>
          <div class="bg-bark-50 p-6 rounded-xl reveal" data-delay="200">
            <div class="text-title text-bark-800 font-display">18-28°C</div>
            <span class="text-label text-bark-400 mt-1 block">Eternal Spring</span>
          </div>
          <div class="bg-bark-50 p-6 rounded-xl reveal" data-delay="300">
            <div class="text-title text-accent font-display">Top 5%</div>
            <span class="text-label text-bark-400 mt-1 block">Global Hotspot</span>
          </div>
          <div class="bg-bark-50 p-6 rounded-xl reveal" data-delay="400">
            <div class="text-title text-bark-800 font-display">3h</div>
            <span class="text-label text-bark-400 mt-1 block">La Paz by Road</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative bg-night py-32 px-6 lg:px-10 overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/20 rounded-full blur-[120px]"></div>
    </div>
    <div class="relative max-w-3xl mx-auto text-center">
      <h2 class="text-headline text-bark-50 text-split">
        This is not a spectator project.
      </h2>
      <p class="text-body-lg text-bark-400 mt-6 reveal" data-delay="200">
        We are assembling the first cohort now. If you have capital, engineering
        skill, or the kind of restlessness that reads a page like this all the
        way to the bottom -- we should talk.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4 reveal" data-delay="300">
        <a href={`/${lang}/participate`} class="group inline-flex items-center gap-3 px-8 py-4 bg-accent text-night font-display font-semibold text-sm tracking-wide rounded hover:bg-accent-light transition-colors duration-300">
          Start a Conversation
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="https://github.com/PT32LAB" class="inline-flex items-center gap-2 px-8 py-4 border border-bark-700 text-bark-300 hover:text-bark-50 hover:border-bark-500 font-display text-sm tracking-wide rounded transition-all duration-300">
          Read the Source Code
        </a>
      </div>
    </div>
  </section>
</Base>
