  { label: 'Build', pages: buildPages },
  { label: 'Place & Join', pages: placeJoinPages },
  { label: 'Reference', pages: referencePages },
];

function statusColor(status: string) {
  switch (status) {
    case 'VERIFIED': return 'bg-emerald-100 text-emerald-800 border-emerald-200';
    case 'SUPPORTED': return 'bg-cyan-100 text-cyan-800 border-cyan-200';
    case 'QUALIFIED': return 'bg-amber-100 text-amber-800 border-amber-200';
    case 'STALE': return 'bg-amber-100 text-amber-800 border-amber-200';
    case 'UNVERIFIED': return 'bg-bark-100 text-bark-600 border-bark-200';
    case 'SOUND': return 'bg-emerald-100 text-emerald-800 border-emerald-200';
    case 'PLAUSIBLE': return 'bg-cyan-100 text-cyan-800 border-cyan-200';
    case 'WEAK': return 'bg-amber-100 text-amber-800 border-amber-200';
    case 'SPECULATIVE': return 'bg-bark-100 text-bark-600 border-bark-200';
    default: return 'bg-bark-100 text-bark-600 border-bark-200';
  }
}
