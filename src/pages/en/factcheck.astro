  {
    name: 'Retreat Center',
    slug: 'pillars/retreat',
    factCount: 11,
    argCount: 8,
    file: 'factcheck-components.md',
    claims: [
      { claim: 'HRV correlates with stress resilience', status: 'VERIFIED' },
