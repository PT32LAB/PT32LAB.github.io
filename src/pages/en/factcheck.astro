      { claim: 'Toyota cut production 40% in Sept 2021 due to chip shortage', status: 'VERIFIED' },
      { claim: 'Ukrainian grain disruption triggered currency wobble in Egypt', status: 'VERIFIED' },
      { claim: 'South America interstate-war-free since Cenepa War (1995)', status: 'VERIFIED' },
      { claim: 'Ley 356 and 12 constitutional articles recognize cooperatives', status: 'QUALIFIED', note: '"12 articles" count not confirmed against constitution text' },
      { claim: 'Food forest takes 3-5 years to produce reliably', status: 'VERIFIED' },
      { claim: 'Bolivian cooperative law is adequate protection for foreign investors', status: 'QUALIFIED', note: 'Implicit: legal framework and enforcement differ in Bolivia' },
    ],
  },
  {
    name: 'Resilience',
    slug: 'resilience',
    factCount: 41,
    argCount: 8,
    file: 'factcheck-core.md',
    claims: [
      { claim: 'Bolivia has zero nuclear weapons, zero foreign military bases', status: 'VERIFIED' },
      { claim: 'Bolivia homicide rate 4.3/100K (2023)', status: 'SUPPORTED', note: 'Estimates range 4.1-4.7 depending on source' },
      { claim: 'Foreign reserves near $100M, down from $14B', status: 'STALE', note: '$14B peak (2014) verified; ~$100M is 2025 figure, not confirmed at current date' },
      { claim: '20%+ inflation (2025)', status: 'UNVERIFIED', note: 'Post-training-cutoff figure' },
      { claim: 'WHO healthcare ranking 126th of 190', status: 'QUALIFIED', note: 'This ranking is from the year 2000 and has not been updated' },
      { claim: '~98% of fresh food from small-scale family farms', status: 'QUALIFIED', note: 'Likely 80-90%; contradicts scenarios page "88%" figure' },
      { claim: 'Under compound scenario, safe-haven hierarchy inverts', status: 'SPECULATIVE', note: 'Argument: interesting thesis but untested and highly scenario-dependent' },
    ],
  },
  {
    name: 'Scenarios',
    slug: 'scenarios',
    factCount: 17,
    argCount: 9,
    file: 'factcheck-core.md',
    claims: [
      { claim: 'Over 5 billion famine deaths modeled in nuclear winter (Xia et al., Nature Food)', status: 'VERIFIED' },
      { claim: '90% of global trade moves by sea', status: 'VERIFIED' },
      { claim: 'Bolivia holds world\'s largest lithium reserves', status: 'VERIFIED' },
      { claim: '$9 trillion daily trade at risk from digital infrastructure attack', status: 'QUALIFIED', note: 'Global FX turnover is ~$7.5T (BIS 2022); $9T not precisely sourced' },
