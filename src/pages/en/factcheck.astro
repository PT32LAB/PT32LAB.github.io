---
import Base from '../../layouts/Base.astro';

/* ── Per-page data: top claims selected from 4 research files ── */

const githubResearch = 'https://github.com/PT32LAB/PT32LAB.github.io/tree/main/research';

type ClaimRow = { claim: string; status: string; note?: string };

type PageData = {
  name: string;
  slug: string;
  factCount: number;
  argCount: number;
  file: string;
  claims: ClaimRow[];
};

/* ── PROJECT ── */

