---
import Base from '../../layouts/Base.astro';
---

<Base title="Participate">
  <section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-bark-earth-dark mb-4">Get Involved</h1>
      <p class="text-xl text-bark-earth mb-8">BARK is a project for co-creators, not spectators. Here's how you can contribute.</p>
      <div class="circuit-vine mb-12"></div>

      <div class="grid md:grid-cols-2 gap-8 mb-16">
        <div class="p-8 bg-white rounded-xl border border-bark-green/10">
          <div class="text-3xl mb-4">💰</div>
          <h2 class="text-xl font-bold text-bark-earth-dark mb-3">Invest</h2>
          <p class="text-bark-earth leading-relaxed mb-4">
            Fund infrastructure, land acquisition, or specific pillars. We're structuring investment
            pathways that align financial return with community benefit. Early supporters shape the foundation.
          </p>
          <ul class="text-sm text-bark-earth space-y-1">
            <li>• Direct project funding</li>
            <li>• Cooperative membership shares</li>
            <li>• Pillar-specific sponsorship</li>
          </ul>
        </div>

        <div class="p-8 bg-white rounded-xl border border-bark-green/10">
          <div class="text-3xl mb-4">🔧</div>
          <h2 class="text-xl font-bold text-bark-earth-dark mb-3">Build</h2>
          <p class="text-bark-earth leading-relaxed mb-4">
            Contribute skills — engineering, agriculture, construction, software, design, medicine,
            education. On-site or remote. Full-time resident or periodic contributor.
          </p>
          <ul class="text-sm text-bark-earth space-y-1">
            <li>• Resident builder (relocate to Coroico)</li>
            <li>• Remote contributor (code, design, research)</li>
            <li>• Visiting expert (periodic on-site work)</li>
          </ul>
        </div>

        <div class="p-8 bg-white rounded-xl border border-bark-green/10">
          <div class="text-3xl mb-4">🧠</div>
          <h2 class="text-xl font-bold text-bark-earth-dark mb-3">Think</h2>
          <p class="text-bark-earth leading-relaxed mb-4">
            Contribute intellectual property — designs, research, methodologies, governance models.
            Open-source contributions to the project's knowledge base.
          </p>
          <ul class="text-sm text-bark-earth space-y-1">
            <li>• Governance model design</li>
            <li>• Technical architecture proposals</li>
            <li>• Research and analysis</li>
          </ul>
        </div>

        <div class="p-8 bg-white rounded-xl border border-bark-green/10">
          <div class="text-3xl mb-4">📢</div>
          <h2 class="text-xl font-bold text-bark-earth-dark mb-3">Spread</h2>
          <p class="text-bark-earth leading-relaxed mb-4">
            Share the vision. Connect us with people, organizations, and resources.
            Write about the project. Translate content. Build community.
          </p>
          <ul class="text-sm text-bark-earth space-y-1">
            <li>• Social media and content</li>
            <li>• Translation (EN/ES and beyond)</li>
            <li>• Network connections</li>
          </ul>
        </div>
      </div>

      <div class="bg-bark-night text-white rounded-xl p-8 mb-12">
        <h2 class="text-2xl font-bold mb-4">Open Source First</h2>
        <p class="text-bark-sand/80 leading-relaxed mb-6">
          Everything we produce — plans, code, research, governance frameworks — lives in public GitHub repositories.
          Fork it, improve it, replicate it. This project belongs to everyone who contributes.
        </p>
        <a
          href="https://github.com/PT32LAB"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-bark-emerald text-white font-semibold rounded-lg hover:bg-bark-green-light transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          View on GitHub
        </a>
      </div>

      <div class="text-center">
        <h2 class="text-2xl font-bold text-bark-earth-dark mb-4">Ready to talk?</h2>
        <p class="text-bark-earth mb-6">
          Reach out directly. We respond to everyone.
        </p>
        <a
          href="mailto:contact@pt32lab.org"
          class="inline-flex items-center gap-2 px-6 py-3 bg-bark-green text-white font-semibold rounded-lg hover:bg-bark-green-light transition-colors"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Base>
