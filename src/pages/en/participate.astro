---
import Base from '../../layouts/Base.astro';

const pathways = [
  {
    num: '01',
    title: 'Experience',
    desc: 'Come for a retreat -- one week minimum. Live on-site, eat from the gardens, meet the builders, understand the systems. This is not tourism. You will work. You will be uncomfortable at least once. Some guests return. Some invest. Some relocate. Most do not. The retreat exists to find the ones who do.',
    items: ['Structured retreat program (minimum 7 days)', 'Work alongside residents -- not observe from a distance', 'Honest assessment at the end: mutual fit or mutual goodbye'],
  },
  {
    num: '02',
    title: 'Invest',
    desc: 'Put capital into land, solar arrays, processing equipment, or the cooperative structure itself. Every dollar becomes a physical thing in a specific place -- a cistern, a roasting drum, a panel on a roof. You will receive quarterly reporting on what your capital became. Not a pitch deck. Photographs and spreadsheets.',
    items: ['Direct project funding with named asset allocation', 'Cooperative membership shares (one member, one vote)', 'Component-specific sponsorship with impact reporting'],
  },
  {
    num: '03',
    title: 'Build',
    desc: 'Bring a skill that has weight. Weld a frame, design a greywater system, write firmware for a mesh radio node, plant a food forest on a 30-degree slope. We need people who have built things before -- not people who want to learn by experimenting on critical infrastructure. On-site in Coroico or remote.',
    items: ['Resident builder -- relocate to Coroico, minimum 6-month commitment', 'Remote contributor -- code, design, research with defined deliverables', 'Visiting expert -- periodic on-site work on specific problems'],
  },
  {
    num: '04',
    title: 'Think',
    desc: 'Contribute governance models, legal architecture, engineering designs, research. The knowledge base is open-source -- your work propagates to every community that forks the model. We need people who can write a document that survives contact with Bolivian administrative reality, not just theory.',
    items: ['Governance model design grounded in Ley 356', 'Technical architecture with material and cost specificity', 'Research that cites sources and checks assumptions'],
  },
  {
    num: '05',
    title: 'Spread',
    desc: 'Translate content into Spanish, Aymara, Portuguese. Connect us with cooperatives, agronomists, engineers, lawyers who know Bolivian land title law. Write honestly about the project -- including what does not work. Propaganda does not help us. Honest signal does.',
    items: ['Translation with cultural adaptation, not word-for-word conversion', 'Introductions to specific people who solve specific problems', 'Honest public writing -- criticism included'],
  },
];
---

<Base title="Participate" description="Participation means real involvement. Five pathways for people who want to test whether they can build, contribute, and live inside a serious long-term project." heroImage="/images/yungas/valley.jpg">
  <!-- Photo Hero -->
  <section class="relative min-h-[50vh] flex items-end pb-16 overflow-hidden">
    <img src="/images/yungas/valley.jpg" alt="The green valley of the Yungas, Coroico" width="1920" height="1282" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/20"></div>
    <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-10 w-full">
      <span class="text-label text-accent tracking-widest reveal">Participate</span>
      <h1 class="text-headline text-white mt-4 reveal" data-delay="100">Participation Means Real Involvement</h1>
      <p class="text-body-lg text-white/70 mt-4 max-w-2xl reveal" data-delay="200">BARK is not asking for passive belief. It is asking for people who want to test whether they can build, contribute, live, and learn inside a serious long-term project.</p>
    </div>
  </section>

  <!-- Intro -->
  <section class="pt-16 pb-16 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <p class="text-body-lg text-bark-500 max-w-2xl reveal">
        Participation here can begin lightly, but it should never remain vague. The project needs
        presence, skill, commitment, and honesty about fit. Not everyone belongs here -- and that
        is not a failure. It is a filter that protects both the project and the person.
      </p>
      <div class="accent-line mt-10 max-w-xl reveal" data-delay="100"></div>
    </div>
  </section>

  <!-- Five Pathways -->
  <section class="pb-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <span class="text-label text-bark-400 reveal">Pathways</span>
      <h2 class="text-title text-bark-800 mt-4 mb-10 reveal" data-delay="100">Five ways in -- each with real expectations.</h2>

      <div class="grid md:grid-cols-2 gap-px bg-bark-200 rounded-xl overflow-hidden">
        {pathways.map((w, i) => (
          <div class="bg-bark-50 p-10 reveal" data-delay={String(i * 100)}>
            <span class="text-label text-bark-300">{w.num}</span>
            <h3 class="text-title text-bark-800 mt-3">{w.title}</h3>
            <p class="text-bark-500 mt-4 leading-relaxed">{w.desc}</p>
            <ul class="mt-6 space-y-2">
              {w.items.map(item => (
                <li class="text-bark-600 text-sm pl-5 relative before:content-[''] before:absolute before:left-0 before:top-[0.6em] before:w-2 before:h-px before:bg-accent">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What a Good Fit Looks Like -->
  <section class="py-24 px-6 lg:px-10 bg-warm-gradient">
    <div class="max-w-[1400px] mx-auto">
      <span class="text-label text-accent reveal">Good Fit</span>
      <h2 class="text-title text-bark-800 mt-4 mb-4 reveal" data-delay="100">What a Good Fit Looks Like</h2>
      <p class="text-body-lg text-bark-500 mb-10 max-w-2xl reveal" data-delay="200">
        The people who do well here share a few traits. Not credentials -- dispositions.
      </p>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="card hover-lift reveal" data-delay="100">
          <h3 class="font-display font-semibold text-bark-800 text-lg mb-3">You want real work</h3>
          <p class="text-bark-500 text-sm leading-relaxed">
            You have built things before and you want to build again. You are not looking for a
            community that validates your presence -- you are looking for one that needs your output.
          </p>
        </div>
        <div class="card hover-lift reveal" data-delay="200">
          <h3 class="font-display font-semibold text-bark-800 text-lg mb-3">You tolerate friction</h3>
          <p class="text-bark-500 text-sm leading-relaxed">
            Uncertainty, unfinished systems, changing plans, and the gap between intention and
            reality do not paralyze you. You adapt. You communicate when something is not working
            instead of withdrawing.
          </p>
        </div>
        <div class="card hover-lift reveal" data-delay="300">
          <h3 class="font-display font-semibold text-bark-800 text-lg mb-3">You contribute, not consume</h3>
          <p class="text-bark-500 text-sm leading-relaxed">
            You are drawn to the project because of what you can put into it, not because of the
            atmosphere it might provide. Community is a byproduct of shared labor -- not a service.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What This Is Not -->
  <section class="bg-bark-900 py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <span class="text-label text-accent reveal">Honest Filter</span>
      <h2 class="text-title text-bark-100 mt-4 mb-4 reveal" data-delay="100">What This Is Not</h2>
      <p class="text-bark-400 mb-10 max-w-2xl reveal" data-delay="200">
        Saying no early saves everyone time. If any of the following apply, this project is
        probably not a good fit -- and that is fine. There are many good projects in the world.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-bark-800/60 rounded-xl p-8 reveal" data-delay="100">
          <h3 class="font-display font-semibold text-bark-100 text-lg mb-3">Passive Retreat Tourism</h3>
          <p class="text-bark-400 text-sm leading-relaxed">
            This is not an eco-resort with a membership fee. Living here means participating in
            governance, contributing labor, eating what the garden produces in season, and accepting
            that the road washes out in February.
          </p>
        </div>
        <div class="bg-bark-800/60 rounded-xl p-8 reveal" data-delay="200">
          <h3 class="font-display font-semibold text-bark-100 text-lg mb-3">Instant Belonging</h3>
          <p class="text-bark-400 text-sm leading-relaxed">
            Community forms through shared work over time. There is no initiation ceremony that
            makes you part of this. There is only sustained contribution and mutual trust built
            slowly.
          </p>
        </div>
        <div class="bg-bark-800/60 rounded-xl p-8 reveal" data-delay="300">
          <h3 class="font-display font-semibold text-bark-100 text-lg mb-3">Polished Service</h3>
          <p class="text-bark-400 text-sm leading-relaxed">
            Bolivia has fuel shortages, dollar scarcity, road blockades, and a political landscape
            that does not conform to North American or European expectations. Infrastructure here
            is functional, not luxurious.
          </p>
        </div>
        <div class="bg-bark-800/60 rounded-xl p-8 reveal" data-delay="400">
          <h3 class="font-display font-semibold text-bark-100 text-lg mb-3">Low-Friction Living</h3>
          <p class="text-bark-400 text-sm leading-relaxed">
            If you cannot work within Bolivian reality -- respectfully, patiently, without trying
            to import your own governance assumptions -- you will be unhappy here, and you will
            make others unhappy.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What Happens After Contact -->
  <section class="py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <span class="text-label text-accent reveal">Process</span>
      <h2 class="text-title text-bark-800 mt-4 mb-10 reveal" data-delay="100">What Happens After Contact</h2>

      <div class="grid md:grid-cols-4 gap-8">
        <div class="relative reveal" data-delay="100">
          <span class="text-label text-bark-300 mb-3 block">01</span>
          <h3 class="font-display font-semibold text-bark-800 text-lg mb-2">You Write</h3>
          <p class="text-bark-500 text-sm leading-relaxed">
            Send an email. Tell us what you do, what you have built, and what draws you here.
            No form. No application portal. Just a real message.
          </p>
        </div>
        <div class="relative reveal" data-delay="200">
          <span class="text-label text-bark-300 mb-3 block">02</span>
          <h3 class="font-display font-semibold text-bark-800 text-lg mb-2">We Respond</h3>
          <p class="text-bark-500 text-sm leading-relaxed">
            Within one week. If we do not reply, follow up -- small teams lose emails sometimes.
            Silence is not rejection.
          </p>
        </div>
        <div class="relative reveal" data-delay="300">
          <span class="text-label text-bark-300 mb-3 block">03</span>
          <h3 class="font-display font-semibold text-bark-800 text-lg mb-2">First Conversation</h3>
          <p class="text-bark-500 text-sm leading-relaxed">
            A video call. We talk about your background, your interests, and whether the project
            matches what you are looking for. Honest in both directions.
          </p>
        </div>
        <div class="relative reveal" data-delay="400">
          <span class="text-label text-bark-300 mb-3 block">04</span>
          <h3 class="font-display font-semibold text-bark-800 text-lg mb-2">Mutual Evaluation</h3>
          <p class="text-bark-500 text-sm leading-relaxed">
            We decide together whether to proceed -- a visit, a remote contribution, an investment
            conversation. Fit is evaluated by both sides, not assigned.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Open Source -->
  <section class="py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-10">
      <div class="max-w-xl">
        <span class="text-label text-accent reveal">Open Source as Reproduction</span>
        <p class="text-body-lg text-bark-500 mt-4 leading-relaxed reveal" data-delay="100">
          Every schematic, every governance document, every soil test result lives in public
          repositories. Fork the entire project. Adapt it for a valley in Guatemala or a
          hillside in Nepal. The design improves every time it propagates.
        </p>
      </div>
      <a
        href="https://github.com/PT32LAB"
        class="group inline-flex items-center gap-3 px-7 py-4 bg-accent text-night font-display font-semibold text-sm tracking-wide rounded hover:bg-accent-light transition-colors duration-300 reveal" data-delay="200"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        View on GitHub
      </a>
    </div>
  </section>

  <!-- Key Proof Pages -->
  <section class="bg-bark-100 py-24 px-6 lg:px-10">
    <div class="max-w-[1400px] mx-auto">
      <span class="text-label text-bark-400 reveal">Go Deeper</span>
      <h2 class="text-title text-bark-800 mt-4 mb-10 reveal" data-delay="100">Before you write, read what matters.</h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <a href="/en/risks" class="card hover-lift group reveal" data-delay="100">
          <h3 class="font-display font-semibold text-bark-800 text-base group-hover:text-accent transition-colors">Risk</h3>
          <p class="text-bark-500 text-sm mt-2 leading-relaxed">What can go wrong and what we are doing about it.</p>
        </a>
        <a href="/en/team" class="card hover-lift group reveal" data-delay="150">
          <h3 class="font-display font-semibold text-bark-800 text-base group-hover:text-accent transition-colors">Team</h3>
          <p class="text-bark-500 text-sm mt-2 leading-relaxed">Who is behind the project and what they bring.</p>
        </a>
        <a href="/en/governance" class="card hover-lift group reveal" data-delay="200">
          <h3 class="font-display font-semibold text-bark-800 text-base group-hover:text-accent transition-colors">Governance</h3>
          <p class="text-bark-500 text-sm mt-2 leading-relaxed">How decisions are made under Bolivian cooperative law.</p>
        </a>
        <a href="/en/builders" class="card hover-lift group reveal" data-delay="250">
          <h3 class="font-display font-semibold text-bark-800 text-base group-hover:text-accent transition-colors">Builders</h3>
          <p class="text-bark-500 text-sm mt-2 leading-relaxed">The technical systems and what needs building next.</p>
        </a>
        <a href="/en/investors" class="card hover-lift group reveal" data-delay="300">
          <h3 class="font-display font-semibold text-bark-800 text-base group-hover:text-accent transition-colors">Investors</h3>
          <p class="text-bark-500 text-sm mt-2 leading-relaxed">Capital structure, cooperative shares, and asset allocation.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="bg-bark-900 py-32 px-6 lg:px-10">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="text-headline text-bark-100 reveal">Start a Conversation</h2>
      <p class="text-body-lg text-bark-400 mt-4 reveal" data-delay="100">
        Tell us what you do, what you have built, and what draws you to a cloud forest
        cooperative in Bolivia.
      </p>
      <a
        href="mailto:contact@pt32lab.org"
        class="group inline-flex items-center gap-3 mt-8 px-7 py-4 bg-accent text-night font-display font-semibold text-sm tracking-wide rounded hover:bg-accent-light transition-colors duration-300 reveal" data-delay="200"
      >
        Send an Email
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>
</Base>
