---
import { getLangFromUrl, t, getLocalePath, languages, type Lang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';

const navGroups = [
  {
    label: 'nav.group.project' as const,
    links: [
      { key: 'nav.vision' as const, desc: 'nav.desc.vision' as const, path: '/vision' },
      { key: 'nav.why' as const, desc: 'nav.desc.why' as const, path: '/why' },
      { key: 'nav.resilience' as const, desc: 'nav.desc.resilience' as const, path: '/resilience' },
      { key: 'nav.scenarios' as const, desc: 'nav.desc.scenarios' as const, path: '/scenarios' },
      { key: 'nav.roadmap' as const, desc: 'nav.desc.roadmap' as const, path: '/roadmap' },
    ],
  },
  {
    label: 'nav.group.build' as const,
    links: [
      { key: 'nav.pillars' as const, desc: 'nav.desc.pillars' as const, path: '/pillars' },
      { key: 'nav.pillars' as const, desc: 'nav.desc.technopark' as const, path: '/pillars/technopark', sublabel: 'Techno Park' },
      { key: 'nav.pillars' as const, desc: 'nav.desc.incubator' as const, path: '/pillars/incubator', sublabel: 'Incubator' },
      { key: 'nav.pillars' as const, desc: 'nav.desc.trading' as const, path: '/pillars/trading', sublabel: 'Trading House' },
      { key: 'nav.pillars' as const, desc: 'nav.desc.infrastructure' as const, path: '/pillars/infrastructure', sublabel: 'Infrastructure' },
    ],
  },
  {
    label: 'nav.group.life' as const,
    links: [
      { key: 'nav.pillars' as const, desc: 'nav.desc.retreat' as const, path: '/pillars/retreat', sublabel: 'Retreat & Longevity' },
      { key: 'nav.health' as const, desc: 'nav.desc.health' as const, path: '/health' },
      { key: 'nav.traditions' as const, desc: 'nav.desc.traditions' as const, path: '/traditions' },
      { key: 'nav.gallery' as const, desc: 'nav.desc.gallery' as const, path: '/gallery' },
    ],
  },
  {
    label: 'nav.group.join' as const,
    links: [
      { key: 'nav.investors' as const, desc: 'nav.desc.investors' as const, path: '/investors' },
      { key: 'nav.participate' as const, desc: 'nav.desc.participate' as const, path: '/participate' },
      { key: 'nav.team' as const, desc: 'nav.desc.team' as const, path: '/team' },
      { key: 'nav.landing-about' as const, desc: 'nav.desc.landing-about' as const, path: '/landing/about', sublabel: 'Quick Overview' },
      { key: 'nav.landing-invest' as const, desc: 'nav.desc.landing-invest' as const, path: '/landing/invest', sublabel: 'Investor Brief' },
      { key: 'nav.landing-builders' as const, desc: 'nav.desc.landing-builders' as const, path: '/landing/builders', sublabel: 'Builder Brief' },
      { key: 'nav.landing-resilience' as const, desc: 'nav.desc.landing-resilience' as const, path: '/landing/resilience', sublabel: 'Crisis Brief' },
    ],
  },
  {
    label: 'nav.group.reference' as const,
    links: [
      { key: 'nav.location' as const, desc: 'nav.desc.location' as const, path: '/location' },
      { key: 'nav.economy' as const, desc: 'nav.desc.economy' as const, path: '/economy' },
      { key: 'nav.governance' as const, desc: 'nav.desc.governance' as const, path: '/governance' },
      { key: 'nav.network' as const, desc: 'nav.desc.network' as const, path: '/network' },
      { key: 'nav.risks' as const, desc: 'nav.desc.risks' as const, path: '/risks' },
      { key: 'nav.glossary' as const, desc: 'nav.desc.glossary' as const, path: '/glossary' },
      { key: 'nav.factcheck' as const, desc: 'nav.desc.factcheck' as const, path: '/factcheck' },
    ],
  },
];
---

<nav id="main-nav" class="fixed top-0 w-full z-50 transition-all duration-500 bg-bark-50/80 backdrop-blur-sm">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={getLocalePath(lang, '/')} class="font-display font-bold text-bark-800 text-lg tracking-tight hover:text-accent transition-colors" transition:name="logo">
        BARK
      </a>

      <!-- Desktop nav -->
      <div class="hidden lg:flex items-center gap-1">
        {navGroups.map((group, gi) => (
          <div class="relative" data-nav-group={gi}>
            <button
              class="nav-group-btn text-[0.7rem] font-display font-medium tracking-[0.12em] uppercase text-bark-500 hover:text-bark-800 transition-colors duration-200 px-3 py-5 flex items-center gap-1"
              data-group-trigger={gi}
            >
              {t(lang, group.label)}
              <svg class="w-3 h-3 transition-transform duration-200 nav-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div
              class="nav-dropdown absolute left-1/2 -translate-x-1/2 top-full pt-1 opacity-0 pointer-events-none translate-y-1 transition-all duration-200 z-50"
              data-group-panel={gi}
            >
              <div class="bg-bark-50 border border-bark-200 rounded-lg shadow-lg py-3 px-2 min-w-[260px]" style={`box-shadow: var(--shadow-lg);`}>
                {group.links.map(link => (
                  <a
                    href={link.path.startsWith('/landing/') ? link.path : getLocalePath(lang, link.path)}
                    class="group flex flex-col px-3 py-2 rounded-md hover:bg-bark-100 transition-colors duration-150"
                  >
                    <span class="text-[0.75rem] font-display font-medium text-bark-700 group-hover:text-bark-900 transition-colors">
                      {link.sublabel || t(lang, link.key)}
                    </span>
                    <span class="text-[0.65rem] text-bark-400 leading-snug mt-0.5">
                      {t(lang, link.desc)}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}

        <span class="w-px h-4 bg-bark-200 mx-2"></span>

        <a
          href={getLocalePath(otherLang, Astro.url.pathname.replace(new RegExp('^/' + lang + '(/|$)'), '$1') || '/')}
          class="text-[0.7rem] font-display font-medium tracking-[0.12em] uppercase text-bark-400 hover:text-accent transition-colors duration-300 px-2"
        >
          {languages[otherLang]}
        </a>

        <button id="theme-toggle" class="p-2 text-bark-500 hover:text-bark-800 transition-colors" aria-label="Toggle dark mode">
          <svg class="w-4 h-4 dark-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg class="w-4 h-4 light-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-bark-600" aria-label="Menu">
        <svg class="w-5 h-5 mobile-icon-open" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
        <svg class="w-5 h-5 mobile-icon-close hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M6 6l12 12M6 18L18 6"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-bark-50/98 backdrop-blur-md border-t border-bark-200/50 max-h-[calc(100dvh-4rem)] overflow-y-auto">
    <div class="px-6 py-4">
      {navGroups.map((group, gi) => (
        <div class="mobile-accordion border-b border-bark-100 last:border-b-0" data-mobile-group={gi}>
          <button
            class="mobile-accordion-btn w-full flex items-center justify-between py-3 text-left"
            data-mobile-trigger={gi}
          >
            <span class="text-[0.7rem] font-display font-semibold tracking-[0.12em] uppercase text-bark-700">
              {t(lang, group.label)}
            </span>
            <svg class="w-4 h-4 text-bark-400 transition-transform duration-200 mobile-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="mobile-accordion-panel hidden pb-3 pl-2">
            {group.links.map(link => (
              <a
                href={getLocalePath(lang, link.path)}
                class="flex flex-col py-2 px-2 rounded-md hover:bg-bark-100 transition-colors"
              >
                <span class="text-[0.75rem] font-display font-medium text-bark-600">
                  {link.sublabel || t(lang, link.key)}
                </span>
                <span class="text-[0.6rem] text-bark-400 leading-snug mt-0.5">
                  {t(lang, link.desc)}
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
      <div class="pt-3 mt-1 flex items-center gap-3">
        <a
          href={getLocalePath(otherLang, Astro.url.pathname.replace(new RegExp('^/' + lang + '(/|$)'), '$1') || '/')}
          class="text-[0.7rem] font-display font-medium tracking-[0.1em] uppercase text-bark-400"
        >
          {languages[otherLang]}
        </a>
        <button class="theme-toggle-mobile p-2 text-bark-500 hover:text-bark-800 transition-colors" aria-label="Toggle dark mode">
          <svg class="w-4 h-4 dark-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg class="w-4 h-4 light-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<script>
  import { initNav } from '../scripts/nav';
  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
