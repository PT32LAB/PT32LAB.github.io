---
import { getLangFromUrl, t, getLocalePath, languages, type Lang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';

const links = [
  { key: 'nav.vision' as const, path: '/vision' },
  { key: 'nav.why' as const, path: '/why' },
  { key: 'nav.pillars' as const, path: '/pillars' },
  { key: 'nav.location' as const, path: '/location' },
  { key: 'nav.governance' as const, path: '/governance' },
  { key: 'nav.participate' as const, path: '/participate' },
];
---

<nav id="main-nav" class="fixed top-0 w-full z-50 transition-all duration-500">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <div class="flex items-center justify-between h-20">
      <a href={getLocalePath(lang, '/')} class="font-display font-bold text-bark-800 text-lg tracking-tight hover:text-accent transition-colors" transition:name="logo">
        BARK
      </a>

      <div class="hidden md:flex items-center gap-8">
        {links.map(link => (
          <a
            href={getLocalePath(lang, link.path)}
            class="text-label text-bark-500 hover:text-bark-800 transition-colors duration-300"
          >
            {t(lang, link.key)}
          </a>
        ))}
        <a
          href={getLocalePath(otherLang, Astro.url.pathname.replace(`/${lang}`, '') || '/')}
          class="text-label text-bark-400 hover:text-accent transition-colors duration-300"
        >
          {languages[otherLang]}
        </a>
      </div>

      <button id="mobile-menu-btn" class="md:hidden p-2 text-bark-600" aria-label="Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-bark-50/95 backdrop-blur-md border-t border-bark-200/50">
    <div class="px-6 py-6 space-y-4">
      {links.map(link => (
        <a
          href={getLocalePath(lang, link.path)}
          class="block text-label text-bark-500 hover:text-bark-800 transition-colors"
        >
          {t(lang, link.key)}
        </a>
      ))}
      <div class="pt-2 border-t border-bark-200/50">
        <a
          href={getLocalePath(otherLang, Astro.url.pathname.replace(`/${lang}`, '') || '/')}
          class="text-label text-bark-400"
        >
          {languages[otherLang]}
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  function initNav() {
    const nav = document.getElementById('main-nav');
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!nav) return;

    let lastY = 0;
    let ticking = false;

    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        if (y > 100) {
          nav.classList.add('bg-bark-50/90', 'backdrop-blur-md', 'shadow-sm');
        } else {
          nav.classList.remove('bg-bark-50/90', 'backdrop-blur-md', 'shadow-sm');
        }
        if (y > lastY && y > 400) {
          nav.style.transform = 'translateY(-100%)';
        } else {
          nav.style.transform = 'translateY(0)';
        }
        lastY = y;
        ticking = false;
      });
    });

    btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
