---
import { getLangFromUrl, t } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
---

<footer class="bg-bark-night text-bark-sand/80">
  <div class="circuit-vine"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid md:grid-cols-3 gap-8">
      <div>
        <div class="flex items-center gap-2 text-white font-bold text-lg mb-3">
          <span class="text-xl">🌿</span>
          <span>BARK — Bolivian Ark</span>
        </div>
        <p class="text-sm leading-relaxed">{t(lang, 'footer.tagline')}</p>
      </div>
      <div>
        <h4 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">Links</h4>
        <div class="space-y-2 text-sm">
          <a href={`/${lang}/vision`} class="block hover:text-bark-emerald transition-colors">{t(lang, 'nav.vision')}</a>
          <a href={`/${lang}/why`} class="block hover:text-bark-emerald transition-colors">{t(lang, 'nav.why')}</a>
          <a href={`/${lang}/participate`} class="block hover:text-bark-emerald transition-colors">{t(lang, 'nav.participate')}</a>
          <a href={`/${lang}/governance`} class="block hover:text-bark-emerald transition-colors">{t(lang, 'nav.governance')}</a>
        </div>
      </div>
      <div>
        <h4 class="text-white font-semibold mb-3 text-sm uppercase tracking-wider">Open Source</h4>
        <p class="text-sm mb-3">{t(lang, 'footer.license')}</p>
        <a
          href="https://github.com/PT32LAB/PT32LAB.github.io"
          class="inline-flex items-center gap-2 text-sm text-bark-emerald hover:text-bark-lime transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
    </div>
    <div class="mt-8 pt-6 border-t border-bark-sand/10 text-xs text-bark-sand/50 text-center">
      BARK Project &copy; {new Date().getFullYear()} — Built with care for the future.
    </div>
  </div>
</footer>
