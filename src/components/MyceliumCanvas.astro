<!-- Generative mycelium/root network background — deferred, lightweight -->
<canvas id="mycelium-canvas" class="absolute inset-0 w-full h-full" style="z-index:0;opacity:0;transition:opacity 2s ease;"></canvas>

<script>
function initMycelium() {
  const canvas = document.getElementById('mycelium-canvas') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let w = 0, h = 0;
  let branches: { x:number;y:number;a:number;s:number;l:number;ml:number;w:number;al:number;c:string }[] = [];
  let animId = 0;
  const colors = ['rgba(16,185,129,','rgba(34,211,153,','rgba(5,150,105,','rgba(34,211,238,'];

  function resize() {
    const r = canvas.parentElement?.getBoundingClientRect();
    w = canvas.width = r?.width || window.innerWidth;
    h = canvas.height = r?.height || window.innerHeight;
    ctx!.fillStyle = 'rgba(10,10,15,1)';
    ctx!.fillRect(0,0,w,h);
  }

  function spawn(x?:number, y?:number) {
    if (branches.length > 150) return;
    branches.push({
      x: x ?? Math.random()*w, y: y ?? Math.random()*h,
      a: Math.random()*Math.PI*2, s: 0.3+Math.random()*0.6,
      l: 0, ml: 60+Math.random()*150, w: 0.3+Math.random()*1.2,
      al: 0.06+Math.random()*0.1,
      c: colors[Math.floor(Math.random()*colors.length)],
    });
  }

  function draw() {
    ctx!.fillStyle = 'rgba(10,10,15,0.015)';
    ctx!.fillRect(0,0,w,h);

    for (let i = branches.length-1; i >= 0; i--) {
      const b = branches[i];
      b.l++;
      b.a += (Math.random()-0.5)*0.3;
      const dx = Math.cos(b.a)*b.s, dy = Math.sin(b.a)*b.s;
      const f = 1 - b.l/b.ml;

      ctx!.strokeStyle = b.c + (b.al*f) + ')';
      ctx!.lineWidth = b.w*f;
      ctx!.beginPath();
      ctx!.moveTo(b.x, b.y);
      b.x += dx; b.y += dy;
      ctx!.lineTo(b.x, b.y);
      ctx!.stroke();

      if (Math.random() < 0.006) spawn(b.x, b.y);

      if (Math.random() < 0.004) {
        ctx!.beginPath();
        ctx!.arc(b.x, b.y, 1+Math.random()*1.5, 0, Math.PI*2);
        ctx!.fillStyle = b.c + (b.al*f*1.5) + ')';
        ctx!.fill();
      }

      if (b.l >= b.ml || b.x < -10 || b.x > w+10 || b.y < -10 || b.y > h+10) {
        branches.splice(i, 1);
      }
    }

    if (branches.length < 30 && Math.random() < 0.1) spawn();
    animId = requestAnimationFrame(draw);
  }

  // Defer start until after page is interactive
  requestIdleCallback(() => {
    resize();
    for (let i = 0; i < 15; i++) spawn();
    draw();
    canvas.style.opacity = '1';
  }, { timeout: 200 });

  window.addEventListener('resize', resize);
  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(animId);
    window.removeEventListener('resize', resize);
  }, { once: true });
}

// Only start after load
if (document.readyState === 'complete') initMycelium();
else window.addEventListener('load', initMycelium, { once: true });
document.addEventListener('astro:page-load', () => {
  if (document.getElementById('mycelium-canvas')) initMycelium();
});
</script>
