---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
}

const { title, subtitle, description } = Astro.props;
---

<Base title={title} description={description}>
  <section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-bark-earth-dark mb-4">{title}</h1>
      {subtitle && <p class="text-xl text-bark-earth mb-8">{subtitle}</p>}
      <div class="circuit-vine mb-10"></div>
      <div class="prose prose-lg max-w-none
        prose-headings:text-bark-earth-dark prose-headings:font-bold
        prose-p:text-bark-earth-dark/80 prose-p:leading-relaxed
        prose-a:text-bark-green prose-a:no-underline hover:prose-a:underline
        prose-li:text-bark-earth-dark/80
        prose-strong:text-bark-earth-dark
        prose-blockquote:border-bark-emerald prose-blockquote:text-bark-earth
      ">
        <slot />
      </div>
    </div>
  </section>
</Base>
